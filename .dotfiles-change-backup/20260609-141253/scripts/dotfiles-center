def shell_quote(value: str) -> str:
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def load_shell_values(path: Path, defaults: dict[str, str]) -> dict[str, str]:
    values = defaults.copy()
    if not path.exists():
        return values
    pattern = re.compile(r"^([A-Za-z_][A-Za-z0-9_]*)=(.*)$")
    for line in path.read_text(encoding="utf-8").splitlines():
        match = pattern.match(line.strip())
        if not match:
            continue
        key, raw = match.groups()
        raw = raw.strip()
        if len(raw) >= 2 and raw[0] == raw[-1] == '"':
            raw = raw[1:-1].replace('\\"', '"').replace("\\\\", "\\")
        values[key] = raw
    return values


def read_local_conf() -> dict[str, str]:
    values = DEFAULTS.copy()
    repo_settings = ROOT / "config" / "dotfiles" / "settings.conf"
    values.update(load_shell_values(repo_settings, values))
    values.update(load_shell_values(LOCAL_CONF, values))
    return values


def write_local_conf(values: dict[str, str]) -> None:
    DOTFILES_DIR.mkdir(parents=True, exist_ok=True)
    lines = [
        "# Machine-local dotfiles settings written by Dotfiles Center.",
        "# It is safe to edit this file manually too.",
    ]
    for key in DEFAULTS:
        lines.append(f"{key}={shell_quote(values.get(key, DEFAULTS[key]))}")
    LOCAL_CONF.write_text("\n".join(lines) + "\n", encoding="utf-8")


def default_shortcuts() -> list[dict]:
    return [shortcut.copy() for shortcut in DEFAULT_SHORTCUTS]


def normalize_shortcut(item: dict) -> dict | None:
    name = str(item.get("name", "")).strip()
    key = str(item.get("key", "")).strip()
    value = str(item.get("value", "")).strip()
    kind = str(item.get("kind", item.get("type", "app"))).strip()
    if kind == "command":
        kind = "app"
    if kind == "dispatcher":
        kind = "desktop"
    if kind not in {"app", "desktop"}:
        kind = "app"
    if not name or not key or not value:
        return None
    return {"name": name, "key": key, "kind": kind, "value": value}


def load_shortcuts() -> list[dict]:
    if not KEYBINDS_JSON.exists():
        return default_shortcuts()
    try:
        raw = json.loads(KEYBINDS_JSON.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return default_shortcuts()
    if not isinstance(raw, list):
        return default_shortcuts()
    shortcuts = []
    for item in raw:
        if isinstance(item, dict):
            normalized = normalize_shortcut(item)
            if normalized:
                shortcuts.append(normalized)
    return shortcuts or default_shortcuts()


def save_shortcuts(shortcuts: list[dict]) -> None:
    DOTFILES_DIR.mkdir(parents=True, exist_ok=True)
    KEYBINDS_JSON.write_text(json.dumps(shortcuts, indent=2) + "\n", encoding="utf-8")


def load_hypr_schema() -> list[dict]:
    try:
        data = json.loads(HYPR_SCHEMA_FILE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        messagebox.showerror("Hyprland settings", f"Could not read {HYPR_SCHEMA_FILE}:\n{exc}")
        return []
    options = data.get("options", [])
    return [option for option in options if isinstance(option, dict) and option.get("path")]


def default_hypr_values(schema: list[dict]) -> dict[str, str]:
    return {option["path"]: str(option.get("default", "")) for option in schema}


def load_hypr_values(schema: list[dict]) -> dict[str, str]:
    values = default_hypr_values(schema)
    if not HYPR_VALUES_JSON.exists():
        return values
    try:
        raw = json.loads(HYPR_VALUES_JSON.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return values
    if isinstance(raw, dict):
        for key, value in raw.items():
            values[str(key)] = str(value)
    return values


def save_hypr_values(values: dict[str, str]) -> None:
    DOTFILES_DIR.mkdir(parents=True, exist_ok=True)
    HYPR_VALUES_JSON.write_text(json.dumps(values, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def bool_for_hypr(value: str) -> str:
    return "true" if value in {"1", "true", "True", "yes", "on"} else "false"


def clean_hypr_value(option: dict, value: str) -> str:
    value = str(value).strip()
    kind = option.get("type", "text")
    if kind == "bool":
        return bool_for_hypr(value)
    if kind == "int":
        try:
            number = int(float(value))
        except ValueError:
            number = int(float(option.get("default", "0") or 0))
        if "min" in option:
            number = max(int(option["min"]), number)
        if "max" in option:
            number = min(int(option["max"]), number)
        return str(number)
    if kind == "float":
        try:
            number = float(value)
        except ValueError:
            number = float(option.get("default", "0") or 0)
        if "min" in option:
            number = max(float(option["min"]), number)
        if "max" in option:
            number = min(float(option["max"]), number)
        return f"{number:g}"
    if kind == "choice":
        choices = [str(choice) for choice in option.get("choices", [])]
        return value if value in choices else str(option.get("default", ""))
    return value


def nested_set(tree: dict, parts: list[str], value: str) -> None:
    current = tree
    for part in parts[:-1]:
        current = current.setdefault(part, {})
    current[parts[-1]] = value


def render_hypr_tree(tree: dict, indent: int = 0) -> list[str]:
    lines: list[str] = []
    for key, value in tree.items():
        prefix = " " * indent
        if isinstance(value, dict):
            lines.append(f"{prefix}{key} {{")
            lines.extend(render_hypr_tree(value, indent + 4))
            lines.append(f"{prefix}}}")
        else:
            lines.append(f"{prefix}{key} = {value}")
    return lines


def hypr_option_supported(path: str) -> bool:
    if not shutil.which("hyprctl"):
        return True
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return True
    result = subprocess.run(
        ["hyprctl", "getoption", path],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return result.returncode == 0


def write_hyprland_settings(schema: list[dict], values: dict[str, str]) -> None:
    HYPR_DIR.mkdir(parents=True, exist_ok=True)
    option_by_path = {option["path"]: option for option in schema}
    tree: dict = {}
    for path, option in option_by_path.items():
        if not hypr_option_supported(path):
            continue
        value = clean_hypr_value(option, values.get(path, option.get("default", "")))
        if value == "":
            continue
        nested_set(tree, path.split(":"), value)
    lines = [
        "# Generated by Dotfiles Center. Edit with: dotctl center",
        "# This file is safe to regenerate.",
        "",
    ]
    lines.extend(render_hypr_tree(tree))
    HYPR_GENERATED.write_text("\n".join(lines) + "\n", encoding="utf-8")


def hex_to_hypr_rgba(hex_color: str) -> str:
    clean = hex_color.strip().lstrip("#")
    if len(clean) != 6 or not re.fullmatch(r"[0-9a-fA-F]{6}", clean):
        clean = "89b4fa"
    return f"rgba({clean.lower()}ff)"


def write_colors(accent: str) -> None:
    HYPR_DIR.mkdir(parents=True, exist_ok=True)
    HYPR_COLORS.write_text(
        f"$accent = {hex_to_hypr_rgba(accent)}\n$inactive = rgba(45475aff)\n",
        encoding="utf-8",
    )


def hypr_key_parts(key: str) -> tuple[str, str]:
    key = key.strip()
    if key.upper().startswith("SHIFT,"):
        return "$mainMod SHIFT", key.split(",", 1)[1].strip()
    return "$mainMod", key


def write_keybinds(values: dict[str, str], shortcuts: list[dict]) -> None:
    HYPR_DIR.mkdir(parents=True, exist_ok=True)
    lines = [
        "$mainMod = SUPER",
        f"$terminal = {values.get('DOTFILES_TERMINAL', DEFAULTS['DOTFILES_TERMINAL'])}",
        f"$fileManager = {values.get('DOTFILES_FILE_MANAGER', DEFAULTS['DOTFILES_FILE_MANAGER'])}",
        f"$menu = {values.get('DOTFILES_APP_LAUNCHER', DEFAULTS['DOTFILES_APP_LAUNCHER'])}",
        f"$browser = {values.get('DOTFILES_BROWSER', DEFAULTS['DOTFILES_BROWSER'])}",
        "",
        "# Hold Super + left mouse button to drag windows.",
        "bindm = $mainMod, mouse:272, movewindow",
        "# Hold Super + right mouse button to resize windows.",
        "bindm = $mainMod, mouse:273, resizewindow",
        "",
    ]
    for shortcut in shortcuts:
        clean = normalize_shortcut(shortcut)
        if not clean:
            continue
        modifier, key = hypr_key_parts(clean["key"])
        if clean["kind"] == "app":
            lines.append(f"bind = {modifier}, {key}, exec, {clean['value']}")
        else:
            lines.append(f"bind = {modifier}, {key}, {clean['value']}")
    lines.extend([
        "",
        "bind = $mainMod, left, movefocus, l",
        "bind = $mainMod, right, movefocus, r",
        "bind = $mainMod, up, movefocus, u",
        "bind = $mainMod, down, movefocus, d",
        "",
        "bind = $mainMod SHIFT, left, movewindow, l",
        "bind = $mainMod SHIFT, right, movewindow, r",
        "bind = $mainMod SHIFT, up, movewindow, u",
        "bind = $mainMod SHIFT, down, movewindow, d",
        "",
    ])
    for i in range(1, 10):
        lines.append(f"bind = $mainMod, {i}, workspace, {i}")
    lines.append("")
    for i in range(1, 10):
        lines.append(f"bind = $mainMod SHIFT, {i}, movetoworkspace, {i}")
    HYPR_KEYBINDS.write_text("\n".join(lines) + "\n", encoding="utf-8")


def clamp_int(value: str, default: int, minimum: int, maximum: int) -> int:
    try:
        number = int(float(value))
    except ValueError:
        number = default
    return max(minimum, min(maximum, number))


def clamp_float(value: str, default: float, minimum: float, maximum: float) -> float:
    try:
        number = float(value)
    except ValueError:
        number = default
    return max(minimum, min(maximum, number))


def is_true(value: str) -> bool:
    return value.lower() in {"1", "true", "yes", "on"}


def qml_string(value: str) -> str:
    return json.dumps(value)


def write_quickshell_bar(values: dict[str, str]) -> None:
    QUICKSHELL_DIR.mkdir(parents=True, exist_ok=True)

    position = values.get("DOTFILES_BAR_POSITION", "top")
    top = "true" if position == "top" else "false"
    bottom = "true" if position == "bottom" else "false"
    height = clamp_int(values.get("DOTFILES_BAR_HEIGHT", "34"), 34, 24, 72)
    radius = clamp_int(values.get("DOTFILES_BAR_RADIUS", "8"), 8, 0, 28)
    opacity = clamp_float(values.get("DOTFILES_BAR_OPACITY", "0.92"), 0.92, 0.2, 1.0)
    accent = values.get("DOTFILES_ACCENT", "#89b4fa")
    font_size = clamp_int(values.get("DOTFILES_BAR_FONT_SIZE", "12"), 12, 8, 24)
    spacing = clamp_int(values.get("DOTFILES_BAR_SPACING", "14"), 14, 4, 40)
    border_width = clamp_int(values.get("DOTFILES_BAR_BORDER_WIDTH", "1"), 1, 0, 4)
    workspace_count = clamp_int(values.get("DOTFILES_BAR_WORKSPACE_COUNT", "9"), 9, 1, 20)
    clock_format = values.get("DOTFILES_BAR_CLOCK_FORMAT", "%a %d %b  %H:%M")
    clock_seconds = is_true(values.get("DOTFILES_BAR_CLOCK_SECONDS", "false"))
    if clock_seconds and "%S" not in clock_format:
        clock_format = clock_format.rstrip() + ":%S"

    show_workspaces = is_true(values.get("DOTFILES_BAR_SHOW_WORKSPACES", "true"))
    show_clock = is_true(values.get("DOTFILES_BAR_SHOW_CLOCK", "true"))
    show_volume = is_true(values.get("DOTFILES_BAR_SHOW_VOLUME", "true"))
    show_network = is_true(values.get("DOTFILES_BAR_SHOW_NETWORK", "true"))
    show_battery = is_true(values.get("DOTFILES_BAR_SHOW_BATTERY", "true"))
    show_cpu = is_true(values.get("DOTFILES_BAR_SHOW_CPU", "false"))
    show_memory = is_true(values.get("DOTFILES_BAR_SHOW_MEMORY", "false"))
    show_tray = is_true(values.get("DOTFILES_BAR_SHOW_TRAY", "false"))
    accent_workspace = is_true(values.get("DOTFILES_BAR_ACCENT_WORKSPACE", "true"))

    bg_alpha = int(opacity * 255)
    bg_color = "#%02x1e1e2e" % bg_alpha

    # Build status command dynamically
    status_parts = []
    if show_volume:
        status_parts.append("printf 'VOL '; wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{v=int($2*100); if($3==\"[MUTED]\") print \"MUTE\"; else print v\"%\"}'")
    if show_network:
        status_parts.append("printf '  NET '; nmcli -t -f GENERAL.STATE device show 2>/dev/null | grep -q ':100' && echo on || echo off")
    if show_battery:
        status_parts.append("bat=$(cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || cat /sys/class/power_supply/BAT1/capacity 2>/dev/null); [ -n \"$bat\" ] && printf '  BAT %s%%' \"$bat\"")
    if show_cpu:
        status_parts.append("cpu=$(top -bn1 | grep 'Cpu(s)' | awk '{print int($2+$4)\"%\"}' 2>/dev/null); [ -n \"$cpu\" ] && printf '  CPU %s' \"$cpu\"")
    if show_memory:
        status_parts.append("mem=$(free -m | awk '/^Mem/{printf \"%dMB\", $3}' 2>/dev/null); [ -n \"$mem\" ] && printf '  MEM %s' \"$mem\"")

    if status_parts:
        status_cmd = "; ".join(status_parts)
    else:
        status_cmd = "echo ''"

    # Build left section (workspaces)
    left_section = ""
    if show_workspaces:
        ws_color = qml_string(accent) if accent_workspace else '"#313244"'
        left_section = f"""
          Row {{
            Layout.alignment: Qt.AlignVCenter
            spacing: 6

            Repeater {{
              model: {workspace_count}
              Rectangle {{
                width: {height - 10}
                height: {height - 10}
                radius: {max(3, radius - 4)}
                color: index === 0 ? {ws_color} : "#313244"
                opacity: index === 0 ? 1.0 : 0.7

                Text {{
                  anchors.centerIn: parent
                  text: index + 1
                  color: index === 0 ? "#11111b" : "#cdd6f4"
                  font.bold: true
                  font.pixelSize: {font_size - 1}
                }}

                MouseArea {{
                  anchors.fill: parent
                  onClicked: switchWorkspace.running = true
                  hoverEnabled: true
                  onEntered: parent.opacity = 1.0
                  onExited: parent.opacity = index === 0 ? 1.0 : 0.7
                }}

                Process {{
                  id: switchWorkspace
                  command: ["hyprctl", "dispatch", "workspace", String(index + 1)]
                }}
              }}
            }}
          }}"""

    # Build center section (clock)
    center_section = ""
    if show_clock:
        clock_interval = 1000 if clock_seconds else 1000
        center_section = f"""
          Text {{
            id: clock
            Layout.alignment: Qt.AlignCenter
            color: "#cdd6f4"
            font.bold: true
            font.pixelSize: {font_size}
            text: "Loading..."

            Process {{
              id: dateProc
              command: ["date", "+{clock_format}"]
              running: true
              stdout: StdioCollector {{
                onStreamFinished: clock.text = this.text.trim()
              }}
            }}

            Timer {{
              interval: {clock_interval}
              running: true
              repeat: true
              onTriggered: dateProc.running = true
            }}
          }}"""

    # Build right section (status modules)
    right_section = ""
    if any([show_volume, show_network, show_battery, show_cpu, show_memory]):
        right_section = f"""
          Text {{
            id: status
            Layout.alignment: Qt.AlignRight | Qt.AlignVCenter
            color: "#bac2de"
            font.pixelSize: {font_size}
            text: ""

            Process {{
              id: statusProc
              command: ["sh", "-c", "{status_cmd.replace(chr(34), chr(92)+chr(34))}"]
              running: true
              stdout: StdioCollector {{
                onStreamFinished: status.text = this.text.replace(/\\n/g, "").trim()
              }}
            }}

            Timer {{
              interval: 3000
              running: true
              repeat: true
              onTriggered: statusProc.running = true
            }}
          }}"""

    # Handle tray placeholder
    tray_section = ""
    if show_tray:
        tray_section = f"""
          Text {{
            Layout.alignment: Qt.AlignRight | Qt.AlignVCenter
            color: "#6c7086"
            font.pixelSize: {font_size - 2}
            text: "·"
          }}"""

    qml = f"""// SplinterDots Quickshell bar.
// Generated by Dotfiles Center. Edit the Bar tab instead of hand-editing this file.

import Quickshell
import Quickshell.Io
import QtQuick
import QtQuick.Layouts

Variants {{
  model: Quickshell.screens

  delegate: Component {{
    PanelWindow {{
      required property var modelData
      screen: modelData

      anchors {{
        top: {top}
        bottom: {bottom}
        left: true
        right: true
      }}

      margins {{
        top: {8 if position == "top" else 0}
        bottom: {8 if position == "bottom" else 0}
        left: 10
        right: 10
      }}

      implicitHeight: {height}
      color: "transparent"

      Rectangle {{
        anchors.fill: parent
        radius: {radius}
        color: "{bg_color}"
        border.width: {border_width}
        border.color: "#313244"

        RowLayout {{
          anchors.fill: parent
          anchors.leftMargin: {spacing}
          anchors.rightMargin: {spacing}
          spacing: {spacing}
{left_section}
          Item {{ Layout.fillWidth: true }}
{center_section}
          Item {{ Layout.fillWidth: true }}
{right_section}{tray_section}
        }}
      }}
    }}
  }}
}}
"""
    QUICKSHELL_FILE.write_text(qml, encoding="utf-8")


def run_quiet(command: list[str]) -> None:
    try:
        subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


# ──────────────────────────────────────────────────────────────────────────────
# Sleek ScrollFrame with styled scrollbar
# ──────────────────────────────────────────────────────────────────────────────

class ScrollFrame(ttk.Frame):
    """Scrollable container with mouse-wheel support on the whole content area."""

    def __init__(self, parent: tk.Widget, **kwargs) -> None:
        super().__init__(parent, **kwargs)
        self.canvas = tk.Canvas(self, highlightthickness=0, bg="#172033", bd=0)
        self.scrollbar = ttk.Scrollbar(self, orient="vertical", command=self.canvas.yview, style="Slim.Vertical.TScrollbar")
        self.inner = ttk.Frame(self.canvas, style="Panel.TFrame")
        self.window_id = self.canvas.create_window((0, 0), window=self.inner, anchor="nw")

        self.canvas.configure(yscrollcommand=self._on_scroll)
        self.canvas.pack(side="left", fill="both", expand=True)
        self.scrollbar.pack(side="right", fill="y")

        self.inner.bind("<Configure>", self._update_scrollregion)
        self.canvas.bind("<Configure>", self._update_width)
        # Bind mouse wheel on canvas and inner frame
        for widget in (self.canvas, self.inner):
            widget.bind("<MouseWheel>", self._wheel)
            widget.bind("<Button-4>", self._wheel)
            widget.bind("<Button-5>", self._wheel)

    def _on_scroll(self, *args):
        self.scrollbar.set(*args)

    def _update_scrollregion(self, _event=None):
        self.canvas.configure(scrollregion=self.canvas.bbox("all"))

    def _update_width(self, event):
        self.canvas.itemconfigure(self.window_id, width=event.width)

    def _wheel(self, event) -> None:
        if not self.winfo_ismapped():
            return
        # Linux button events
        if event.num == 4:
            self.canvas.yview_scroll(-3, "units")
        elif event.num == 5:
            self.canvas.yview_scroll(3, "units")
        elif event.delta:
            self.canvas.yview_scroll(int(-1 * (event.delta / 120)), "units")

    def bind_children(self, widget: tk.Widget) -> None:
        """Recursively bind mouse wheel to all children so scrolling works anywhere."""
        for child in widget.winfo_children():
            child.bind("<MouseWheel>", self._wheel)
            child.bind("<Button-4>", self._wheel)
            child.bind("<Button-5>", self._wheel)
            self.bind_children(child)


# ──────────────────────────────────────────────────────────────────────────────
# Toggle (on/off pill) widget
# ──────────────────────────────────────────────────────────────────────────────

class Toggle(tk.Canvas):
    """Minimal pill-style toggle switch."""
    W, H = 36, 20
    TRACK_ON = "#2563eb"
    TRACK_OFF = "#374151"
    KNOB = "#ffffff"

    def __init__(self, parent, variable: tk.BooleanVar, **kwargs):
        super().__init__(parent, width=self.W, height=self.H,
                         highlightthickness=0, bd=0,
                         bg=parent["bg"] if hasattr(parent, "__getitem__") else "#1f2937",
                         **kwargs)
        self._var = variable
        self._draw()
        self.bind("<Button-1>", self._toggle)
        variable.trace_add("write", lambda *_: self._draw())

    def _draw(self):
        self.delete("all")
        on = self._var.get()
        track_color = self.TRACK_ON if on else self.TRACK_OFF
        r = self.H // 2
        # track
        self.create_rounded_rect(0, 0, self.W, self.H, r, fill=track_color, outline="")
        # knob
        kx = self.W - r - 2 if on else r + 2
        self.create_oval(kx - (r - 3), 2, kx + (r - 3), self.H - 2, fill=self.KNOB, outline="")

    def create_rounded_rect(self, x1, y1, x2, y2, r, **kwargs):
        self.create_arc(x1, y1, x1 + 2*r, y1 + 2*r, start=90, extent=90, **kwargs)
        self.create_arc(x2 - 2*r, y1, x2, y1 + 2*r, start=0, extent=90, **kwargs)
        self.create_arc(x1, y2 - 2*r, x1 + 2*r, y2, start=180, extent=90, **kwargs)
        self.create_arc(x2 - 2*r, y2 - 2*r, x2, y2, start=270, extent=90, **kwargs)
        self.create_rectangle(x1 + r, y1, x2 - r, y2, **kwargs)
        self.create_rectangle(x1, y1 + r, x2, y2 - r, **kwargs)

    def _toggle(self, _event=None):
        self._var.set(not self._var.get())


# ──────────────────────────────────────────────────────────────────────────────
# Main application
# ──────────────────────────────────────────────────────────────────────────────

class DotfilesCenter(tk.Tk):
    # Catppuccin Mocha-inspired palette, slightly elevated
    bg       = "#0f1117"   # near-black base
    panel    = "#151820"   # sidebar / tab bg
    card     = "#1a1f2e"   # card surface
    card_alt = "#1e2436"   # alternate card (slightly lighter)
    border   = "#252d3d"   # subtle divider
    text     = "#cdd6f4"   # primary text
    muted    = "#6c7086"   # secondary text
    accent   = "#89b4fa"   # blue accent
    accent_dk= "#1d4ed8"   # button bg
    green    = "#a6e3a1"
    red      = "#f38ba8"

    def __init__(self, force: bool) -> None:
        super().__init__()
        self.force = force
        self.values = read_local_conf()
        self.hypr_schema = load_hypr_schema()
        self.hypr_values = load_hypr_values(self.hypr_schema)
        self.hypr_vars: dict[str, tk.StringVar] = {}
        self.title("Dotfiles Center")
        self.geometry("1020x740")
        self.minsize(900, 620)
        self.configure(bg=self.bg)

        self.vars = {key: tk.StringVar(value=value) for key, value in self.values.items()}
        self.bool_vars: dict[str, tk.BooleanVar] = {}
        self.shortcuts = load_shortcuts()
        self.shortcut_tree: ttk.Treeview | None = None
        self.no_show_var = tk.BooleanVar(value=DISABLED_FILE.exists())

        self._setup_style()
        self._build()

    def _setup_style(self) -> None:
        style = ttk.Style(self)
        try:
            style.theme_use("clam")
        except tk.TclError:
            pass

        def cfg(name: str, **kw) -> None:
            try:
                style.configure(name, **kw)
            except tk.TclError:
                pass

        def mp(name: str, **kw) -> None:
            try:
                style.map(name, **kw)
            except tk.TclError:
                pass

        cfg(".", font=("Sans", 10), background=self.bg, foreground=self.text)
        cfg("Root.TFrame",   background=self.bg)
        cfg("Panel.TFrame",  background=self.panel)
        cfg("Card.TFrame",   background=self.card,     relief="flat")
        cfg("CardAlt.TFrame",background=self.card_alt, relief="flat")
        cfg("Border.TFrame", background=self.border)

        cfg("Title.TLabel",    background=self.bg,       foreground=self.text,  font=("Sans", 22, "bold"))
        cfg("Subtitle.TLabel", background=self.bg,       foreground=self.muted, font=("Sans", 10))
        cfg("Heading.TLabel",  background=self.card,     foreground=self.text,  font=("Sans", 12, "bold"))
        cfg("Body.TLabel",     background=self.card,     foreground=self.muted, font=("Sans", 10))
        cfg("Muted.TLabel",    background=self.bg,       foreground=self.muted)
        cfg("Card.TLabel",     background=self.card,     foreground=self.text)
        cfg("CardMuted.TLabel",background=self.card,     foreground=self.muted)
        cfg("AltLabel.TLabel", background=self.card_alt, foreground=self.text)
        cfg("AltMuted.TLabel", background=self.card_alt, foreground=self.muted)
        cfg("PanelLabel.TLabel",background=self.panel,   foreground=self.text)

        cfg("Accent.TButton",
            background=self.accent_dk, foreground="#ffffff",
            borderwidth=0, focusthickness=0, padding=(14, 8), font=("Sans", 10))
        mp("Accent.TButton",
           background=[("active", "#2563eb"), ("pressed", "#1e40af")])

        cfg("Ghost.TButton",
            background=self.card_alt, foreground=self.text,
            borderwidth=0, padding=(12, 7), font=("Sans", 10))
        mp("Ghost.TButton",
           background=[("active", self.border)])

        cfg("TButton", padding=(12, 7), borderwidth=0, background=self.card_alt, foreground=self.text)
        mp("TButton", background=[("active", self.border)])

        cfg("TCheckbutton", background=self.card, foreground=self.text, focusthickness=0)
        mp("TCheckbutton", background=[("active", self.card)])

        cfg("TNotebook",     background=self.bg,    borderwidth=0, tabmargins=(0, 6, 0, 0))
        cfg("TNotebook.Tab", background=self.panel, foreground=self.muted,
            padding=(16, 9), borderwidth=0, font=("Sans", 10))
        mp("TNotebook.Tab",
           background=[("selected", self.card)],
           foreground=[("selected", self.text), ("active", self.text)])

        cfg("TEntry",    fieldbackground="#0d1117", foreground=self.text, padding=8,
            borderwidth=1, relief="flat", insertcolor=self.text)
        cfg("TCombobox", fieldbackground="#0d1117", foreground=self.text, padding=8)
        mp("TCombobox",
           fieldbackground=[("readonly", "#0d1117")],
           selectbackground=[("readonly", "#0d1117")],
           selectforeground=[("readonly", self.text)])

        cfg("Treeview",
            background=self.card_alt, fieldbackground=self.card_alt,
            foreground=self.text, rowheight=28, borderwidth=0, font=("Sans", 10))
        cfg("Treeview.Heading",
            background=self.card, foreground=self.muted,
            padding=(8, 6), borderwidth=0, font=("Sans", 9))
        mp("Treeview",
           background=[("selected", "#1d4ed8")],
           foreground=[("selected", "#ffffff")])

        # Slim scrollbar
        cfg("Slim.Vertical.TScrollbar",
            background=self.border, troughcolor=self.panel,
            borderwidth=0, arrowsize=0, width=6, relief="flat")
        mp("Slim.Vertical.TScrollbar",
           background=[("active", self.muted), ("pressed", self.accent)])

    def _section_label(self, parent: tk.Widget, text: str) -> None:
        """Eyebrow label above a card group."""
        f = ttk.Frame(parent, style="Panel.TFrame")
        f.pack(fill="x", padx=0, pady=(12, 4))
        ttk.Label(f, text=text.upper(), style="Muted.TLabel",
                  font=("Sans", 8, "bold")).pack(anchor="w", padx=2)

    def _card(self, parent: tk.Widget, padding: int = 16) -> ttk.Frame:
        card = ttk.Frame(parent, style="Card.TFrame", padding=padding)
        card.pack(fill="x", pady=(0, 8))
        return card

    def _card_title(self, parent: tk.Widget, title: str, body: str | None = None) -> None:
        ttk.Label(parent, text=title, style="Heading.TLabel").pack(anchor="w")
        if body:
            ttk.Label(parent, text=body, style="Body.TLabel", wraplength=840).pack(anchor="w", pady=(4, 0))

    def _divider(self, parent: tk.Widget) -> None:
        ttk.Frame(parent, style="Border.TFrame", height=1).pack(fill="x", pady=8)

    def _toggle_row(self, parent: tk.Widget, label: str, var: tk.BooleanVar, bg: str = None) -> None:
        """A labelled toggle row inside a card."""
        bg = bg or self.card
        row = tk.Frame(parent, bg=bg)
        row.pack(fill="x", pady=3)
        tk.Label(row, text=label, bg=bg, fg=self.text, font=("Sans", 10)).pack(side="left")
        Toggle(row, var, bg=bg).pack(side="right")

    def _bool_var(self, key: str) -> tk.BooleanVar:
        raw = self.values.get(key, DEFAULTS.get(key, "false"))
        v = tk.BooleanVar(value=raw.lower() in {"1", "true", "yes", "on"})
        def sync(bv=v, sv=self.vars[key]):
            sv.set("true" if bv.get() else "false")
        v.trace_add("write", lambda *_: sync())
        self.bool_vars[key] = v
        return v

    def _build(self) -> None:
        # ── Header ──────────────────────────────────────────────────────────
        header = tk.Frame(self, bg=self.bg)
        header.pack(fill="x", padx=28, pady=(22, 6))

        title_row = tk.Frame(header, bg=self.bg)
        title_row.pack(fill="x")
        tk.Label(title_row, text="Dotfiles Center", bg=self.bg, fg=self.text,
                 font=("Sans", 22, "bold")).pack(side="left")

        # Thin accent bar below title
        tk.Frame(header, bg=self.accent, height=2).pack(fill="x", pady=(6, 0))

        tk.Label(header, text="Hyprland  ·  Shortcuts  ·  Appearance  ·  QML Bar  ·  Setup",
                 bg=self.bg, fg=self.muted, font=("Sans", 9)).pack(anchor="w", pady=(6, 0))

        # ── Notebook ────────────────────────────────────────────────────────
        notebook = ttk.Notebook(self)
        notebook.pack(fill="both", expand=True, padx=24, pady=(8, 0))

        self._overview_tab(notebook)
        self._hyprland_tab(notebook)
        self._shortcuts_tab(notebook)
        self._appearance_tab(notebook)
        self._bar_tab(notebook)
        self._setup_tab(notebook)

        # ── Footer ──────────────────────────────────────────────────────────
        footer = tk.Frame(self, bg=self.bg)
        footer.pack(fill="x", padx=24, pady=(6, 16), side="bottom")

        # Thin separator line
        tk.Frame(footer, bg=self.border, height=1).pack(fill="x", pady=(0, 10))

        foot_row = tk.Frame(footer, bg=self.bg)
        foot_row.pack(fill="x")

        ttk.Checkbutton(
            foot_row,
            text="Don't show on startup",
            variable=self.no_show_var,
            command=self.save_startup_choice,
            style="TCheckbutton",
        ).pack(side="left")

        ttk.Button(foot_row, text="Save changes", style="Accent.TButton",
                   command=self.save_all).pack(side="right")

    # ── Overview tab ─────────────────────────────────────────────────────────

    def _overview_tab(self, nb: ttk.Notebook) -> None:
