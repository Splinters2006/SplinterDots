                  font=("Sans", 14, "bold")).pack(anchor="w")
        ttk.Label(hero,
                  text="Minimal Arch install → full Hyprland desktop. Use switches and dropdowns instead of config files.",
                  style="Body.TLabel", wraplength=840).pack(anchor="w", pady=(4, 14))

        grid = tk.Frame(hero, bg=self.card)
        grid.pack(fill="x")
        shortcuts_hint = [
            ("Super + D",           "App launcher"),
            ("Super + Return",      "Terminal"),
            ("Super + Left Mouse",  "Drag window"),
            ("Super + Right Mouse", "Resize window"),
            ("Super + W",           "Dotfiles Center"),
            ("Super + Shift + R",   "Reload Hyprland"),
        ]
        for col, (key, label) in enumerate(shortcuts_hint):
            cell = tk.Frame(grid, bg=self.card_alt, padx=10, pady=8)
            cell.grid(row=0, column=col, sticky="ew", padx=(0 if col == 0 else 6, 0))
            tk.Label(cell, text=key,   bg=self.card_alt, fg=self.text,  font=("Sans", 10, "bold")).pack(anchor="w")
            tk.Label(cell, text=label, bg=self.card_alt, fg=self.muted, font=("Sans", 9)).pack(anchor="w", pady=(2,0))
            grid.columnconfigure(col, weight=1)

        info = self._card(frame)
        self._card_title(info, "Installed components")
        items = [
            "Hyprland  ·  Quickshell QML bar  ·  Wofi launcher  ·  Mako notifications",
            "Kitty terminal  ·  Thunar file manager  ·  Zen Browser",
            "PipeWire audio  ·  EasyEffects presets  ·  NetworkManager  ·  Bluetooth",
            "Screenshot  ·  Clipboard  ·  Wallpaper  ·  XDG portals  ·  greetd login",
        ]
        for item in items:
            row = tk.Frame(info, bg=self.card)
            row.pack(fill="x", pady=2)
            tk.Label(row, text="·", bg=self.card, fg=self.accent, font=("Sans", 10, "bold")).pack(side="left", padx=(0, 8))
            tk.Label(row, text=item, bg=self.card, fg=self.muted, font=("Sans", 10)).pack(side="left")

        cmds = self._card(frame)
        self._card_title(cmds, "Terminal commands")
        cmd_list = [
            ("dotctl all",     "Update repo, install packages, apply dotfiles"),
            ("dotctl status",  "Show linked files"),
            ("dotctl doctor",  "Debug Hyprland and graphics issues"),
            ("dotctl center",  "Open this window"),
        ]
        for cmd, desc in cmd_list:
            row = tk.Frame(cmds, bg=self.card)
            row.pack(fill="x", pady=2)
            tk.Label(row, text=cmd,  bg=self.card, fg=self.accent, font=("Monospace", 10)).pack(side="left", padx=(0, 10))
            tk.Label(row, text=desc, bg=self.card, fg=self.muted,  font=("Sans", 10)).pack(side="left")

    # ── Hyprland tab ─────────────────────────────────────────────────────────

    def _hyprland_tab(self, nb: ttk.Notebook) -> None:
        outer = ttk.Frame(nb, style="Panel.TFrame", padding=20)
        nb.add(outer, text="Hyprland")

        intro = self._card(outer)
        self._card_title(
            intro,
            "Hyprland settings",
            "Toggles for on/off · dropdowns for multiple choices · text boxes for numbers, colors, and paths.",
        )

        scroll = ScrollFrame(outer, style="Panel.TFrame")
        scroll.pack(fill="both", expand=True)

        grouped: dict[str, list[dict]] = {}
        for option in self.hypr_schema:
            grouped.setdefault(str(option.get("section", "Other")), []).append(option)

        for section, options in grouped.items():
            sec_card = ttk.Frame(scroll.inner, style="Card.TFrame", padding=14)
            sec_card.pack(fill="x", padx=0, pady=(0, 8))

            # Section header with colored left border simulation
            hdr = tk.Frame(sec_card, bg=self.card)
            hdr.grid(row=0, column=0, columnspan=3, sticky="ew", pady=(0, 8))
            tk.Frame(hdr, bg=self.accent, width=3, height=16).pack(side="left")
            tk.Label(hdr, text=section, bg=self.card, fg=self.text,
                     font=("Sans", 11, "bold"), padx=8).pack(side="left")

            for row, option in enumerate(options, start=1):
                path = option["path"]
                label = str(option.get("label", path.replace(":", " / ").replace("_", " ").title()))
                value = self.hypr_values.get(path, str(option.get("default", "")))
                var = tk.StringVar(value=value)
                self.hypr_vars[path] = var

                tk.Label(sec_card, text=label, bg=self.card, fg=self.text,
                         font=("Sans", 10)).grid(row=row, column=0, sticky="w", padx=(0, 16), pady=3)

                kind = option.get("type", "text")
                if kind == "bool":
                    bool_var = tk.BooleanVar(value=value in {"1", "true", "True", "yes", "on"})
                    self.hypr_vars[path] = var
                    def sync_bool(target=var, source=bool_var):
                        target.set("true" if source.get() else "false")
                    Toggle(sec_card, bool_var, bg=self.card).grid(row=row, column=1, sticky="w", pady=3)
                    sync_bool()
                    bool_var.trace_add("write", lambda *_, t=var, s=bool_var: t.set("true" if s.get() else "false"))
                elif kind == "choice":
                    choices = [str(c) for c in option.get("choices", [])]
                    ttk.Combobox(sec_card, textvariable=var, values=choices,
                                 state="readonly", width=22).grid(row=row, column=1, sticky="w", pady=3)
                else:
                    ttk.Entry(sec_card, textvariable=var, width=24).grid(row=row, column=1, sticky="w", pady=3)

                tk.Label(sec_card, text=path, bg=self.card, fg=self.muted,
                         font=("Monospace", 8)).grid(row=row, column=2, sticky="w", padx=(16, 0), pady=3)

            sec_card.columnconfigure(2, weight=1)
            scroll.bind_children(sec_card)

    # ── Shortcuts tab ────────────────────────────────────────────────────────

    def _shortcuts_tab(self, nb: ttk.Notebook) -> None:
        frame = ttk.Frame(nb, style="Panel.TFrame", padding=20)
        nb.add(frame, text="Shortcuts")

        intro = self._card(frame)
        self._card_title(
            intro, "Shortcuts",
            "All shortcuts use Super (Windows key). Save changes, then press Super + Shift + R to reload Hyprland.",
        )

        table_card = self._card(frame)
        self.shortcut_tree = ttk.Treeview(
            table_card, columns=("key", "kind", "value"),
            show="tree headings", height=12,
        )
        self.shortcut_tree.heading("#0",     text="Name")
        self.shortcut_tree.heading("key",    text="Key")
        self.shortcut_tree.heading("kind",   text="Type")
        self.shortcut_tree.heading("value",  text="Action")
        self.shortcut_tree.column("#0",    width=170, stretch=True)
        self.shortcut_tree.column("key",   width=100, stretch=False)
        self.shortcut_tree.column("kind",  width=140, stretch=False)
        self.shortcut_tree.column("value", width=400, stretch=True)
        self.shortcut_tree.pack(fill="both", expand=True)
        self.shortcut_tree.bind("<Double-1>", lambda _: self.edit_shortcut())

        btns = tk.Frame(table_card, bg=self.card)
        btns.pack(fill="x", pady=(10, 0))
        ttk.Button(btns, text="Add shortcut",    style="Accent.TButton", command=self.add_shortcut).pack(side="left")
        ttk.Button(btns, text="Edit selected",   style="Ghost.TButton",  command=self.edit_shortcut).pack(side="left", padx=6)
        ttk.Button(btns, text="Remove selected", style="Ghost.TButton",  command=self.remove_shortcut).pack(side="left", padx=6)
        ttk.Button(btns, text="Restore defaults",style="Ghost.TButton",  command=self.reset_shortcuts).pack(side="left", padx=6)

        hint = self._card(frame)
        self._card_title(hint, "Mouse controls",
            "Super + left mouse drag  →  move window   ·   Super + right mouse drag  →  resize window")
        self.refresh_shortcut_tree()

    # ── Appearance tab ───────────────────────────────────────────────────────

    def _appearance_tab(self, nb: ttk.Notebook) -> None:
        frame = ttk.Frame(nb, style="Panel.TFrame", padding=20)
        nb.add(frame, text="Appearance")

        card = self._card(frame)
        self._card_title(card, "Colors & wallpaper", "Pick an accent color and wallpaper image.")

        form = tk.Frame(card, bg=self.card)
        form.pack(fill="x", pady=(14, 0))

        rows = [
            ("Theme",        "DOTFILES_THEME",    None,   ["dark", "light"]),
            ("Accent color", "DOTFILES_ACCENT",   None,   None),
            ("Wallpaper",    "DOTFILES_WALLPAPER", None,   None),
        ]
        for r, (label, key, _, choices) in enumerate(rows):
            tk.Label(form, text=label, bg=self.card, fg=self.text,
                     font=("Sans", 10)).grid(row=r, column=0, sticky="w", pady=8, padx=(0, 16))
            if choices:
                ttk.Combobox(form, textvariable=self.vars[key], values=choices,
                             state="readonly", width=16).grid(row=r, column=1, sticky="w", pady=8)
            else:
                width = 48 if key == "DOTFILES_WALLPAPER" else 18
                ttk.Entry(form, textvariable=self.vars[key], width=width).grid(row=r, column=1, sticky="ew", pady=8, padx=(0, 8))
                if key == "DOTFILES_ACCENT":
                    ttk.Button(form, text="Pick", style="Ghost.TButton",
                               command=self.choose_color).grid(row=r, column=2, sticky="w", pady=8)
                elif key == "DOTFILES_WALLPAPER":
                    ttk.Button(form, text="Browse", style="Ghost.TButton",
                               command=self.choose_wallpaper).grid(row=r, column=2, sticky="w", pady=8)
        form.columnconfigure(1, weight=1)

        btns = tk.Frame(card, bg=self.card)
        btns.pack(anchor="w", pady=(12, 0))
        ttk.Button(btns, text="Apply wallpaper", style="Accent.TButton",
                   command=self.apply_wallpaper).pack(side="left")

    # ── Bar tab ──────────────────────────────────────────────────────────────

    def _bar_tab(self, nb: ttk.Notebook) -> None:
        outer = ttk.Frame(nb, style="Panel.TFrame", padding=20)
        nb.add(outer, text="QML Bar")

        scroll = ScrollFrame(outer, style="Panel.TFrame")
        scroll.pack(fill="both", expand=True)
        inner = scroll.inner

        # ── Layout card
        layout_card = self._card(inner)
        self._card_title(layout_card, "Layout", "Position and arrangement of bar elements.")
        lg = tk.Frame(layout_card, bg=self.card)
        lg.pack(fill="x", pady=(10, 0))
        layout_rows = [
            ("Position",   "DOTFILES_BAR_POSITION",   ["top", "bottom"]),
            ("Workspaces", "DOTFILES_BAR_WORKSPACES",  ["left"]),
            ("Clock",      "DOTFILES_BAR_CLOCK",       ["center"]),
            ("Status",     "DOTFILES_BAR_STATUS",      ["right"]),
        ]
        for r, (label, key, choices) in enumerate(layout_rows):
            tk.Label(lg, text=label, bg=self.card, fg=self.text,
                     font=("Sans", 10)).grid(row=r, column=0, sticky="w", pady=6, padx=(0, 16))
            ttk.Combobox(lg, textvariable=self.vars[key], values=choices,
                         state="readonly", width=14).grid(row=r, column=1, sticky="w", pady=6)
        lg.columnconfigure(1, weight=1)

        # ── Modules card
        modules_card = self._card(inner)
        self._card_title(modules_card, "Modules", "Toggle which widgets appear in the bar.")
        mc = tk.Frame(modules_card, bg=self.card)
        mc.pack(fill="x", pady=(10, 0))
        module_toggles = [
            ("Workspaces",  "DOTFILES_BAR_SHOW_WORKSPACES"),
            ("Clock",       "DOTFILES_BAR_SHOW_CLOCK"),
            ("Volume",      "DOTFILES_BAR_SHOW_VOLUME"),
            ("Network",     "DOTFILES_BAR_SHOW_NETWORK"),
            ("Battery",     "DOTFILES_BAR_SHOW_BATTERY"),
            ("CPU usage",   "DOTFILES_BAR_SHOW_CPU"),
            ("Memory usage","DOTFILES_BAR_SHOW_MEMORY"),
        ]
        # Two-column layout for toggles
        for i, (label, key) in enumerate(module_toggles):
            col = i % 2
            row = i // 2
            cell = tk.Frame(mc, bg=self.card)
            cell.grid(row=row, column=col, sticky="ew", padx=(0 if col == 0 else 10, 0), pady=3)
            bv = self._bool_var(key)
            tk.Label(cell, text=label, bg=self.card, fg=self.text,
                     font=("Sans", 10)).pack(side="left")
            Toggle(cell, bv, bg=self.card).pack(side="right")
        mc.columnconfigure(0, weight=1)
        mc.columnconfigure(1, weight=1)

        # ── Clock card
        clock_card = self._card(inner)
        self._card_title(clock_card, "Clock", "Format and display options.")
        cg = tk.Frame(clock_card, bg=self.card)
        cg.pack(fill="x", pady=(10, 0))
        tk.Label(cg, text="Format string", bg=self.card, fg=self.text,
                 font=("Sans", 10)).grid(row=0, column=0, sticky="w", pady=6, padx=(0, 16))
        ttk.Entry(cg, textvariable=self.vars["DOTFILES_BAR_CLOCK_FORMAT"], width=28).grid(
            row=0, column=1, sticky="ew", pady=6)
        tk.Label(cg, text="e.g. %a %d %b  %H:%M", bg=self.card, fg=self.muted,
                 font=("Sans", 9)).grid(row=1, column=1, sticky="w")

        sec_row = tk.Frame(cg, bg=self.card)
        sec_row.grid(row=2, column=0, columnspan=2, sticky="w", pady=6)
        tk.Label(sec_row, text="Show seconds", bg=self.card, fg=self.text,
                 font=("Sans", 10)).pack(side="left", padx=(0, 16))
        Toggle(sec_row, self._bool_var("DOTFILES_BAR_CLOCK_SECONDS"), bg=self.card).pack(side="left")
        cg.columnconfigure(1, weight=1)

        # ── Workspaces card
        ws_card = self._card(inner)
        self._card_title(ws_card, "Workspaces", "Number and style of workspace buttons.")
        wg = tk.Frame(ws_card, bg=self.card)
        wg.pack(fill="x", pady=(10, 0))
        tk.Label(wg, text="Workspace count", bg=self.card, fg=self.text,
                 font=("Sans", 10)).grid(row=0, column=0, sticky="w", pady=6, padx=(0, 16))
        ttk.Combobox(wg, textvariable=self.vars["DOTFILES_BAR_WORKSPACE_COUNT"],
                     values=["5","6","7","8","9","10","12","15","20"],
                     state="readonly", width=8).grid(row=0, column=1, sticky="w", pady=6)

        accent_row = tk.Frame(wg, bg=self.card)
        accent_row.grid(row=1, column=0, columnspan=2, sticky="w", pady=6)
        tk.Label(accent_row, text="Accent active workspace", bg=self.card, fg=self.text,
                 font=("Sans", 10)).pack(side="left", padx=(0, 16))
        Toggle(accent_row, self._bool_var("DOTFILES_BAR_ACCENT_WORKSPACE"), bg=self.card).pack(side="left")
        wg.columnconfigure(1, weight=1)

        # ── Sizing card
        sizing_card = self._card(inner)
        self._card_title(sizing_card, "Sizing & style", "Dimensions, rounding, and opacity.")
        slider_rows = [
            ("Height",   "DOTFILES_BAR_HEIGHT",  24, 72,  1),
            ("Rounding", "DOTFILES_BAR_RADIUS",   0, 28,  1),
            ("Opacity",  "DOTFILES_BAR_OPACITY",  0.2, 1.0, 0.05),
            ("Font size","DOTFILES_BAR_FONT_SIZE", 8, 24, 1),
            ("Spacing",  "DOTFILES_BAR_SPACING",   4, 40, 1),
            ("Border",   "DOTFILES_BAR_BORDER_WIDTH", 0, 4, 1),
        ]
        sg = tk.Frame(sizing_card, bg=self.card)
        sg.pack(fill="x", pady=(10, 0))
        for r, (label, key, lo, hi, step) in enumerate(slider_rows):
            tk.Label(sg, text=label, bg=self.card, fg=self.text,
                     font=("Sans", 10)).grid(row=r, column=0, sticky="w", pady=4, padx=(0, 16))
            tk.Scale(
                sg, from_=lo, to=hi, resolution=step, orient="horizontal",
                variable=self.vars[key],
                bg=self.card, fg=self.text, troughcolor=self.card_alt,
                activebackground=self.accent,
                highlightthickness=0, sliderrelief="flat",
                length=280,
            ).grid(row=r, column=1, sticky="ew", pady=2)
        sg.columnconfigure(1, weight=1)

        btns = tk.Frame(sizing_card, bg=self.card)
        btns.pack(anchor="w", pady=(12, 0))
        ttk.Button(btns, text="Save and restart bar", style="Accent.TButton",
                   command=self.save_and_restart_bar).pack(side="left")
        ttk.Button(btns, text="Restart bar only", style="Ghost.TButton",
                   command=self.restart_bar).pack(side="left", padx=8)

        scroll.bind_children(inner)

    # ── Setup tab ─────────────────────────────────────────────────────────────

    def _setup_tab(self, nb: ttk.Notebook) -> None:
        frame = ttk.Frame(nb, style="Panel.TFrame", padding=20)
        nb.add(frame, text="Setup")

        apps_card = self._card(frame)
        self._card_title(apps_card, "Default apps", "Apps launched by shortcuts and helper actions.")
        form = tk.Frame(apps_card, bg=self.card)
        form.pack(fill="x", pady=(14, 0))
        fields = [
            ("Terminal",     "DOTFILES_TERMINAL"),
            ("File manager", "DOTFILES_FILE_MANAGER"),
            ("App launcher", "DOTFILES_APP_LAUNCHER"),
            ("Editor",       "DOTFILES_EDITOR"),
            ("Browser",      "DOTFILES_BROWSER"),
        ]
        for r, (label, key) in enumerate(fields):
            tk.Label(form, text=label, bg=self.card, fg=self.text,
                     font=("Sans", 10)).grid(row=r, column=0, sticky="w", pady=7, padx=(0, 16))
            ttk.Entry(form, textvariable=self.vars[key], width=42).grid(
                row=r, column=1, sticky="ew", pady=7)
        form.columnconfigure(1, weight=1)

        actions_card = self._card(frame)
        self._card_title(actions_card, "Quick actions")
        btns = tk.Frame(actions_card, bg=self.card)
        btns.pack(anchor="w", pady=(12, 0))
        ttk.Button(btns, text="Open dotfiles", style="Ghost.TButton",
                   command=lambda: run_quiet(["xdg-open", str(ROOT)])).pack(side="left")
        ttk.Button(btns, text="Edit settings", style="Ghost.TButton",
                   command=lambda: run_quiet([self.vars["DOTFILES_EDITOR"].get(),
                                              str(ROOT / "config/dotfiles/settings.conf")])).pack(side="left", padx=8)
        ttk.Button(btns, text="Show status", style="Ghost.TButton",
                   command=lambda: run_quiet(["kitty", "-e", "dotctl", "status"])).pack(side="left", padx=8)
        ttk.Button(btns, text="Reload Hyprland", style="Accent.TButton",
                   command=lambda: run_quiet(["hyprctl", "reload"])).pack(side="left", padx=8)

    # ── Shortcut tree helpers ────────────────────────────────────────────────

    def friendly_kind(self, kind: str) -> str:
        return "App / script" if kind == "app" else "Desktop action"

    def refresh_shortcut_tree(self) -> None:
        if self.shortcut_tree is None:
            return
        self.shortcut_tree.delete(*self.shortcut_tree.get_children())
        for i, sc in enumerate(self.shortcuts):
            self.shortcut_tree.insert(
                "", "end", iid=str(i),
                text=sc.get("name", ""),
                values=(sc.get("key", ""), self.friendly_kind(sc.get("kind", "app")), sc.get("value", "")),
            )

    def selected_shortcut_index(self) -> int | None:
        if self.shortcut_tree is None:
            return None
        sel = self.shortcut_tree.selection()
        if not sel:
            return None
        try:
            return int(sel[0])
        except ValueError:
            return None

    def shortcut_dialog(self, title: str, initial: dict | None = None) -> dict | None:
        initial = initial or {"name": "New shortcut", "key": "SHIFT, N", "kind": "app", "value": "kitty"}
        dialog = tk.Toplevel(self)
        dialog.title(title)
        dialog.configure(bg=self.bg)
        dialog.transient(self)
        dialog.grab_set()
        dialog.resizable(False, False)

        name_var  = tk.StringVar(value=initial.get("name", ""))
        key_var   = tk.StringVar(value=initial.get("key", ""))
        kind_var  = tk.StringVar(value=self.friendly_kind(initial.get("kind", "app")))
        value_var = tk.StringVar(value=initial.get("value", ""))
        result: dict | None = None

        outer = tk.Frame(dialog, bg=self.panel, padx=20, pady=20)
        outer.pack(fill="both", expand=True)
        card = tk.Frame(outer, bg=self.card, padx=16, pady=16)
        card.pack(fill="both", expand=True)

        tk.Label(card, text=title, bg=self.card, fg=self.text,
                 font=("Sans", 13, "bold")).grid(row=0, column=0, columnspan=2, sticky="w", pady=(0, 14))

        fields_d = [("Name", name_var), ("Key", key_var), ("What should happen", value_var)]
        for r, (lbl, var) in enumerate(fields_d, start=1):
            tk.Label(card, text=lbl, bg=self.card, fg=self.text, font=("Sans", 10)).grid(
                row=r, column=0, sticky="w", pady=7, padx=(0, 14))
            ttk.Entry(card, textvariable=var, width=42).grid(row=r, column=1, sticky="ew", pady=7)

        tk.Label(card, text="Action type", bg=self.card, fg=self.text,
                 font=("Sans", 10)).grid(row=4, column=0, sticky="w", pady=7, padx=(0, 14))
        ttk.Combobox(card, textvariable=kind_var,
                     values=["App / script", "Desktop action"],
                     state="readonly", width=22).grid(row=4, column=1, sticky="w", pady=7)

        tk.Label(card, text="Key examples: Return · D · SHIFT, S · CTRL, ALT, T",
                 bg=self.card, fg=self.muted, font=("Sans", 9)).grid(
            row=5, column=0, columnspan=2, sticky="w", pady=(6, 14))

        btn_row = tk.Frame(card, bg=self.card)
        btn_row.grid(row=6, column=0, columnspan=2, sticky="e")
        card.columnconfigure(1, weight=1)

        def save() -> None:
            nonlocal result
            n, k, v = name_var.get().strip(), key_var.get().strip(), value_var.get().strip()
            if not n or not k or not v:
                messagebox.showwarning("Shortcut", "Name, key, and action are all required.", parent=dialog)
                return
            kind = "app" if kind_var.get() == "App / script" else "desktop"
            result = {"name": n, "key": k, "kind": kind, "value": v}
            dialog.destroy()

        ttk.Button(btn_row, text="Cancel", style="Ghost.TButton",  command=dialog.destroy).pack(side="right", padx=(8, 0))
        ttk.Button(btn_row, text="Save",   style="Accent.TButton", command=save).pack(side="right")
        dialog.bind("<Return>", lambda _: save())
        dialog.wait_window()
        return result

    def add_shortcut(self) -> None:
        sc = self.shortcut_dialog("Add shortcut")
        if sc:
            self.shortcuts.append(sc)
            self.refresh_shortcut_tree()

    def edit_shortcut(self) -> None:
        idx = self.selected_shortcut_index()
        if idx is None or idx >= len(self.shortcuts):
            messagebox.showinfo("Shortcuts", "Select a shortcut first.")
            return
        updated = self.shortcut_dialog("Edit shortcut", self.shortcuts[idx])
        if updated:
            self.shortcuts[idx] = updated
            self.refresh_shortcut_tree()

    def remove_shortcut(self) -> None:
        idx = self.selected_shortcut_index()
        if idx is None or idx >= len(self.shortcuts):
            messagebox.showinfo("Shortcuts", "Select a shortcut first.")
            return
        if messagebox.askyesno("Remove", f"Remove '{self.shortcuts[idx].get('name', 'this shortcut')}'?"):
            del self.shortcuts[idx]
            self.refresh_shortcut_tree()

    def reset_shortcuts(self) -> None:
        if messagebox.askyesno("Restore defaults", "Replace all shortcuts with defaults?"):
            self.shortcuts = default_shortcuts()
            self.refresh_shortcut_tree()

    # ── Wallpaper / color helpers ─────────────────────────────────────────────

    def choose_wallpaper(self) -> None:
        path = filedialog.askopenfilename(
            title="Choose wallpaper",
            filetypes=[("Images", "*.png *.jpg *.jpeg *.webp"), ("All files", "*")],
        )
        if path:
            self.vars["DOTFILES_WALLPAPER"].set(path)

    def choose_color(self) -> None:
        color = colorchooser.askcolor(color=self.vars["DOTFILES_ACCENT"].get(), title="Choose accent color")
        if color and color[1]:
            self.vars["DOTFILES_ACCENT"].set(color[1])

    def save_startup_choice(self) -> None:
        DOTFILES_DIR.mkdir(parents=True, exist_ok=True)
        if self.no_show_var.get():
            DISABLED_FILE.write_text("", encoding="utf-8")
        elif DISABLED_FILE.exists():
            DISABLED_FILE.unlink()

    def current_values(self) -> dict[str, str]:
        return {key: var.get() for key, var in self.vars.items()}

    def current_hypr_values(self) -> dict[str, str]:
        return {path: var.get() for path, var in self.hypr_vars.items()}

    def save_all(self) -> None:
        values = self.current_values()
        hypr_values = self.current_hypr_values()
        write_local_conf(values)
        save_shortcuts(self.shortcuts)
        save_hypr_values(hypr_values)
        write_colors(values["DOTFILES_ACCENT"])
        write_keybinds(values, self.shortcuts)
        write_hyprland_settings(self.hypr_schema, hypr_values)
        write_quickshell_bar(values)
        self.save_startup_choice()
        self.apply_wallpaper(show_errors=False)
        messagebox.showinfo("Saved", "Settings saved. Press Super + Shift + R or log back in to apply.")

    def save_and_restart_bar(self) -> None:
        values = self.current_values()
        write_local_conf(values)
        write_quickshell_bar(values)
        self.restart_bar()
        messagebox.showinfo("QML bar", "Bar settings saved and restarted.")

    def restart_bar(self) -> None:
        subprocess.run(["pkill", "-x", "quickshell"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        run_quiet(["quickshell", "-c", "splinterbar"])

    def apply_wallpaper(self, show_errors: bool = True) -> None:
        wallpaper = self.vars["DOTFILES_WALLPAPER"].get()
        try:
            subprocess.run(["dotfiles-wallpaper", "set", wallpaper], check=True)
        except (OSError, subprocess.CalledProcessError) as exc:
            if show_errors:
                messagebox.showwarning("Wallpaper", f"Could not apply wallpaper: {exc}")


def main() -> int:
    force = "--force" in sys.argv
    if not force and DISABLED_FILE.exists():
        return 0
    if not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY"):
        return 0
    app = DotfilesCenter(force)
    app.mainloop()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
