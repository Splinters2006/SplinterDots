                  font.pixelSize: 11
                }

                MouseArea {
                  anchors.fill: parent
                  onClicked: switchWorkspace.running = true
                  hoverEnabled: true
                  onEntered: parent.opacity = 1.0
                  onExited: parent.opacity = (index + 1) === root.activeWorkspace ? 1.0 : 0.7
                }

                Process {
                  id: switchWorkspace
                  command: ["hyprctl", "dispatch", "workspace", String(index + 1)]
