{
  "layer": "top",
  "position": "top",
  "height": 34,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "battery", "tray"],
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}"
  },
  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "MUTED"
  },
  "network": {
    "format-wifi": "NET {essid}",
    "format-ethernet": "NET wired",
    "format-disconnected": "NET off"
  },
  "battery": {
    "format": "BAT {capacity}%"
  }
}
