#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "$0")"
ROOT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
APP_DIR="$ROOT_DIR/tools/dotfiles-center-rs"
BIN="$APP_DIR/target/release/dotfiles-center-rs"

if ! command -v cargo >/dev/null 2>&1; then
  echo "Rust is needed for Dotfiles Center."
  echo "Install it with: sudo pacman -S rust"
  exit 1
fi

if [ ! -x "$BIN" ] || [ "$APP_DIR/src/main.rs" -nt "$BIN" ] || [ "$APP_DIR/Cargo.toml" -nt "$BIN" ]; then
  echo "Building Rust Dotfiles Center..."
  (cd "$APP_DIR" && cargo build --release)
fi

SPLINTERDOTS_ROOT="$ROOT_DIR" exec "$BIN" "$@"
