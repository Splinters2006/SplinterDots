]


def shell_quote(value: str) -> str:
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def load_shell_values(path: Path, defaults: dict[str, str]) -> dict[str, str]:
    values = defaults.copy()
    if not path.exists():
        return values

    pattern = re.compile(r"^([A-Za-z_][A-Za-z0-9_]*)=(.*)$")
    for line in path.read_text(encoding="utf-8").splitlines():
        match = pattern.match(line.strip())
        if not match:
            continue
        key, raw = match.groups()
        raw = raw.strip()
        if len(raw) >= 2 and raw[0] == raw[-1] == '"':
            raw = raw[1:-1].replace('\\"', '"').replace("\\\\", "\\")
        values[key] = raw
    return values


def read_local_conf() -> dict[str, str]:
    values = DEFAULTS.copy()
    repo_settings = ROOT / "config" / "dotfiles" / "settings.conf"
    values.update(load_shell_values(repo_settings, values))
    values.update(load_shell_values(LOCAL_CONF, values))
    return values


def write_local_conf(values: dict[str, str]) -> None:
    DOTFILES_DIR.mkdir(parents=True, exist_ok=True)
    lines = [
        "# Machine-local dotfiles settings written by Dotfiles Center.",
        "# It is safe to edit this file manually too.",
    ]
    for key in DEFAULTS:
        lines.append(f"{key}={shell_quote(values.get(key, DEFAULTS[key]))}")
    LOCAL_CONF.write_text("\n".join(lines) + "\n", encoding="utf-8")


def default_shortcuts() -> list[dict]:
    return [shortcut.copy() for shortcut in DEFAULT_SHORTCUTS]


def normalize_shortcut(item: dict) -> dict | None:
    name = str(item.get("name", "")).strip()
    key = str(item.get("key", "")).strip()
    value = str(item.get("value", "")).strip()
    kind = str(item.get("kind", item.get("type", "app"))).strip()
    if kind == "command":
        kind = "app"
    if kind == "dispatcher":
        kind = "desktop"
    if kind not in {"app", "desktop"}:
        kind = "app"
    if not name or not key or not value:
        return None
    return {"name": name, "key": key, "kind": kind, "value": value}


def load_shortcuts() -> list[dict]:
    if not KEYBINDS_JSON.exists():
        return default_shortcuts()
    try:
        raw = json.loads(KEYBINDS_JSON.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return default_shortcuts()
    if not isinstance(raw, list):
        return default_shortcuts()

    shortcuts = []
    for item in raw:
        if isinstance(item, dict):
            normalized = normalize_shortcut(item)
            if normalized:
                shortcuts.append(normalized)
    return shortcuts or default_shortcuts()


def save_shortcuts(shortcuts: list[dict]) -> None:
    DOTFILES_DIR.mkdir(parents=True, exist_ok=True)
    KEYBINDS_JSON.write_text(json.dumps(shortcuts, indent=2) + "\n", encoding="utf-8")


def load_hypr_schema() -> list[dict]:
    try:
        data = json.loads(HYPR_SCHEMA_FILE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        messagebox.showerror("Hyprland settings", f"Could not read {HYPR_SCHEMA_FILE}:\n{exc}")
        return []
    options = data.get("options", [])
    return [option for option in options if isinstance(option, dict) and option.get("path")]


def default_hypr_values(schema: list[dict]) -> dict[str, str]:
    return {option["path"]: str(option.get("default", "")) for option in schema}


def load_hypr_values(schema: list[dict]) -> dict[str, str]:
    values = default_hypr_values(schema)
    if not HYPR_VALUES_JSON.exists():
        return values
    try:
        raw = json.loads(HYPR_VALUES_JSON.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return values
    if isinstance(raw, dict):
        for key, value in raw.items():
            values[str(key)] = str(value)
    return values


def save_hypr_values(values: dict[str, str]) -> None:
    DOTFILES_DIR.mkdir(parents=True, exist_ok=True)
    HYPR_VALUES_JSON.write_text(json.dumps(values, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def bool_for_hypr(value: str) -> str:
    return "true" if value in {"1", "true", "True", "yes", "on"} else "false"


def clean_hypr_value(option: dict, value: str) -> str:
    value = str(value).strip()
    kind = option.get("type", "text")
    if kind == "bool":
        return bool_for_hypr(value)
    if kind == "int":
        try:
            number = int(float(value))
        except ValueError:
            number = int(float(option.get("default", "0") or 0))
        if "min" in option:
            number = max(int(option["min"]), number)
        if "max" in option:
            number = min(int(option["max"]), number)
        return str(number)
    if kind == "float":
        try:
            number = float(value)
        except ValueError:
            number = float(option.get("default", "0") or 0)
        if "min" in option:
            number = max(float(option["min"]), number)
        if "max" in option:
            number = min(float(option["max"]), number)
        return f"{number:g}"
    if kind == "choice":
        choices = [str(choice) for choice in option.get("choices", [])]
        return value if value in choices else str(option.get("default", ""))
    return value


def nested_set(tree: dict, parts: list[str], value: str) -> None:
    current = tree
    for part in parts[:-1]:
        current = current.setdefault(part, {})
    current[parts[-1]] = value


def render_hypr_tree(tree: dict, indent: int = 0) -> list[str]:
    lines: list[str] = []
    for key, value in tree.items():
        prefix = " " * indent
        if isinstance(value, dict):
            lines.append(f"{prefix}{key} {{")
            lines.extend(render_hypr_tree(value, indent + 4))
            lines.append(f"{prefix}}}")
        else:
            lines.append(f"{prefix}{key} = {value}")
    return lines


def write_hyprland_settings(schema: list[dict], values: dict[str, str]) -> None:
    HYPR_DIR.mkdir(parents=True, exist_ok=True)
    option_by_path = {option["path"]: option for option in schema}
    tree: dict = {}

    for path, option in option_by_path.items():
        value = clean_hypr_value(option, values.get(path, option.get("default", "")))
        if value == "":
            continue
        nested_set(tree, path.split(":"), value)

    lines = [
        "# Generated by Dotfiles Center. Edit with: dotctl center",
        "# This file is safe to regenerate.",
        "",
    ]
    lines.extend(render_hypr_tree(tree))
    HYPR_GENERATED.write_text("\n".join(lines) + "\n", encoding="utf-8")


def hex_to_hypr_rgba(hex_color: str) -> str:
    clean = hex_color.strip().lstrip("#")
    if len(clean) != 6 or not re.fullmatch(r"[0-9a-fA-F]{6}", clean):
        clean = "89b4fa"
    return f"rgba({clean.lower()}ff)"


def write_colors(accent: str) -> None:
    HYPR_DIR.mkdir(parents=True, exist_ok=True)
    HYPR_COLORS.write_text(
        f"$accent = {hex_to_hypr_rgba(accent)}\n$inactive = rgba(45475aff)\n",
        encoding="utf-8",
    )


def hypr_key_parts(key: str) -> tuple[str, str]:
    key = key.strip()
    if key.upper().startswith("SHIFT,"):
        return "$mainMod SHIFT", key.split(",", 1)[1].strip()
    return "$mainMod", key


def write_keybinds(values: dict[str, str], shortcuts: list[dict]) -> None:
    HYPR_DIR.mkdir(parents=True, exist_ok=True)
    lines = [
        "$mainMod = SUPER",
        f"$terminal = {values.get('DOTFILES_TERMINAL', DEFAULTS['DOTFILES_TERMINAL'])}",
        f"$fileManager = {values.get('DOTFILES_FILE_MANAGER', DEFAULTS['DOTFILES_FILE_MANAGER'])}",
        f"$menu = {values.get('DOTFILES_APP_LAUNCHER', DEFAULTS['DOTFILES_APP_LAUNCHER'])}",
        f"$browser = {values.get('DOTFILES_BROWSER', DEFAULTS['DOTFILES_BROWSER'])}",
        "",
        "# Hold Super + left mouse button to drag windows.",
        "bindm = $mainMod, mouse:272, movewindow",
        "# Hold Super + right mouse button to resize windows.",
        "bindm = $mainMod, mouse:273, resizewindow",
        "",
    ]

    for shortcut in shortcuts:
        clean = normalize_shortcut(shortcut)
        if not clean:
            continue
        modifier, key = hypr_key_parts(clean["key"])
        if clean["kind"] == "app":
            lines.append(f"bind = {modifier}, {key}, exec, {clean['value']}")
        else:
            lines.append(f"bind = {modifier}, {key}, {clean['value']}")

    lines.extend(
        [
            "",
            "bind = $mainMod, left, movefocus, l",
            "bind = $mainMod, right, movefocus, r",
            "bind = $mainMod, up, movefocus, u",
            "bind = $mainMod, down, movefocus, d",
            "",
            "bind = $mainMod SHIFT, left, movewindow, l",
            "bind = $mainMod SHIFT, right, movewindow, r",
            "bind = $mainMod SHIFT, up, movewindow, u",
            "bind = $mainMod SHIFT, down, movewindow, d",
            "",
        ]
    )
    for i in range(1, 10):
        lines.append(f"bind = $mainMod, {i}, workspace, {i}")
    lines.append("")
    for i in range(1, 10):
        lines.append(f"bind = $mainMod SHIFT, {i}, movetoworkspace, {i}")

    HYPR_KEYBINDS.write_text("\n".join(lines) + "\n", encoding="utf-8")


def clamp_int(value: str, default: int, minimum: int, maximum: int) -> int:
    try:
        number = int(float(value))
    except ValueError:
        number = default
    return max(minimum, min(maximum, number))


def clamp_float(value: str, default: float, minimum: float, maximum: float) -> float:
    try:
        number = float(value)
    except ValueError:
        number = default
    return max(minimum, min(maximum, number))


def qml_string(value: str) -> str:
    return json.dumps(value)


def write_quickshell_bar(values: dict[str, str]) -> None:
    QUICKSHELL_DIR.mkdir(parents=True, exist_ok=True)

    position = values.get("DOTFILES_BAR_POSITION", "top")
    top = "true" if position == "top" else "false"
    bottom = "true" if position == "bottom" else "false"
    height = clamp_int(values.get("DOTFILES_BAR_HEIGHT", "34"), 34, 24, 72)
    radius = clamp_int(values.get("DOTFILES_BAR_RADIUS", "8"), 8, 0, 28)
    opacity = clamp_float(values.get("DOTFILES_BAR_OPACITY", "0.92"), 0.92, 0.2, 1.0)
    accent = values.get("DOTFILES_ACCENT", "#89b4fa")
    bg_alpha = int(opacity * 255)
    bg_color = f"#%02x1e1e2e" % bg_alpha

    qml = f"""// SplinterDots Quickshell bar.
// Generated by Dotfiles Center. Edit the Bar tab instead of hand-editing this file.

import Quickshell
import Quickshell.Io
import QtQuick
import QtQuick.Layouts

Variants {{
  model: Quickshell.screens

  delegate: Component {{
    PanelWindow {{
      required property var modelData
      screen: modelData

      anchors {{
        top: {top}
        bottom: {bottom}
        left: true
        right: true
      }}

      margins {{
        top: {8 if position == "top" else 0}
        bottom: {8 if position == "bottom" else 0}
        left: 10
        right: 10
      }}

      implicitHeight: {height}
      color: "transparent"

      Rectangle {{
        anchors.fill: parent
        radius: {radius}
        color: "{bg_color}"
        border.width: 1
        border.color: "#313244"

        RowLayout {{
          anchors.fill: parent
          anchors.leftMargin: 14
          anchors.rightMargin: 14
          spacing: 14

          Row {{
            Layout.alignment: Qt.AlignVCenter
            spacing: 8

            Repeater {{
              model: 9
              Rectangle {{
                width: 24
                height: 24
                radius: 7
                color: index === 0 ? {qml_string(accent)} : "#313244"

                Text {{
                  anchors.centerIn: parent
                  text: index + 1
                  color: index === 0 ? "#11111b" : "#cdd6f4"
                  font.bold: true
                  font.pixelSize: 12
                }}

                MouseArea {{
                  anchors.fill: parent
                  onClicked: switchWorkspace.running = true
                }}

                Process {{
                  id: switchWorkspace
                  command: ["hyprctl", "dispatch", "workspace", String(index + 1)]
                }}
              }}
            }}
          }}

          Item {{ Layout.fillWidth: true }}

          Text {{
            id: clock
            Layout.alignment: Qt.AlignCenter
            color: "#cdd6f4"
            font.bold: true
            font.pixelSize: 13
            text: "Loading..."

            Process {{
              id: dateProc
              command: ["date", "+%a %d %b  %H:%M"]
              running: true
              stdout: StdioCollector {{
                onStreamFinished: clock.text = this.text.trim()
              }}
            }}

            Timer {{
              interval: 1000
              running: true
              repeat: true
              onTriggered: dateProc.running = true
            }}
          }}

          Item {{ Layout.fillWidth: true }}

          Text {{
            id: status
            Layout.alignment: Qt.AlignRight | Qt.AlignVCenter
            color: "#bac2de"
            font.pixelSize: 12
            text: "VOL --  NET --"

            Process {{
              id: statusProc
              command: ["sh", "-c", "printf 'VOL '; wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{{print int($2*100)\"%\"}}'; printf 'NET '; nmcli -t -f GENERAL.STATE device show 2>/dev/null | grep -q ':100' && echo on || echo off"]
              running: true
              stdout: StdioCollector {{
                onStreamFinished: status.text = this.text.replace(/\\n/g, "  ").trim()
              }}
            }}

            Timer {{
              interval: 3000
              running: true
              repeat: true
              onTriggered: statusProc.running = true
            }}
          }}
        }}
      }}
    }}
  }}
}}
"""
    QUICKSHELL_FILE.write_text(qml, encoding="utf-8")


def run_quiet(command: list[str]) -> None:
    try:
        subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


class ScrollFrame(ttk.Frame):
    def __init__(self, parent: tk.Widget, **kwargs) -> None:
        super().__init__(parent, **kwargs)
        self.canvas = tk.Canvas(self, highlightthickness=0, bg="#172033")
        self.scrollbar = ttk.Scrollbar(self, orient="vertical", command=self.canvas.yview)
        self.inner = ttk.Frame(self.canvas, style="Panel.TFrame")
        self.window_id = self.canvas.create_window((0, 0), window=self.inner, anchor="nw")

        self.canvas.configure(yscrollcommand=self.scrollbar.set)
        self.canvas.pack(side="left", fill="both", expand=True)
        self.scrollbar.pack(side="right", fill="y")

        self.inner.bind("<Configure>", lambda _event: self.canvas.configure(scrollregion=self.canvas.bbox("all")))
        self.canvas.bind("<Configure>", lambda event: self.canvas.itemconfigure(self.window_id, width=event.width))
        self.canvas.bind_all("<MouseWheel>", self._wheel)

    def _wheel(self, event) -> None:
        if self.winfo_ismapped():
            self.canvas.yview_scroll(int(-1 * (event.delta / 120)), "units")


class DotfilesCenter(tk.Tk):
    bg = "#111827"
    panel = "#172033"
    card = "#1f2937"
    card_soft = "#243044"
    text = "#e5e7eb"
    muted = "#9ca3af"
    accent = "#89b4fa"
    accent_dark = "#2563eb"

    def __init__(self, force: bool) -> None:
        super().__init__()
        self.force = force
        self.values = read_local_conf()
        self.hypr_schema = load_hypr_schema()
        self.hypr_values = load_hypr_values(self.hypr_schema)
        self.hypr_vars: dict[str, tk.StringVar] = {}
        self.title("Dotfiles Center")
        self.geometry("980x720")
        self.minsize(880, 620)
        self.configure(bg=self.bg)

        self.vars = {key: tk.StringVar(value=value) for key, value in self.values.items()}
        self.shortcuts = load_shortcuts()
        self.shortcut_tree: ttk.Treeview | None = None
        self.no_show_var = tk.BooleanVar(value=DISABLED_FILE.exists())

        self._setup_style()
        self._build()

    def _setup_style(self) -> None:
        style = ttk.Style(self)
        try:
            style.theme_use("clam")
        except tk.TclError:
            pass

        def configure(name: str, **options: object) -> None:
            try:
                style.configure(name, **options)
            except tk.TclError:
                pass

        def map_style(name: str, **options: object) -> None:
            try:
                style.map(name, **options)
            except tk.TclError:
                pass

        configure(".", font=("Sans", 10), background=self.bg, foreground=self.text)
        configure("Root.TFrame", background=self.bg)
        configure("Panel.TFrame", background=self.panel)
        configure("Card.TFrame", background=self.card, relief="flat")
        configure("Soft.TFrame", background=self.card_soft)
        configure("Title.TLabel", background=self.bg, foreground=self.text, font=("Sans", 24, "bold"))
        configure("Subtitle.TLabel", background=self.bg, foreground=self.muted, font=("Sans", 11))
        configure("Heading.TLabel", background=self.card, foreground=self.text, font=("Sans", 14, "bold"))
        configure("Body.TLabel", background=self.card, foreground=self.muted, font=("Sans", 10))
        configure("Muted.TLabel", background=self.bg, foreground=self.muted)
        configure("Card.TLabel", background=self.card, foreground=self.text)
        configure("CardMuted.TLabel", background=self.card, foreground=self.muted)
        configure("Soft.TLabel", background=self.card_soft, foreground=self.text)
        configure("SoftMuted.TLabel", background=self.card_soft, foreground=self.muted)
        configure("Accent.TButton", background=self.accent_dark, foreground="#ffffff", borderwidth=0, padding=(14, 9))
        map_style("Accent.TButton", background=[("active", "#3b82f6"), ("pressed", "#1d4ed8")])
        configure("TButton", padding=(12, 8), borderwidth=0)
        configure("TCheckbutton", background=self.card, foreground=self.text)
        map_style("TCheckbutton", background=[("active", self.card)])
        configure("TNotebook", background=self.bg, borderwidth=0, tabmargins=(0, 8, 0, 0))
        configure("TNotebook.Tab", background=self.panel, foreground=self.muted, padding=(18, 10), borderwidth=0)
        map_style("TNotebook.Tab", background=[("selected", self.card)], foreground=[("selected", self.text), ("active", self.text)])
        configure("TEntry", fieldbackground="#0f172a", foreground=self.text, padding=8)
        configure("TCombobox", fieldbackground="#0f172a", foreground=self.text, padding=8)
        configure("Treeview", background=self.card_soft, fieldbackground=self.card_soft, foreground=self.text, rowheight=30, borderwidth=0)
        configure("Treeview.Heading", background=self.card, foreground=self.muted, padding=(8, 8), borderwidth=0)
        map_style("Treeview", background=[("selected", self.accent_dark)], foreground=[("selected", "#ffffff")])

    def _card(self, parent: tk.Widget, padding: int = 16) -> ttk.Frame:
        card = ttk.Frame(parent, style="Card.TFrame", padding=padding)
        card.pack(fill="x", pady=(0, 14))
        return card

    def _card_title(self, parent: tk.Widget, title: str, body: str | None = None) -> None:
        ttk.Label(parent, text=title, style="Heading.TLabel").pack(anchor="w")
        if body:
            ttk.Label(parent, text=body, style="Body.TLabel", wraplength=820).pack(anchor="w", pady=(5, 0))

    def _build(self) -> None:
        header = ttk.Frame(self, style="Root.TFrame", padding=(26, 24, 26, 8))
        header.pack(fill="x")
        ttk.Label(header, text="Dotfiles Center", style="Title.TLabel").pack(anchor="w")
        ttk.Label(
            header,
            text="Friendly controls for Hyprland, shortcuts, appearance, Quickshell, and setup.",
            style="Subtitle.TLabel",
        ).pack(anchor="w", pady=(6, 0))

        notebook = ttk.Notebook(self)
        notebook.pack(fill="both", expand=True, padx=26, pady=12)

        self._overview_tab(notebook)
        self._hyprland_tab(notebook)
        self._shortcuts_tab(notebook)
        self._appearance_tab(notebook)
        self._bar_tab(notebook)
        self._setup_tab(notebook)

        footer = ttk.Frame(self, style="Root.TFrame", padding=(26, 2, 26, 22))
        footer.pack(fill="x")
        ttk.Checkbutton(
            footer,
            text="Don't show this on startup",
            variable=self.no_show_var,
            command=self.save_startup_choice,
        ).pack(side="left")
        ttk.Button(footer, text="Save changes", style="Accent.TButton", command=self.save_all).pack(side="right")

    def _overview_tab(self, notebook: ttk.Notebook) -> None:
        frame = ttk.Frame(notebook, style="Panel.TFrame", padding=18)
        notebook.add(frame, text="Overview")

        hero = self._card(frame, padding=20)
        self._card_title(
            hero,
            "Your Arch desktop, ready to shape",
            "This setup turns a minimal Arch install into a complete Hyprland desktop with switches, dropdowns, and safe generated files.",
        )

        quick = ttk.Frame(hero, style="Card.TFrame")
        quick.pack(fill="x", pady=(18, 0))
        quick_items = [
            ("Super + D", "Open apps"),
            ("Super + Return", "Terminal"),
            ("Super + Left Mouse", "Drag windows"),
            ("Super + Right Mouse", "Resize windows"),
        ]
        for column, (key, label) in enumerate(quick_items):
            tile = ttk.Frame(quick, style="Soft.TFrame", padding=(14, 10))
            tile.grid(row=0, column=column, sticky="ew", padx=(0 if column == 0 else 8, 0))
            ttk.Label(tile, text=key, background=self.card_soft, foreground=self.text, font=("Sans", 11, "bold")).pack(anchor="w")
            ttk.Label(tile, text=label, background=self.card_soft, foreground=self.muted).pack(anchor="w", pady=(3, 0))
            quick.columnconfigure(column, weight=1)

        details = self._card(frame)
        self._card_title(details, "What this setup manages")
        text = tk.Text(details, wrap="word", height=13, relief="flat", bg=self.card, fg=self.text, insertbackground=self.text, padx=0, pady=10, borderwidth=0, highlightthickness=0, font=("Sans", 10))
        text.pack(fill="both", expand=True)
        text.insert(
            "1.0",
            "- Hyprland window manager\n"
            "- Quickshell QML bar\n"
            "- Wofi app launcher\n"
            "- Mako notifications\n"
            "- Kitty terminal\n"
            "- Thunar file manager\n"
            "- Zen Browser\n"
            "- Screenshot, clipboard, wallpaper, audio, network, portal, Bluetooth, and login tools\n\n"
            "Useful terminal commands:\n"
            "- dotctl all: update, install, configure, and apply\n"
            "- dotctl status: show linked files\n"
            "- dotctl doctor: debug Hyprland and graphics issues",
        )
        text.configure(state="disabled")

    def _hyprland_tab(self, notebook: ttk.Notebook) -> None:
        outer = ttk.Frame(notebook, style="Panel.TFrame", padding=18)
        notebook.add(outer, text="Hyprland")

        intro = self._card(outer)
        self._card_title(
            intro,
            "Hyprland settings",
            "Switches are used for on/off settings. Dropdowns are used when there are multiple choices. Text boxes are used only when Hyprland needs a number, color, path, or custom value.",
        )

        scroll = ScrollFrame(outer, style="Panel.TFrame")
        scroll.pack(fill="both", expand=True)

        grouped: dict[str, list[dict]] = {}
        for option in self.hypr_schema:
            grouped.setdefault(str(option.get("section", "Other")), []).append(option)

        for section, options in grouped.items():
            section_card = ttk.Frame(scroll.inner, style="Card.TFrame", padding=16)
            section_card.pack(fill="x", padx=0, pady=(0, 14))
            ttk.Label(section_card, text=section, style="Heading.TLabel").grid(row=0, column=0, columnspan=3, sticky="w", pady=(0, 10))

            for row, option in enumerate(options, start=1):
                path = option["path"]
                label = str(option.get("label", path.replace(":", " / ").replace("_", " ").title()))
                value = self.hypr_values.get(path, str(option.get("default", "")))
                var = tk.StringVar(value=value)
                self.hypr_vars[path] = var

                ttk.Label(section_card, text=label, style="Card.TLabel").grid(row=row, column=0, sticky="w", padx=(0, 12), pady=5)
                kind = option.get("type", "text")
                if kind == "bool":
                    bool_var = tk.BooleanVar(value=value in {"1", "true", "True", "yes", "on"})
                    self.hypr_vars[path] = var

                    def sync_bool(target: tk.StringVar = var, source: tk.BooleanVar = bool_var) -> None:
                        target.set("true" if source.get() else "false")

                    check = ttk.Checkbutton(section_card, variable=bool_var, command=sync_bool)
                    check.grid(row=row, column=1, sticky="w", pady=5)
                    sync_bool()
                elif kind == "choice":
                    choices = [str(choice) for choice in option.get("choices", [])]
                    ttk.Combobox(section_card, textvariable=var, values=choices, state="readonly", width=24).grid(row=row, column=1, sticky="w", pady=5)
                else:
                    ttk.Entry(section_card, textvariable=var, width=26).grid(row=row, column=1, sticky="w", pady=5)

                ttk.Label(section_card, text=path, style="CardMuted.TLabel").grid(row=row, column=2, sticky="w", padx=(12, 0), pady=5)

            section_card.columnconfigure(2, weight=1)

    def _shortcuts_tab(self, notebook: ttk.Notebook) -> None:
        frame = ttk.Frame(notebook, style="Panel.TFrame", padding=18)
        notebook.add(frame, text="Shortcuts")

        intro = self._card(frame)
        self._card_title(
            intro,
            "Shortcuts",
            "Main key: Super / Windows key. Add shortcuts using plain names. Save, then press Super + Shift + R to reload Hyprland.",
        )

        table_card = self._card(frame)
        self.shortcut_tree = ttk.Treeview(table_card, columns=("key", "kind", "value"), show="tree headings", height=13)
        self.shortcut_tree.heading("#0", text="Name")
        self.shortcut_tree.heading("key", text="Key")
        self.shortcut_tree.heading("kind", text="Action type")
        self.shortcut_tree.heading("value", text="What it does")
        self.shortcut_tree.column("#0", width=180, stretch=True)
        self.shortcut_tree.column("key", width=110, stretch=False)
        self.shortcut_tree.column("kind", width=150, stretch=False)
        self.shortcut_tree.column("value", width=390, stretch=True)
        self.shortcut_tree.pack(fill="both", expand=True)
        self.shortcut_tree.bind("<Double-1>", lambda _event: self.edit_shortcut())

        buttons = ttk.Frame(table_card, style="Card.TFrame")
        buttons.pack(fill="x", pady=(12, 0))
        ttk.Button(buttons, text="Add shortcut", style="Accent.TButton", command=self.add_shortcut).pack(side="left")
        ttk.Button(buttons, text="Edit selected", command=self.edit_shortcut).pack(side="left", padx=8)
        ttk.Button(buttons, text="Remove selected", command=self.remove_shortcut).pack(side="left", padx=8)
        ttk.Button(buttons, text="Restore defaults", command=self.reset_shortcuts).pack(side="left", padx=8)

        hint = self._card(frame)
        self._card_title(
            hint,
            "Mouse window controls",
            "Already included: hold Super + left mouse button to drag windows, and hold Super + right mouse button to resize windows.",
        )
        self.refresh_shortcut_tree()

