    def _bar_tab(self, notebook: ttk.Notebook) -> None:
        frame = ttk.Frame(notebook, style="Panel.TFrame", padding=18)
        notebook.add(frame, text="QML Bar")

        card = self._card(frame)
        self._card_title(card, "Quickshell QML bar", "This replaces Waybar. The bar is generated as QML and started by Hyprland.")

        grid = ttk.Frame(card, style="Card.TFrame")
        grid.pack(fill="x", pady=(12, 0))

        rows = [
            ("Position", "DOTFILES_BAR_POSITION", ["top", "bottom"]),
            ("Workspaces", "DOTFILES_BAR_WORKSPACES", ["left"]),
            ("Clock", "DOTFILES_BAR_CLOCK", ["center"]),
            ("Status", "DOTFILES_BAR_STATUS", ["right"]),
        ]
        for row, (label, key, choices) in enumerate(rows):
            ttk.Label(grid, text=label, style="Card.TLabel").grid(row=row, column=0, sticky="w", pady=8)
            ttk.Combobox(grid, textvariable=self.vars[key], values=choices, state="readonly", width=16).grid(row=row, column=1, sticky="w", padx=8, pady=8)

        sliders = ttk.Frame(card, style="Card.TFrame")
        sliders.pack(fill="x", pady=(14, 0))
        slider_rows = [
            ("Height", "DOTFILES_BAR_HEIGHT", 24, 72, 1),
            ("Rounding", "DOTFILES_BAR_RADIUS", 0, 28, 1),
            ("Opacity", "DOTFILES_BAR_OPACITY", 0.2, 1.0, 0.05),
        ]
        for row, (label, key, start, end, step) in enumerate(slider_rows):
            ttk.Label(sliders, text=label, style="Card.TLabel").grid(row=row, column=0, sticky="w", pady=8)
            tk.Scale(
                sliders,
                from_=start,
                to=end,
                resolution=step,
                orient="horizontal",
                variable=self.vars[key],
                bg=self.card,
                fg=self.text,
                troughcolor=self.card_soft,
                highlightthickness=0,
                length=320,
            ).grid(row=row, column=1, sticky="ew", padx=8, pady=4)
        sliders.columnconfigure(1, weight=1)

        buttons = ttk.Frame(card, style="Card.TFrame")
        buttons.pack(anchor="w", pady=(14, 0))
        ttk.Button(buttons, text="Save and restart bar", style="Accent.TButton", command=self.save_and_restart_bar).pack(side="left")
        ttk.Button(buttons, text="Restart bar only", command=self.restart_bar).pack(side="left", padx=8)

    def _setup_tab(self, notebook: ttk.Notebook) -> None:
        frame = ttk.Frame(notebook, style="Panel.TFrame", padding=18)
        notebook.add(frame, text="Setup")

        card = self._card(frame)
        self._card_title(card, "Default apps", "Choose the apps launched by shortcuts and helper actions.")
        form = ttk.Frame(card, style="Card.TFrame")
        form.pack(fill="x", pady=(14, 0))

        fields = [
            ("Terminal", "DOTFILES_TERMINAL"),
            ("File manager", "DOTFILES_FILE_MANAGER"),
            ("App launcher", "DOTFILES_APP_LAUNCHER"),
            ("Editor", "DOTFILES_EDITOR"),
            ("Browser", "DOTFILES_BROWSER"),
        ]
        for row, (label, key) in enumerate(fields):
            ttk.Label(form, text=label, style="Card.TLabel").grid(row=row, column=0, sticky="w", pady=8)
            ttk.Entry(form, textvariable=self.vars[key], width=42).grid(row=row, column=1, sticky="ew", padx=8, pady=8)
        form.columnconfigure(1, weight=1)

        actions = self._card(frame)
        self._card_title(actions, "Quick actions")
        buttons = ttk.Frame(actions, style="Card.TFrame")
        buttons.pack(anchor="w", pady=(12, 0))
        ttk.Button(buttons, text="Open dotfiles", command=lambda: run_quiet(["xdg-open", str(ROOT)])).pack(side="left", padx=(0, 8))
        ttk.Button(buttons, text="Edit settings", command=lambda: run_quiet([self.vars["DOTFILES_EDITOR"].get(), str(ROOT / "config/dotfiles/settings.conf")])).pack(side="left", padx=8)
        ttk.Button(buttons, text="Show status", command=lambda: run_quiet(["kitty", "-e", "dotctl", "status"])).pack(side="left", padx=8)
        ttk.Button(buttons, text="Reload Hyprland", style="Accent.TButton", command=lambda: run_quiet(["hyprctl", "reload"])).pack(side="left", padx=8)

    def friendly_kind(self, kind: str) -> str:
        return "Open app/script" if kind == "app" else "Window/Desktop action"

    def refresh_shortcut_tree(self) -> None:
        if self.shortcut_tree is None:
            return
        self.shortcut_tree.delete(*self.shortcut_tree.get_children())
        for index, shortcut in enumerate(self.shortcuts):
            self.shortcut_tree.insert(
                "",
                "end",
                iid=str(index),
                text=shortcut.get("name", ""),
                values=(shortcut.get("key", ""), self.friendly_kind(shortcut.get("kind", "app")), shortcut.get("value", "")),
            )

    def selected_shortcut_index(self) -> int | None:
        if self.shortcut_tree is None:
            return None
        selection = self.shortcut_tree.selection()
        if not selection:
            return None
        try:
            return int(selection[0])
        except ValueError:
            return None

    def shortcut_dialog(self, title: str, initial: dict | None = None) -> dict | None:
        initial = initial or {"name": "New shortcut", "key": "SHIFT, N", "kind": "app", "value": "kitty"}
        dialog = tk.Toplevel(self)
        dialog.title(title)
        dialog.configure(bg=self.bg)
        dialog.transient(self)
        dialog.grab_set()
        dialog.resizable(False, False)

        name_var = tk.StringVar(value=initial.get("name", ""))
        key_var = tk.StringVar(value=initial.get("key", ""))
        kind_var = tk.StringVar(value=self.friendly_kind(initial.get("kind", "app")))
        value_var = tk.StringVar(value=initial.get("value", ""))
        result: dict | None = None

        shell = ttk.Frame(dialog, style="Panel.TFrame", padding=18)
        shell.pack(fill="both", expand=True)
        card = ttk.Frame(shell, style="Card.TFrame", padding=16)
        card.pack(fill="both", expand=True)

        ttk.Label(card, text=title, style="Heading.TLabel").grid(row=0, column=0, columnspan=2, sticky="w", pady=(0, 12))

        fields = [("Name", name_var), ("Key", key_var), ("What should happen", value_var)]
        for row, (label, var) in enumerate(fields, start=1):
            ttk.Label(card, text=label, style="Card.TLabel").grid(row=row, column=0, sticky="w", pady=8)
            ttk.Entry(card, textvariable=var, width=44).grid(row=row, column=1, sticky="ew", padx=8, pady=8)

        ttk.Label(card, text="Action type", style="Card.TLabel").grid(row=4, column=0, sticky="w", pady=8)
        ttk.Combobox(card, textvariable=kind_var, values=["Open app/script", "Window/Desktop action"], state="readonly", width=24).grid(row=4, column=1, sticky="w", padx=8, pady=8)

        ttk.Label(
            card,
            text="Key examples: Return, D, SHIFT, S. Use Open app/script for apps. Use Window/Desktop action only for built-in Hyprland window actions.",
            style="CardMuted.TLabel",
            wraplength=450,
        ).grid(row=5, column=0, columnspan=2, sticky="w", pady=(8, 12))

        buttons = ttk.Frame(card, style="Card.TFrame")
        buttons.grid(row=6, column=0, columnspan=2, sticky="e")

        def save() -> None:
            nonlocal result
            name = name_var.get().strip()
            key = key_var.get().strip()
            value = value_var.get().strip()
            kind = "app" if kind_var.get() == "Open app/script" else "desktop"
            if not name or not key or not value:
                messagebox.showwarning("Shortcut", "Name, key, and action are required.", parent=dialog)
                return
            result = {"name": name, "key": key, "kind": kind, "value": value}
            dialog.destroy()

        ttk.Button(buttons, text="Cancel", command=dialog.destroy).pack(side="right", padx=(8, 0))
        ttk.Button(buttons, text="Save", style="Accent.TButton", command=save).pack(side="right")
        card.columnconfigure(1, weight=1)
        dialog.bind("<Return>", lambda _event: save())
        dialog.wait_window()
        return result

    def add_shortcut(self) -> None:
        shortcut = self.shortcut_dialog("Add shortcut")
        if shortcut is None:
            return
        self.shortcuts.append(shortcut)
        self.refresh_shortcut_tree()

    def edit_shortcut(self) -> None:
        index = self.selected_shortcut_index()
        if index is None or index >= len(self.shortcuts):
            messagebox.showinfo("Shortcuts", "Select a shortcut first.")
            return
        updated = self.shortcut_dialog("Edit shortcut", self.shortcuts[index])
        if updated is None:
            return
        self.shortcuts[index] = updated
        self.refresh_shortcut_tree()

    def remove_shortcut(self) -> None:
        index = self.selected_shortcut_index()
        if index is None or index >= len(self.shortcuts):
            messagebox.showinfo("Shortcuts", "Select a shortcut first.")
            return
        if not messagebox.askyesno("Remove shortcut", f"Remove {self.shortcuts[index].get('name', 'this shortcut')}?"):
            return
        del self.shortcuts[index]
        self.refresh_shortcut_tree()

    def reset_shortcuts(self) -> None:
        if not messagebox.askyesno("Restore defaults", "Replace all shortcuts with the default set?"):
            return
        self.shortcuts = default_shortcuts()
        self.refresh_shortcut_tree()

    def choose_wallpaper(self) -> None:
        path = filedialog.askopenfilename(title="Choose wallpaper", filetypes=[("Images", "*.png *.jpg *.jpeg *.webp"), ("All files", "*")])
        if path:
            self.vars["DOTFILES_WALLPAPER"].set(path)

    def choose_color(self) -> None:
        color = colorchooser.askcolor(color=self.vars["DOTFILES_ACCENT"].get(), title="Choose accent color")
        if color and color[1]:
            self.vars["DOTFILES_ACCENT"].set(color[1])

    def save_startup_choice(self) -> None:
        DOTFILES_DIR.mkdir(parents=True, exist_ok=True)
        if self.no_show_var.get():
            DISABLED_FILE.write_text("", encoding="utf-8")
        elif DISABLED_FILE.exists():
            DISABLED_FILE.unlink()

    def current_values(self) -> dict[str, str]:
        return {key: var.get() for key, var in self.vars.items()}

    def current_hypr_values(self) -> dict[str, str]:
        return {path: var.get() for path, var in self.hypr_vars.items()}

    def save_all(self) -> None:
        values = self.current_values()
        hypr_values = self.current_hypr_values()
        write_local_conf(values)
        save_shortcuts(self.shortcuts)
        save_hypr_values(hypr_values)
        write_colors(values["DOTFILES_ACCENT"])
        write_keybinds(values, self.shortcuts)
        write_hyprland_settings(self.hypr_schema, hypr_values)
        write_quickshell_bar(values)
        self.save_startup_choice()
        self.apply_wallpaper(show_errors=False)
        messagebox.showinfo("Saved", "Settings saved. Press Super + Shift + R or log in again to reload everything.")

    def save_and_restart_bar(self) -> None:
        values = self.current_values()
        write_local_conf(values)
        write_quickshell_bar(values)
        self.restart_bar()
        messagebox.showinfo("QML bar", "Bar settings saved and restarted.")

    def restart_bar(self) -> None:
        subprocess.run(["pkill", "-x", "quickshell"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        run_quiet(["quickshell", "-c", "splinterbar"])

    def apply_wallpaper(self, show_errors: bool = True) -> None:
        wallpaper = self.vars["DOTFILES_WALLPAPER"].get()
        try:
            subprocess.run(["dotfiles-wallpaper", "set", wallpaper], check=True)
        except (OSError, subprocess.CalledProcessError) as exc:
            if show_errors:
                messagebox.showwarning("Wallpaper", f"Could not apply wallpaper yet: {exc}")


def main() -> int:
    force = "--force" in sys.argv
    if not force and DISABLED_FILE.exists():
        return 0
    if not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY"):
        return 0
    app = DotfilesCenter(force)
    app.mainloop()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
