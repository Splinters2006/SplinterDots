    "DOTFILES_BAR_WORKSPACES": "left",
    "DOTFILES_BAR_CLOCK": "center",
    "DOTFILES_BAR_STATUS": "right",
}

DEFAULT_SHORTCUTS = [
    {"name": "Terminal", "key": "Return", "kind": "app", "value": "$terminal"},
    {"name": "File manager", "key": "E", "kind": "app", "value": "$fileManager"},
