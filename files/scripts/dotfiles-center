QUICKSHELL_DIR = CONFIG_HOME / "quickshell" / "splinterbar"
QUICKSHELL_FILE = QUICKSHELL_DIR / "shell.qml"
HYPR_SCHEMA_FILE = ROOT / "config" / "dotfiles" / "hyprland-options.json"


