#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "$0")"
ROOT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
BIN="$ROOT_DIR/target/release/dotfiles-center"
MANIFEST="$ROOT_DIR/Cargo.toml"
MAIN_RS="$ROOT_DIR/tools/dotfiles-center/src/main.rs"
APP_TOML="$ROOT_DIR/tools/dotfiles-center/Cargo.toml"

if ! command -v cargo >/dev/null 2>&1; then
  echo "Cargo is required for Dotfiles Center."
  echo "Install the dotfiles packages with: dotctl packages"
  exit 1
fi

if [ ! -x "$BIN" ] || [ "$MANIFEST" -nt "$BIN" ] || [ "$APP_TOML" -nt "$BIN" ] || [ "$MAIN_RS" -nt "$BIN" ]; then
  echo "Building Dotfiles Center..."
  cargo build --release --manifest-path "$MANIFEST" -p dotfiles-center
fi

SPLINTERDOTS_ROOT="$ROOT_DIR" exec "$BIN" "$@"
