        ttk.Label(form, text="Wallpaper", style="Card.TLabel").grid(row=2, column=0, sticky="w", pady=8)
        ttk.Entry(form, textvariable=self.vars["DOTFILES_WALLPAPER"], width=48).grid(row=2, column=1, sticky="ew", padx=8, pady=8)
