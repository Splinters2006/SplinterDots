#!/usr/bin/env python3
"""Synchronize a saved SplinterDots palette with Kitty, GTK and Spicetify."""
import argparse
import configparser
import json
from pathlib import Path
import os
import re
import shutil
import stat
import subprocess
import sys


def write_changed(path, contents):
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_file() and path.read_text() == contents:
        return
    path.write_text(contents)


def readable(color):
    channels = [int(color[i:i + 2], 16) / 255 for i in (1, 3, 5)]
    linear = [v / 12.92 if v <= 0.04045 else ((v + 0.055) / 1.055) ** 2.4 for v in channels]
    return '#000000' if sum(v * w for v, w in zip(linear, (0.2126, 0.7152, 0.0722))) > 0.179 else '#ffffff'


def kitty_theme(colors):
    bg, surface, text, muted, accent, border, active_text = colors
    pairs = dict(background=bg, foreground=text, cursor=accent, cursor_text_color=active_text,
                 selection_background=accent, selection_foreground=active_text,
                 active_border_color=accent, inactive_border_color=border,
                 active_tab_background=accent, active_tab_foreground=active_text,
                 inactive_tab_background=surface, inactive_tab_foreground=readable(surface),
                 tab_bar_background=bg, url_color=accent)
    # Keep semantic terminal colors recognizable while matching UI surfaces and accents.
    ansi = [bg, '#e67e80', '#a7c080', '#dbbc7f', accent, '#d699b6', '#83c092', text,
            muted, '#f38ba8', '#b5d19a', '#f9e2af', accent, '#f5c2e7', '#94e2d5', text]
    pairs.update({f'color{i}': color for i, color in enumerate(ansi)})
    return '# Generated by SplinterDots\n' + ''.join(f'{key} {value}\n' for key, value in pairs.items())


def apply_kitty(config, colors):
    target = config / 'kitty/themes/splinterdots-generated.conf'
    write_changed(target, kitty_theme(colors))
    current = config / 'kitty/current-theme.conf'
    if not current.is_symlink() or current.resolve() != target.resolve():
        if current.exists() and not current.is_symlink():
            backup = current.with_name('current-theme.conf.before-splinterdots')
            if not backup.exists():
                shutil.copy2(current, backup)
        temporary = current.with_name('current-theme.conf.new')
        temporary.unlink(missing_ok=True)
        temporary.symlink_to(target)
        temporary.replace(current)
    # Both normal Kitty launches and the single-instance SplinterDots wrapper.
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
    sockets = list(runtime.glob('splinter-kitty-*')) + list(Path('/tmp').glob('splinter-kitty*'))
    if shutil.which('kitty'):
        for socket in sockets:
            try:
                info = socket.stat()
                if info.st_uid != os.getuid() or not stat.S_ISSOCK(info.st_mode):
                    continue
                subprocess.run(['kitty', '@', '--to', f'unix:{socket}', 'set-colors', '--all',
                                '--configured', str(current)], capture_output=True, timeout=3)
            except (OSError, subprocess.TimeoutExpired):
                continue  # A Kitty instance may close while the palette is applied.


def gtk_css(colors, version):
    bg, surface, text, muted, accent, border, active_text = colors
    surface_text = readable(surface)
    named = {
        'theme_bg_color': bg, 'theme_fg_color': text, 'theme_base_color': surface,
        'theme_text_color': surface_text, 'theme_selected_bg_color': accent,
        'theme_selected_fg_color': active_text, 'theme_unfocused_bg_color': bg,
        'theme_unfocused_fg_color': muted, 'borders': border,
        'window_bg_color': bg, 'window_fg_color': text, 'view_bg_color': bg,
        'view_fg_color': text, 'headerbar_bg_color': surface, 'headerbar_fg_color': surface_text,
        'sidebar_bg_color': surface, 'sidebar_fg_color': surface_text,
        'card_bg_color': surface, 'card_fg_color': surface_text,
        'dialog_bg_color': surface, 'dialog_fg_color': surface_text,
        'popover_bg_color': surface, 'popover_fg_color': surface_text,
        'accent_color': accent, 'accent_bg_color': accent, 'accent_fg_color': active_text,
    }
    css = '/* Generated by SplinterDots; your other GTK CSS is preserved. */\n'
    css += ''.join(f'@define-color {key} {value};\n' for key, value in named.items())
    if version == 4:
        css += ':root {\n' + ''.join(f'  --{key.replace("_", "-")}: {value};\n'
                                     for key, value in named.items() if not key.startswith('theme_')) + '}\n'
    css += '''window, .background { background-color: @window_bg_color; color: @window_fg_color; }
headerbar, .sidebar { background-color: @headerbar_bg_color; color: @headerbar_fg_color; }
entry, textview, textview text { background-color: @theme_base_color; color: @theme_text_color; }
.view, treeview, iconview, list, listview, columnview, gridview {
  background-color: @theme_base_color; color: @theme_text_color;
}
.view:selected, .view:selected:focus, treeview:selected, iconview:selected {
  background-color: @accent_bg_color; color: @accent_fg_color;
}
scrolledwindow, viewport { background-color: @theme_base_color; color: @theme_text_color; }
menu, menuitem, popover, popover contents { background-color: @popover_bg_color; color: @popover_fg_color; }
button { background-image: none; background-color: @card_bg_color; color: @card_fg_color; }
button.suggested-action, selection, row:selected { background-color: @accent_bg_color; color: @accent_fg_color; }
progressbar progress, scale highlight, switch:checked { background-color: @accent_bg_color; }
'''
    return css


def apply_gtk(config, colors):
    dark = readable(colors[0]) == '#ffffff'
    for version in (3, 4):
        folder = config / f'gtk-{version}.0'
        write_changed(folder / 'splinterdots-colors.css', gtk_css(colors, version))
        custom = folder / 'gtk.css'
        contents = custom.read_text() if custom.exists() else ''
        directive = '@import url("splinterdots-colors.css");'
        if directive not in contents:
            if custom.exists():
                backup = folder / 'gtk.css.before-splinterdots'
                if not backup.exists():
                    shutil.copy2(custom, backup)
            write_changed(custom, directive + '\n' + contents)
        settings = folder / 'settings.ini'
        parser = configparser.ConfigParser(interpolation=None, strict=False)
        parser.optionxform = str
        if settings.exists():
            parser.read(settings)
        if not parser.has_section('Settings'):
            parser.add_section('Settings')
        parser['Settings']['gtk-theme-name'] = 'Adwaita-dark' if dark else 'Adwaita'
        parser['Settings']['gtk-application-prefer-dark-theme'] = '1' if dark else '0'
        import io
        output = io.StringIO()
        parser.write(output)
        write_changed(settings, output.getvalue())
    if shutil.which('gsettings'):
        for key, value in [('gtk-theme', 'Adwaita-dark' if dark else 'Adwaita'),
                           ('color-scheme', 'prefer-dark' if dark else 'prefer-light')]:
            subprocess.run(['gsettings', 'set', 'org.gnome.desktop.interface', key, value],
                           capture_output=True, timeout=5)


def browser_css(colors):
    bg, surface, text, muted, accent, border, active_text = colors
    return f"""/* Generated by SplinterDots */
:root {{
  --zen-primary-color: {accent} !important;
  --zen-main-browser-background: {bg} !important;
  --zen-main-browser-background-toolbar: {surface} !important;
  --zen-colors-primary: {surface} !important;
  --zen-colors-secondary: {bg} !important;
  --zen-colors-tertiary: {bg} !important;
  --zen-colors-border: {border} !important;
  --zen-colors-text: {text} !important;
  --toolbar-bgcolor: {surface} !important;
  --toolbar-color: {text} !important;
  --lwt-accent-color: {bg} !important;
  --lwt-text-color: {text} !important;
  --sidebar-background-color: {bg} !important;
  --sidebar-text-color: {text} !important;
  --tab-selected-bgcolor: {surface} !important;
  --tab-selected-textcolor: {text} !important;
  --toolbar-field-background-color: {surface} !important;
  --toolbar-field-color: {text} !important;
}}
#main-window, #browser, #navigator-toolbox, #zen-main-app-wrapper,
#zen-appcontent-wrapper, #zen-tabbox-wrapper, #sidebar-box {{
  background: {bg} !important; color: {text} !important;
}}
#urlbar-background, .tab-background[selected] {{
  background: {surface} !important; border-color: {border} !important;
}}
"""


def apply_browser(config, colors):
    # Discover only registered profiles; never guess which directory holds user data.
    roots = [config / 'zen', Path.home() / '.zen', Path.home() / '.mozilla/firefox']
    seen = set()
    for root in roots:
        registry = root / 'profiles.ini'
        if not registry.is_file():
            continue
        profiles = configparser.ConfigParser(interpolation=None)
        profiles.read(registry)
        for section in profiles.sections():
            if not section.startswith('Profile') or not profiles.has_option(section, 'Path'):
                continue
            profile = Path(profiles[section]['Path'])
            if profiles.getboolean(section, 'IsRelative', fallback=True):
                profile = root / profile
            profile = profile.resolve()
            if profile in seen or not profile.is_dir():
                continue
            seen.add(profile)
            chrome = profile / 'chrome'
            write_changed(chrome / 'splinterdots-colors.css', browser_css(colors))
            custom = chrome / 'userChrome.css'
            contents = custom.read_text() if custom.exists() else ''
            directive = '@import url("splinterdots-colors.css");'
            if directive not in contents:
                if custom.exists() and not custom.with_suffix('.css.before-splinterdots').exists():
                    shutil.copy2(custom, custom.with_suffix('.css.before-splinterdots'))
                write_changed(custom, directive + '\n' + contents)
            prefs = profile / 'user.js'
            contents = prefs.read_text() if prefs.exists() else ''
            # Only manage the stylesheet preference, preserving all unrelated preferences.
            key = 'toolkit.legacyUserProfileCustomizations.stylesheets'
            desired = f'user_pref("{key}", true);'
            updated = re.sub(r'user_pref\(\s*[\'"]' + re.escape(key) + r'[\'"]\s*,\s*(?:true|false)\s*\);',
                             desired, contents)
            if desired not in updated:
                updated += '\n' + desired + '\n'
            if updated != contents:
                if prefs.exists() and not prefs.with_suffix('.js.before-splinterdots').exists():
                    shutil.copy2(prefs, prefs.with_suffix('.js.before-splinterdots'))
                write_changed(prefs, updated)


def css_font_family(font):
    return '"' + re.sub(r'[\\"\x00-\x1f\x7f]', lambda match: f'\\{ord(match[0]):x} ', font) + '"'


def vesktop_css(colors, font):
    bg, surface, text, muted, accent, border, active_text = colors
    variables = {
        'background-primary': bg, 'background-secondary': surface,
        'background-secondary-alt': bg, 'background-tertiary': bg,
        'background-floating': surface, 'background-accent': surface,
        'background-base-lowest': bg, 'background-base-lower': bg,
        'background-base-low': bg, 'background-surface-high': surface,
        'background-surface-higher': surface, 'background-surface-highest': surface,
        'bg-base-primary': bg, 'bg-base-secondary': surface, 'bg-base-tertiary': bg,
        'bg-surface-overlay': surface, 'bg-mod-faint': surface,
        'chat-background-default': bg, 'chat-background': bg,
        'channeltextarea-background': surface, 'input-background': surface,
        'modal-background': surface, 'modal-footer-background': bg,
        'home-background': bg, 'text-normal': text, 'text-default': text,
        'text-primary': text, 'text-secondary': muted, 'text-muted': muted,
        'header-primary': text, 'header-secondary': muted,
        'channels-default': muted, 'interactive-normal': muted,
        'interactive-hover': text, 'interactive-active': accent,
        'text-link': accent, 'brand-experiment': accent, 'brand-500': accent,
        'button-filled-brand-background': accent, 'button-filled-brand-text': active_text,
        'button-positive-background': accent, 'button-positive-text': active_text,
        'border-subtle': border, 'border-strong': border,
        'background-modifier-selected': surface, 'background-modifier-hover': surface,
        'scrollbar-thin-thumb': border, 'scrollbar-thin-track': bg,
        'scrollbar-auto-thumb': border, 'scrollbar-auto-track': bg,
    }
    css = '/**\n * @name SplinterDots\n * @description Follows your saved SplinterDots colors and font.\n * @version 2.0.0\n */\n'
    css += ':root, .theme-dark, .theme-light, .theme-darker, .theme-midnight {\n'
    css += ''.join(f'  --{name}: {value} !important;\n' for name, value in variables.items())
    for name in ('font-primary', 'font-display', 'font-headline', 'font-code'):
        css += f'  --{name}: {css_font_family(font)}, sans-serif !important;\n'
    css += '}\n'
    css += f'''body, #app-mount {{ background-color: {bg} !important; color: {text} !important; }}
body, button, input, textarea {{ font-family: var(--font-primary) !important; }}
[class^="bg_"], [class^="chat_"], [class^="chatContent_"] {{ background-color: {bg} !important; }}
[class^="sidebar_"], [class^="panels_"], [class^="members_"] {{ background-color: {surface} !important; }}
'''
    return css


def apply_vesktop(config, colors, font):
    folder = config / 'vesktop'
    if not folder.exists() and not shutil.which('vesktop'):
        return
    settings = folder / 'settings/settings.json'
    data = json.loads(settings.read_text()) if settings.exists() else {}
    if not isinstance(data, dict):
        raise ValueError('Vesktop settings must be a JSON object')
    css = vesktop_css(colors, font)
    theme = folder / 'themes/SplinterDots.theme.css'
    if theme.exists() and not theme.with_suffix('.css.before-splinterdots').exists():
        shutil.copy2(theme, theme.with_suffix('.css.before-splinterdots'))
    write_changed(theme, css)
    # Quick CSS is watched by Vencord, allowing live updates without restarting
    # Vesktop or replacing its in-memory plugin settings.
    quick = folder / 'settings/quickCss.css'
    original = quick.read_text() if quick.exists() else ''
    begin, end = '/* BEGIN SPLINTERDOTS THEME */', '/* END SPLINTERDOTS THEME */'
    block = begin + '\n' + css + end
    pattern = re.escape(begin) + '.*?' + re.escape(end)
    if re.search(pattern, original, re.DOTALL):
        updated = re.sub(pattern, lambda _: block, original, flags=re.DOTALL)
    else:
        updated = original.rstrip() + '\n\n' + block + '\n'
    if original != updated:
        if quick.exists() and not quick.with_suffix('.css.before-splinterdots').exists():
            shutil.copy2(quick, quick.with_suffix('.css.before-splinterdots'))
        write_changed(quick, updated)
    if data.get('useQuickCss') is not True:
        if settings.exists() and not settings.with_suffix('.json.before-splinterdots').exists():
            shutil.copy2(settings, settings.with_suffix('.json.before-splinterdots'))
        data['useQuickCss'] = True
        write_changed(settings, json.dumps(data, indent=4) + '\n')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('colors', nargs=7, metavar='HEX')
    parser.add_argument('--font', default='Noto Sans', help='Selected desktop font family')
    args = parser.parse_args()
    if not all(re.fullmatch(r'#?[0-9a-fA-F]{6}', color) for color in args.colors):
        parser.error('Colors must be six-digit hexadecimal values')
    colors = ['#' + color.removeprefix('#').lower() for color in args.colors]
    config = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config')))
    errors = []
    for label, apply in [('Kitty', apply_kitty), ('GTK', apply_gtk), ('Browser', apply_browser),
                         ('Vesktop', lambda config, colors: apply_vesktop(config, colors, args.font))]:
        try:
            apply(config, colors)
        except (OSError, ValueError, configparser.Error, subprocess.TimeoutExpired) as error:
            errors.append(f'{label}: {error}')
    try:
        helper = Path(__file__).resolve().with_name('splinter-sync-spicetify')
        result = subprocess.run([sys.executable, str(helper), *colors], capture_output=True, text=True, timeout=480)
        if result.returncode:
            errors.append(result.stderr.strip() or 'Spicetify could not apply the theme')
    except (OSError, subprocess.TimeoutExpired) as error:
        errors.append(f'Spicetify: {error}')
    if errors:
        print('Could not update all app themes: ' + '; '.join(errors), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
