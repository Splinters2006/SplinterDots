#!/usr/bin/env bash
set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
SETTINGS_FILE="$CONFIG_HOME/dotfiles/settings.conf"
MENU_DIR="$CONFIG_HOME/quickshell/splinter-media-menu"
MENU_QML="$MENU_DIR/shell.qml"

mkdir -p "$MENU_DIR"

setting() {
  local key="$1"
  local fallback="$2"

  if [ -f "$SETTINGS_FILE" ]; then
    awk -F= -v k="$key" '$1 == k { sub(/^[^=]*=/, ""); print; found=1 } END { if (!found) exit 1 }' "$SETTINGS_FILE" 2>/dev/null || printf '%s' "$fallback"
  else
    printf '%s' "$fallback"
  fi
}

theme="$(setting DOTFILES_THEME dark)"
accent="$(setting DOTFILES_ACCENT "#89b4fa")"
accent="${accent//\'/}"
accent="${accent//\"/}"

case "$theme" in
  light)
    surface="#f7f9fc"
    card="#e9eef7"
    text="#0f172a"
    muted="#475569"
    border="#cbd5e1"
    overlay="#ffffff"
    ;;
  cyber)
    surface="#1a2344"
    card="#243156"
    text="#eefcff"
    muted="#9cd7e0"
    border="#36557a"
    overlay="#10172f"
    ;;
  dracula)
    surface="#3a3f5a"
    card="#49506f"
    text="#f8f8f2"
    muted="#d0b7ff"
    border="#6b7394"
    overlay="#262938"
    ;;
  everforest)
    surface="#414c52"
    card="#4a565c"
    text="#e6dac0"
    muted="#c5b79d"
    border="#677277"
    overlay="#2c3438"
    ;;
  *)
    surface="#222a3b"
    card="#2c3548"
    text="#e2e8f0"
    muted="#a8b3c7"
    border="#475569"
    overlay="#151b28"
    ;;
esac

if pgrep -u "$UID" -f "$MENU_QML" >/dev/null 2>&1; then
  pkill -u "$UID" -f "$MENU_QML" || true
  sleep 0.08
fi

cat > "$MENU_QML" <<QML
import QtQuick
import QtQuick.Window
import Quickshell
import Quickshell.Io

ShellRoot {
  Window {
    id: root
    visible: true
    title: "Splinter Media Controls"

    width: 290
    height: 150

    minimumWidth: 290
    maximumWidth: 290
    minimumHeight: 150
    maximumHeight: 150

    flags: Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint | Qt.Tool | Qt.MSWindowsFixedSizeDialogHint
    color: "transparent"

    x: Screen.width - width - 18
    y: 52

    property string mediaTitle: "No media playing"
    property string playerStatus: "Stopped"
    property string artUrl: ""
    property real positionSeconds: 0
    property real lengthMicroseconds: 0
    property real progress: 0
    property bool shuffleEnabled: false
    property string loopMode: "none"

    Process {
      id: refreshProc
      command: [
        "sh",
        "-c",
        "title=\$(playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null || true); status=\$(playerctl status 2>/dev/null || echo Stopped); length=\$(playerctl metadata mpris:length 2>/dev/null || echo 0); pos=\$(playerctl position 2>/dev/null || echo 0); art=\$(playerctl metadata mpris:artUrl 2>/dev/null || true); shuffle=\$(playerctl shuffle 2>/dev/null || echo false); loop=\$(playerctl loop 2>/dev/null || echo None); printf '%s|%s|%s|%s|%s|%s|%s\\n' \"\$title\" \"\$status\" \"\$length\" \"\$pos\" \"\$art\" \"\$shuffle\" \"\$loop\""
      ]

      stdout: StdioCollector {
        onStreamFinished: {
          var line = this.text.split("\n")[0]
          var parts = line.split("|")

          root.mediaTitle = parts[0] && parts[0].length > 0 ? parts[0] : "No media playing"
          root.playerStatus = parts[1] && parts[1].length > 0 ? parts[1] : "Stopped"
          root.lengthMicroseconds = parts[2] ? Number(parts[2]) : 0
          root.positionSeconds = parts[3] ? Number(parts[3]) : 0
          root.artUrl = parts[4] && parts[4].length > 0 ? parts[4] : ""

          var shuffleRaw = parts[5] ? parts[5].trim().toLowerCase() : "false"
          var loopRaw = parts[6] ? parts[6].trim().toLowerCase() : "none"

          root.shuffleEnabled = shuffleRaw === "true" || shuffleRaw === "1" || shuffleRaw === "yes" || shuffleRaw === "on"

          if (loopRaw === "playlist") {
            root.loopMode = "playlist"
          } else if (loopRaw === "track") {
            root.loopMode = "track"
          } else {
            root.loopMode = "none"
          }

          if (root.lengthMicroseconds > 0) {
            root.progress = Math.max(0, Math.min(1, (root.positionSeconds * 1000000) / root.lengthMicroseconds))
          } else {
            root.progress = 0
          }
        }
      }
    }

    Process { id: prevProc; command: ["sh", "-c", "playerctl previous"] }
    Process { id: playProc; command: ["sh", "-c", "playerctl play-pause"] }
    Process { id: nextProc; command: ["sh", "-c", "playerctl next"] }
    Process { id: shuffleProc; command: ["sh", "-c", "playerctl shuffle toggle"] }
    Process {
      id: repeatCycleProc
      command: ["sh", "-c", "state=\$(playerctl loop 2>/dev/null || echo None); case \"\$state\" in None) playerctl loop Playlist ;; Playlist) playerctl loop Track ;; Track) playerctl loop None ;; *) playerctl loop None ;; esac"]
    }

    Timer {
      id: refreshTimer
      interval: 1000
      running: true
      repeat: true
      onTriggered: {
        refreshProc.running = false
        refreshProc.running = true
      }
    }

    Component.onCompleted: {
      refreshProc.running = true
    }

    Rectangle {
      anchors.fill: parent
      radius: 0
      color: "$surface"
      border.color: "$accent"
      border.width: 1
      clip: true

      Image {
        anchors.fill: parent
        source: root.artUrl
        fillMode: Image.PreserveAspectCrop
        horizontalAlignment: Image.AlignHCenter
        verticalAlignment: Image.AlignVCenter
        visible: root.artUrl.length > 0
        asynchronous: true
        cache: true
        smooth: true
      }

      Rectangle {
        anchors.fill: parent
        color: "$overlay"
        opacity: root.artUrl.length > 0 ? 0.50 : 0.90
      }

      Rectangle {
        anchors.fill: parent
        anchors.margins: 1
        radius: 0
        color: "transparent"
        border.color: "$border"
        border.width: 1
        opacity: 0.65
      }

      Column {
        anchors.fill: parent
        anchors.margins: 12
        spacing: 8

        Row {
          width: parent.width
          height: 26
          spacing: 8

          Text {
            width: parent.width - 34
            anchors.verticalCenter: parent.verticalCenter
            text: root.mediaTitle
            color: "$text"
            font.pixelSize: 11
            font.bold: true
            elide: Text.ElideRight
            maximumLineCount: 1
          }

          Rectangle {
            width: 24
            height: 24
            radius: 10
            color: closeMouse.containsMouse ? "$card" : "transparent"
            border.color: "$border"
            border.width: 1

            Text {
              anchors.centerIn: parent
              text: "×"
              color: "$muted"
              font.pixelSize: 15
              font.bold: true
            }

            MouseArea {
              id: closeMouse
              anchors.fill: parent
              hoverEnabled: true
              cursorShape: Qt.PointingHandCursor
              onClicked: Qt.quit()
            }
          }
        }

        Rectangle {
          width: parent.width
          height: 5
          radius: 3
          color: "$card"
          border.color: "$border"
          border.width: 1

          Rectangle {
            width: parent.width * root.progress
            height: parent.height
            radius: parent.radius
            color: "$accent"
          }
        }

        Row {
          width: parent.width
          height: 40
          spacing: 7

          Rectangle {
            width: 44
            height: 36
            radius: 13
            color: root.shuffleEnabled ? "$accent" : (shuffleMouse.containsMouse ? "$card" : "$card")
            border.color: "$border"
            border.width: 1

            Text {
              anchors.centerIn: parent
              text: ""
              color: root.shuffleEnabled ? "$text" : "$muted"
              font.pixelSize: 13
              font.bold: true
            }

            MouseArea {
              id: shuffleMouse
              anchors.fill: parent
              hoverEnabled: true
              cursorShape: Qt.PointingHandCursor
              onClicked: {
                root.shuffleEnabled = !root.shuffleEnabled
                shuffleProc.running = false
                shuffleProc.running = true
                refreshProc.running = false
                refreshProc.running = true
              }
            }
          }

          Rectangle {
            width: 44
            height: 36
            radius: 13
            color: prevMouse.containsMouse ? "$accent" : "$card"
            border.color: "$border"
            border.width: 1

            Text {
              anchors.centerIn: parent
              text: ""
              color: "$text"
              font.pixelSize: 14
              font.bold: true
            }

            MouseArea {
              id: prevMouse
              anchors.fill: parent
              hoverEnabled: true
              cursorShape: Qt.PointingHandCursor
              onClicked: {
                prevProc.running = false
                prevProc.running = true
              }
            }
          }

          Rectangle {
            width: 68
            height: 36
            radius: 13
            color: playMouse.containsMouse ? "$accent" : "$card"
            border.color: "$border"
            border.width: 1

            Text {
              anchors.centerIn: parent
              text: root.playerStatus === "Playing" ? "" : ""
              color: "$text"
              font.pixelSize: 16
              font.bold: true
            }

            MouseArea {
              id: playMouse
              anchors.fill: parent
              hoverEnabled: true
              cursorShape: Qt.PointingHandCursor
              onClicked: {
                playProc.running = false
                playProc.running = true
                refreshProc.running = false
                refreshProc.running = true
              }
            }
          }

          Rectangle {
            width: 44
            height: 36
            radius: 13
            color: nextMouse.containsMouse ? "$accent" : "$card"
            border.color: "$border"
            border.width: 1

            Text {
              anchors.centerIn: parent
              text: ""
              color: "$text"
              font.pixelSize: 14
              font.bold: true
            }

            MouseArea {
              id: nextMouse
              anchors.fill: parent
              hoverEnabled: true
              cursorShape: Qt.PointingHandCursor
              onClicked: {
                nextProc.running = false
                nextProc.running = true
              }
            }
          }

          Rectangle {
            width: 44
            height: 36
            radius: 13
            color: root.loopMode !== "none" ? "$accent" : (repeatCycleMouse.containsMouse ? "$card" : "$card")
            border.color: "$border"
            border.width: 1

            Text {
              anchors.centerIn: parent
              text: root.loopMode === "track" ? "¹" : (root.loopMode === "playlist" ? "" : "")
              color: root.loopMode === "none" ? "$muted" : "$text"
              font.pixelSize: root.loopMode === "track" ? 17 : 13
              font.bold: true
            }

            MouseArea {
              id: repeatCycleMouse
              anchors.fill: parent
              hoverEnabled: true
              cursorShape: Qt.PointingHandCursor
              onClicked: {
                if (root.loopMode === "none") {
                  root.loopMode = "playlist"
                } else if (root.loopMode === "playlist") {
                  root.loopMode = "track"
                } else {
                  root.loopMode = "none"
                }

                repeatCycleProc.running = false
                repeatCycleProc.running = true
                refreshProc.running = false
                refreshProc.running = true
              }
            }
          }
        }
      }
    }
  }
}
QML

quickshell -p "$MENU_QML" > /tmp/splinter-media-menu.log 2>&1 &
