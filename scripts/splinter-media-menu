#!/usr/bin/env bash
set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
MENU_DIR="$CONFIG_HOME/quickshell/splinter-media-menu"
MENU_QML="$MENU_DIR/shell.qml"
SETTINGS_FILE="$CONFIG_HOME/dotfiles/settings.conf"
TOOLS_FILE="$CONFIG_HOME/dotfiles/tools.conf"

mkdir -p "$MENU_DIR"

setting() {
  local key="$1"
  local fallback="$2"

  if [[ -f "$SETTINGS_FILE" ]]; then
    local line
    line="$(grep -E "^${key}=" "$SETTINGS_FILE" | tail -n1 || true)"
    if [[ -n "$line" ]]; then
      printf '%s\n' "${line#*=}"
      return
    fi
  fi

  printf '%s\n' "$fallback"
}

tool_setting() {
  local key="$1"
  local fallback="$2"

  if [[ -f "$TOOLS_FILE" ]]; then
    local line
    line="$(grep -E "^${key}=" "$TOOLS_FILE" | tail -n1 || true)"
    if [[ -n "$line" ]]; then
      printf '%s\n' "${line#*=}"
      return
    fi
  fi

  printf '%s\n' "$fallback"
}

theme="$(setting DOTFILES_THEME dark)"
accent="$(setting DOTFILES_ACCENT "#89b4fa")"
accent="${accent//\'/}"
accent="${accent//\"/}"

music_corner="$(tool_setting SPLINTER_MUSIC_CORNER top-right)"
music_monitor="$(tool_setting SPLINTER_MUSIC_MONITOR "")"

case "$theme" in
  light)
    bg="#f6f3ff"
    card="#ffffffcc"
    text="#181825"
    muted="#6c7086"
    border="#d8c7ff"
    overlay="#ffffff88"
    ;;
  *)
    bg="#151021"
    card="#293246cc"
    text="#f8fafc"
    muted="#cbd5e1"
    border="#475569"
    overlay="#10182088"
    ;;
esac

if pgrep -u "$UID" -f "$MENU_QML" >/dev/null 2>&1; then
  pkill -u "$UID" -f "$MENU_QML" || true

  if [[ "${SPLINTER_FORCE_OPEN:-0}" != "1" ]]; then
    exit 0
  fi

  sleep 0.12
fi

cat > "$MENU_QML" <<QML
import QtQuick
import Qt5Compat.GraphicalEffects
import Quickshell
import Quickshell.Io
import Quickshell.Wayland

ShellRoot {
  PanelWindow {
    id: root
    visible: true

    implicitWidth: 300
    implicitHeight: 154
    color: "transparent"

    property string corner: "$music_corner"
    property string wantedScreen: "$music_monitor"

    property string mediaTitle: "No media playing"
    property string playerStatus: "Stopped"
    property string artUrl: ""
    property real positionSeconds: 0
    property real lengthMicroseconds: 0
    property real progress: 0
    property bool shuffleEnabled: false
    property string loopMode: "none"

    function pickScreen() {
      if (wantedScreen.length === 0)
        return Quickshell.screens[0]

      for (var i = 0; i < Quickshell.screens.length; i++) {
        if (Quickshell.screens[i].name === wantedScreen)
          return Quickshell.screens[i]
      }

      return Quickshell.screens[0]
    }

    screen: pickScreen()

    anchors {
      top: corner.indexOf("top") === 0
      bottom: corner.indexOf("bottom") === 0
      left: corner.indexOf("left") >= 0
      right: corner.indexOf("right") >= 0
    }

    margins {
      top: corner.indexOf("top") === 0 ? 54 : 0
      bottom: corner.indexOf("bottom") === 0 ? 18 : 0
      left: corner.indexOf("left") >= 0 ? 18 : 0
      right: corner.indexOf("right") >= 0 ? 18 : 0
    }

    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.None

    Process {
      id: refreshProc
      command: [
        "sh",
        "-c",
        "{ playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null || true; playerctl status 2>/dev/null || echo Stopped; playerctl metadata mpris:length 2>/dev/null || echo 0; playerctl position 2>/dev/null || echo 0; playerctl metadata mpris:artUrl 2>/dev/null || true; playerctl shuffle 2>/dev/null || echo false; playerctl loop 2>/dev/null || echo None; } | paste -sd '|' -"
      ]

      stdout: StdioCollector {
        onStreamFinished: {
          var line = this.text.split("\\n")[0]
          var parts = line.split("|")

          root.mediaTitle = parts[0] && parts[0].length > 0 ? parts[0] : "No media playing"
          root.playerStatus = parts[1] && parts[1].length > 0 ? parts[1] : "Stopped"
          root.lengthMicroseconds = parts[2] ? Number(parts[2]) : 0
          root.positionSeconds = parts[3] ? Number(parts[3]) : 0
          root.artUrl = parts[4] && parts[4].length > 0 ? parts[4] : ""

          var shuffleRaw = parts[5] ? parts[5].trim().toLowerCase() : "false"
          var loopRaw = parts[6] ? parts[6].trim().toLowerCase() : "none"

          root.shuffleEnabled = shuffleRaw === "true" || shuffleRaw === "1" || shuffleRaw === "yes" || shuffleRaw === "on"

          if (loopRaw === "playlist") {
            root.loopMode = "playlist"
          } else if (loopRaw === "track") {
            root.loopMode = "track"
          } else {
            root.loopMode = "none"
          }

          if (root.lengthMicroseconds > 0) {
            root.progress = Math.max(0, Math.min(1, (root.positionSeconds * 1000000) / root.lengthMicroseconds))
          } else {
            root.progress = 0
          }
        }
      }
    }

    Process {
      id: prevProc
      command: ["sh", "-c", "playerctl previous"]
    }

    Process {
      id: playProc
      command: ["sh", "-c", "playerctl play-pause"]
    }

    Process {
      id: nextProc
      command: ["sh", "-c", "playerctl next"]
    }

    Process {
      id: shuffleProc
      command: ["sh", "-c", "playerctl shuffle toggle"]
    }

    Process {
      id: repeatCycleProc
      command: [
        "sh",
        "-c",
        "state=\$(playerctl loop 2>/dev/null || echo None); case \"\$state\" in None|none|Off|off) playerctl loop Playlist ;; Playlist|playlist) playerctl loop Track ;; Track|track) playerctl loop None ;; *) playerctl loop None ;; esac"
      ]
    }

    Process {
      id: cycleCornerProc
      command: ["sh", "-c", "nohup $HOME/.local/bin/splinter-music-cycle-corner >/tmp/splinter-music-cycle-corner.log 2>&1 &"]
    }

    Process {
      id: cycleMonitorProc
      command: ["sh", "-c", "nohup $HOME/.local/bin/splinter-music-cycle-monitor >/tmp/splinter-music-cycle-monitor.log 2>&1 &"]
    }

    Timer {
      id: refreshTimer
      interval: 1000
      running: true
      repeat: true
      onTriggered: {
        refreshProc.running = false
        refreshProc.running = true
      }
    }

    Timer {
      id: delayedRefreshTimer
      interval: 250
      running: false
      repeat: false
      onTriggered: {
        refreshProc.running = false
        refreshProc.running = true
      }
    }

    Component.onCompleted: {
      refreshProc.running = true
    }

    Rectangle {
      anchors.fill: parent
      radius: 18
      clip: true
      color: "$bg"
      border.color: "$border"
      border.width: 1

      Image {
        id: albumArtImage
        anchors.fill: parent
        source: root.artUrl
        fillMode: Image.PreserveAspectCrop
        horizontalAlignment: Image.AlignHCenter
        verticalAlignment: Image.AlignVCenter
        cache: false
        asynchronous: true
        smooth: true
        visible: false
      }

      Rectangle {
        id: albumArtMask
        anchors.fill: parent
        radius: 18
        visible: false
      }

      OpacityMask {
        anchors.fill: parent
        source: albumArtImage
        maskSource: albumArtMask
        visible: root.artUrl.length > 0
      }

      Rectangle {
        anchors.fill: parent
        color: "$overlay"
      }

      Row {
        z: 999
        anchors.top: parent.top
        anchors.right: parent.right
        anchors.topMargin: 8
        anchors.rightMargin: 8
        spacing: 6

        Rectangle {
          width: 24
          height: 24
          radius: 8
          color: monitorMouse.containsMouse ? "$accent" : "$card"
          border.color: "$border"
          border.width: 1

          Text {
            anchors.centerIn: parent
            text: "󰍺"
            color: "$text"
            font.pixelSize: 12
            font.bold: true
          }

          MouseArea {
            id: monitorMouse
            anchors.fill: parent
            hoverEnabled: true
            cursorShape: Qt.PointingHandCursor
            onClicked: {
              cycleMonitorProc.running = false
              cycleMonitorProc.running = true
            }
          }
        }

        Rectangle {
          width: 24
          height: 24
          radius: 8
          color: cornerMouse.containsMouse ? "$accent" : "$card"
          border.color: "$border"
          border.width: 1

          Text {
            anchors.centerIn: parent
            text: "󰁌"
            color: "$text"
            font.pixelSize: 12
            font.bold: true
          }

          MouseArea {
            id: cornerMouse
            anchors.fill: parent
            hoverEnabled: true
            cursorShape: Qt.PointingHandCursor
            onClicked: {
              cycleCornerProc.running = false
              cycleCornerProc.running = true
            }
          }
        }
      }

      Column {
        anchors.fill: parent
        anchors.margins: 12
        spacing: 10

        Item {
          width: parent.width
          height: 24

          Text {
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            anchors.rightMargin: 62
            text: root.mediaTitle
            color: "$text"
            font.pixelSize: 13
            font.bold: true
            elide: Text.ElideRight
          }
        }

        Rectangle {
          width: parent.width
          height: 6
          radius: 3
          color: "$border"

          Rectangle {
            width: Math.max(8, parent.width * root.progress)
            height: parent.height
            radius: parent.radius
            color: "$accent"
          }
        }

        Row {
          width: parent.width
          height: 40
          spacing: 7

          Rectangle {
            width: 44
            height: 36
            radius: 13
            color: root.shuffleEnabled ? "$accent" : "$card"
            border.color: "$border"
            border.width: 1

            Text {
              anchors.centerIn: parent
              text: ""
              color: root.shuffleEnabled ? "$text" : "$muted"
              font.pixelSize: 13
              font.bold: true
            }

            MouseArea {
              anchors.fill: parent
              hoverEnabled: true
              cursorShape: Qt.PointingHandCursor
              onClicked: {
                root.shuffleEnabled = !root.shuffleEnabled
                shuffleProc.running = false
                shuffleProc.running = true
                delayedRefreshTimer.running = false
                delayedRefreshTimer.running = true
              }
            }
          }

          Rectangle {
            width: 44
            height: 36
            radius: 13
            color: "$card"
            border.color: "$border"
            border.width: 1

            Text {
              anchors.centerIn: parent
              text: ""
              color: "$text"
              font.pixelSize: 14
              font.bold: true
            }

            MouseArea {
              anchors.fill: parent
              hoverEnabled: true
              cursorShape: Qt.PointingHandCursor
              onClicked: {
                prevProc.running = false
                prevProc.running = true
                delayedRefreshTimer.running = false
                delayedRefreshTimer.running = true
              }
            }
          }

          Rectangle {
            width: 68
            height: 36
            radius: 13
            color: "$accent"
            border.color: "$border"
            border.width: 1

            Text {
              anchors.centerIn: parent
              text: root.playerStatus === "Playing" ? "" : ""
              color: "$text"
              font.pixelSize: 16
              font.bold: true
            }

            MouseArea {
              anchors.fill: parent
              hoverEnabled: true
              cursorShape: Qt.PointingHandCursor
              onClicked: {
                playProc.running = false
                playProc.running = true
                delayedRefreshTimer.running = false
                delayedRefreshTimer.running = true
              }
            }
          }

          Rectangle {
            width: 44
            height: 36
            radius: 13
            color: "$card"
            border.color: "$border"
            border.width: 1

            Text {
              anchors.centerIn: parent
              text: ""
              color: "$text"
              font.pixelSize: 14
              font.bold: true
            }

            MouseArea {
              anchors.fill: parent
              hoverEnabled: true
              cursorShape: Qt.PointingHandCursor
              onClicked: {
                nextProc.running = false
                nextProc.running = true
                delayedRefreshTimer.running = false
                delayedRefreshTimer.running = true
              }
            }
          }

          Rectangle {
            width: 44
            height: 36
            radius: 13
            color: root.loopMode !== "none" ? "$accent" : "$card"
            border.color: "$border"
            border.width: 1

            Text {
              anchors.centerIn: parent
              text: root.loopMode === "track" ? "󰑘" : (root.loopMode === "playlist" ? "" : "")
              color: root.loopMode === "none" ? "$muted" : "$text"
              font.pixelSize: root.loopMode === "track" ? 17 : 13
              font.bold: true
            }

            MouseArea {
              anchors.fill: parent
              hoverEnabled: true
              cursorShape: Qt.PointingHandCursor
              onClicked: {
                if (root.loopMode === "none") {
                  root.loopMode = "playlist"
                } else if (root.loopMode === "playlist") {
                  root.loopMode = "track"
                } else {
                  root.loopMode = "none"
                }

                repeatCycleProc.running = false
                repeatCycleProc.running = true
                delayedRefreshTimer.running = false
                delayedRefreshTimer.running = true
              }
            }
          }
        }
      }
    }
  }
}
QML

quickshell -p "$MENU_QML" > /tmp/splinter-media-menu.log 2>&1 &
