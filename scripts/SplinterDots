#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "$0")"
ROOT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
BIN="$ROOT_DIR/target/release/SplinterDots"
MANIFEST="$ROOT_DIR/Cargo.toml"
MAIN_RS="$ROOT_DIR/tools/SplinterDots/src/main.rs"
APP_TOML="$ROOT_DIR/tools/SplinterDots/Cargo.toml"

if command -v rustup >/dev/null 2>&1 && ! rustup show active-toolchain >/dev/null 2>&1; then
  echo "No Rust toolchain is configured; installing stable..."
  rustup default stable
fi

if ! command -v cargo >/dev/null 2>&1; then
  echo "Cargo is required for SplinterDots."
  echo "Install the dotfiles packages with: dotctl packages"
  exit 1
fi

if [ ! -x "$BIN" ] || [ "$MANIFEST" -nt "$BIN" ] || [ "$APP_TOML" -nt "$BIN" ] || [ "$MAIN_RS" -nt "$BIN" ]; then
  echo "Building SplinterDots..."
  cargo build --release --manifest-path "$MANIFEST" -p SplinterDots
fi

SPLINTERDOTS_ROOT="$ROOT_DIR" exec "$BIN" "$@"
