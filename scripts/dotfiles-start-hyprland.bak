#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="${DOTFILES_ROOT:-$HOME/SplinterDots}"

if [ ! -x "$ROOT_DIR/scripts/start-hyprland" ]; then
  echo "Could not find: $ROOT_DIR/scripts/start-hyprland" >&2
  echo "Set DOTFILES_ROOT=/path/to/SplinterDots if your repo is somewhere else." >&2
  exit 1
fi

DOTFILES_ROOT="$ROOT_DIR" exec "$ROOT_DIR/scripts/start-hyprland" "$@"
