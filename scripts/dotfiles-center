#!/usr/bin/env python3
import os
import json
import re
import subprocess
import sys
import tkinter as tk
from pathlib import Path
from tkinter import colorchooser, filedialog, messagebox, ttk


ROOT = Path(__file__).resolve().parent.parent
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
DOTFILES_DIR = CONFIG_HOME / "dotfiles"
LOCAL_CONF = DOTFILES_DIR / "local.conf"
KEYBINDS_JSON = DOTFILES_DIR / "keybinds.json"
DISABLED_FILE = DOTFILES_DIR / "welcome-disabled"
HYPR_DIR = CONFIG_HOME / "hypr"
HYPR_COLORS = HYPR_DIR / "colors.conf"
HYPR_KEYBINDS = HYPR_DIR / "keybindings.conf"
WAYBAR_DIR = CONFIG_HOME / "waybar"
WAYBAR_CONFIG = WAYBAR_DIR / "config"
WAYBAR_STYLE = WAYBAR_DIR / "style.css"

DEFAULTS = {
    "DOTFILES_EDITOR": "nano",
    "DOTFILES_BROWSER": "zen-browser",
    "DOTFILES_THEME": "dark",
    "DOTFILES_ACCENT": "#89b4fa",
    "DOTFILES_WALLPAPER": "",
    "DOTFILES_TERMINAL": "kitty",
    "DOTFILES_FILE_MANAGER": "thunar",
    "DOTFILES_APP_LAUNCHER": "wofi --show drun",
    "DOTFILES_BAR_POSITION": "top",
    "DOTFILES_BAR_HEIGHT": "34",
    "DOTFILES_BAR_RADIUS": "8",
    "DOTFILES_BAR_OPACITY": "0.92",
    "DOTFILES_BAR_WORKSPACES": "left",
    "DOTFILES_BAR_CLOCK": "center",
    "DOTFILES_BAR_RIGHT": "pulseaudio,network,battery,tray",
}

DEFAULT_KEYBINDS = [
    {"name": "Terminal", "key": "Q", "type": "command", "value": "$terminal"},
    {"name": "File manager", "key": "E", "type": "command", "value": "$fileManager"},
    {"name": "App launcher", "key": "D", "type": "command", "value": "$menu"},
    {"name": "Browser", "key": "B", "type": "command", "value": "$browser"},
    {"name": "Close window", "key": "C", "type": "dispatcher", "value": "killactive"},
    {"name": "Exit Hyprland", "key": "M", "type": "dispatcher", "value": "exit"},
    {"name": "Fullscreen", "key": "F", "type": "dispatcher", "value": "fullscreen"},
    {"name": "Floating mode", "key": "V", "type": "dispatcher", "value": "togglefloating"},
    {"name": "Pseudo tile", "key": "P", "type": "dispatcher", "value": "pseudo"},
    {"name": "Toggle split", "key": "J", "type": "dispatcher", "value": "layoutmsg, togglesplit"},
    {"name": "Screenshot region", "key": "S", "type": "command", "value": "dotfiles-screenshot region"},
    {"name": "Screenshot full screen", "key": "SHIFT, S", "type": "command", "value": "dotfiles-screenshot full"},
    {"name": "Dotfiles Center", "key": "W", "type": "command", "value": "dotctl welcome"},
    {"name": "Reload Hyprland", "key": "SHIFT, R", "type": "command", "value": "hyprctl reload"},
]


def shell_quote(value: str) -> str:
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def read_local_conf() -> dict:
    values = DEFAULTS.copy()
    if not LOCAL_CONF.exists():
        return values

    pattern = re.compile(r"^([A-Za-z_][A-Za-z0-9_]*)=(.*)$")
    for line in LOCAL_CONF.read_text(encoding="utf-8").splitlines():
        match = pattern.match(line.strip())
        if not match:
            continue
        key, raw = match.groups()
        raw = raw.strip()
        if len(raw) >= 2 and raw[0] == raw[-1] == '"':
            raw = raw[1:-1].replace('\\"', '"').replace("\\\\", "\\")
        values[key] = raw
    return values


def write_local_conf(values: dict) -> None:
    DOTFILES_DIR.mkdir(parents=True, exist_ok=True)
    lines = [
        "# Machine-local dotfiles settings written by Dotfiles Center.",
        "# It is safe to edit this file manually too.",
    ]
    for key in DEFAULTS:
        lines.append(f"{key}={shell_quote(values.get(key, DEFAULTS[key]))}")
    LOCAL_CONF.write_text("\n".join(lines) + "\n", encoding="utf-8")


def default_keybinds() -> list[dict]:
    return [keybind.copy() for keybind in DEFAULT_KEYBINDS]


def load_keybinds() -> list[dict]:
    if not KEYBINDS_JSON.exists():
        return default_keybinds()

    try:
        raw = json.loads(KEYBINDS_JSON.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return default_keybinds()

    keybinds = []
    if not isinstance(raw, list):
        return default_keybinds()

    for item in raw:
        if not isinstance(item, dict):
            continue
        name = str(item.get("name", "")).strip()
        key = str(item.get("key", "")).strip()
        kind = str(item.get("type", "command")).strip()
        value = str(item.get("value", "")).strip()
        if not name or not key or not value:
            continue
        if kind not in {"command", "dispatcher"}:
            kind = "command"
        keybinds.append({"name": name, "key": key, "type": kind, "value": value})

    return keybinds or default_keybinds()


def save_keybinds(keybinds: list[dict]) -> None:
    DOTFILES_DIR.mkdir(parents=True, exist_ok=True)
    KEYBINDS_JSON.write_text(json.dumps(keybinds, indent=2) + "\n", encoding="utf-8")


def hex_to_hypr_rgba(hex_color: str) -> str:
    clean = hex_color.strip().lstrip("#")
    if len(clean) != 6 or not re.fullmatch(r"[0-9a-fA-F]{6}", clean):
        clean = "89b4fa"
    return f"rgba({clean.lower()}ff)"


def write_colors(accent: str) -> None:
    HYPR_DIR.mkdir(parents=True, exist_ok=True)
    HYPR_COLORS.write_text(
        f"$accent = {hex_to_hypr_rgba(accent)}\n$inactive = rgba(45475aff)\n",
        encoding="utf-8",
    )


def write_keybinds(values: dict, keybinds: list[dict]) -> None:
    HYPR_DIR.mkdir(parents=True, exist_ok=True)
    terminal = values.get("DOTFILES_TERMINAL", DEFAULTS["DOTFILES_TERMINAL"])
    file_manager = values.get("DOTFILES_FILE_MANAGER", DEFAULTS["DOTFILES_FILE_MANAGER"])
    launcher = values.get("DOTFILES_APP_LAUNCHER", DEFAULTS["DOTFILES_APP_LAUNCHER"])
    browser = values.get("DOTFILES_BROWSER", DEFAULTS["DOTFILES_BROWSER"])

    lines = [
        "$mainMod = SUPER",
        f"$terminal = {terminal}",
        f"$fileManager = {file_manager}",
        f"$menu = {launcher}",
        f"$browser = {browser}",
        "",
    ]

    for keybind in keybinds:
        key = keybind.get("key", "").strip()
        value = keybind.get("value", "").strip()
        kind = keybind.get("type", "command").strip()
        if not key or not value:
            continue
        modifier = "$mainMod"
        key_name = key
        if key.startswith("SHIFT,"):
            modifier = "$mainMod SHIFT"
            key_name = key.split(",", 1)[1].strip()
        action = f"exec, {value}" if kind == "command" else value
        lines.append(f"bind = {modifier}, {key_name}, {action}")

    lines.extend(
        [
            "",
            "bind = $mainMod, left, movefocus, l",
            "bind = $mainMod, right, movefocus, r",
            "bind = $mainMod, up, movefocus, u",
            "bind = $mainMod, down, movefocus, d",
            "",
            "bind = $mainMod SHIFT, left, movewindow, l",
            "bind = $mainMod SHIFT, right, movewindow, r",
            "bind = $mainMod SHIFT, up, movewindow, u",
            "bind = $mainMod SHIFT, down, movewindow, d",
            "",
        ]
    )

    for i in range(1, 10):
        lines.append(f"bind = $mainMod, {i}, workspace, {i}")
    lines.append("")
    for i in range(1, 10):
        lines.append(f"bind = $mainMod SHIFT, {i}, movetoworkspace, {i}")

    HYPR_KEYBINDS.write_text("\n".join(lines) + "\n", encoding="utf-8")


def clamp_int(value: str, default: int, minimum: int, maximum: int) -> int:
    try:
        number = int(float(value))
    except ValueError:
        number = default
    return max(minimum, min(maximum, number))


def clamp_float(value: str, default: float, minimum: float, maximum: float) -> float:
    try:
        number = float(value)
    except ValueError:
        number = default
    return max(minimum, min(maximum, number))


def write_waybar(values: dict) -> None:
    WAYBAR_DIR.mkdir(parents=True, exist_ok=True)

    position = values.get("DOTFILES_BAR_POSITION", "top")
    if position not in {"top", "bottom"}:
        position = "top"

    workspace_side = values.get("DOTFILES_BAR_WORKSPACES", "left")
    clock_side = values.get("DOTFILES_BAR_CLOCK", "center")
    height = clamp_int(values.get("DOTFILES_BAR_HEIGHT", "34"), 34, 24, 72)
    radius = clamp_int(values.get("DOTFILES_BAR_RADIUS", "8"), 8, 0, 28)
    opacity = clamp_float(values.get("DOTFILES_BAR_OPACITY", "0.92"), 0.92, 0.2, 1.0)

    right_modules = [
        module.strip()
        for module in values.get("DOTFILES_BAR_RIGHT", "pulseaudio,network,battery,tray").split(",")
        if module.strip()
    ]

    left: list[str] = []
    center: list[str] = []
    right: list[str] = []

    if workspace_side == "center":
        center.append("hyprland/workspaces")
    elif workspace_side == "right":
        right.append("hyprland/workspaces")
    else:
        left.append("hyprland/workspaces")

    if clock_side == "left":
        left.append("clock")
    elif clock_side == "right":
        right.append("clock")
    else:
        center.append("clock")

    right.extend(right_modules)

    config = {
        "layer": "top",
        "position": position,
        "height": height,
        "margin-top": 8 if position == "top" else 0,
        "margin-bottom": 8 if position == "bottom" else 0,
        "margin-left": 10,
        "margin-right": 10,
        "modules-left": left,
        "modules-center": center,
        "modules-right": right,
        "hyprland/workspaces": {
            "disable-scroll": True,
            "all-outputs": True,
        },
        "clock": {
            "format": "{:%a %d %b  %H:%M}",
        },
        "pulseaudio": {
            "format": "VOL {volume}%",
            "format-muted": "MUTED",
        },
        "network": {
            "format-wifi": "NET {essid}",
            "format-ethernet": "NET wired",
            "format-disconnected": "NET off",
        },
        "battery": {
            "format": "BAT {capacity}%",
        },
    }
    WAYBAR_CONFIG.write_text(json.dumps(config, indent=2) + "\n", encoding="utf-8")

    alpha = f"{opacity:.2f}"
    style = f"""* {{
  border: none;
  border-radius: 0;
  font-family: sans-serif;
  font-size: 13px;
  min-height: 0;
}}

window#waybar {{
  background: rgba(30, 30, 46, {alpha});
  color: #cdd6f4;
  border-radius: {radius}px;
}}

#workspaces button {{
  color: #cdd6f4;
  padding: 0 10px;
  border-radius: {max(0, radius - 2)}px;
}}

#workspaces button.active {{
  background: {values.get("DOTFILES_ACCENT", "#89b4fa")};
  color: #11111b;
}}

#clock,
#pulseaudio,
#network,
#battery,
#tray {{
  padding: 0 12px;
}}
"""
    WAYBAR_STYLE.write_text(style, encoding="utf-8")


def run_quiet(command: list[str]) -> None:
    try:
        subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


class DotfilesCenter(tk.Tk):
    bg = "#111827"
    panel = "#172033"
    card = "#1f2937"
    card_soft = "#243044"
    text = "#e5e7eb"
    muted = "#9ca3af"
    accent = "#89b4fa"
    accent_dark = "#2563eb"

    def __init__(self, force: bool) -> None:
        super().__init__()
        self.force = force
        self.values = read_local_conf()
        self.title("Dotfiles Center")
        self.geometry("920x680")
        self.minsize(820, 600)
        self.configure(bg=self.bg)

        self.vars = {key: tk.StringVar(value=value) for key, value in self.values.items()}
        self.keybinds = load_keybinds()
        self.keybind_tree: ttk.Treeview | None = None
        self.no_show_var = tk.BooleanVar(value=DISABLED_FILE.exists())

        self._setup_style()
        self._build()

    def _setup_style(self) -> None:
        style = ttk.Style(self)
        try:
            style.theme_use("clam")
        except tk.TclError:
            pass

        def configure(name: str, **options: object) -> None:
            try:
                style.configure(name, **options)
            except tk.TclError:
                pass

        def map_style(name: str, **options: object) -> None:
            try:
                style.map(name, **options)
            except tk.TclError:
                pass

        configure(".", font=("Sans", 10), background=self.bg, foreground=self.text)
        configure("Root.TFrame", background=self.bg)
        configure("Panel.TFrame", background=self.panel)
        configure("Card.TFrame", background=self.card, relief="flat")
        configure("Soft.TFrame", background=self.card_soft)
        configure("Title.TLabel", background=self.bg, foreground=self.text, font=("Sans", 24, "bold"))
        configure("Subtitle.TLabel", background=self.bg, foreground=self.muted, font=("Sans", 11))
        configure("Heading.TLabel", background=self.card, foreground=self.text, font=("Sans", 14, "bold"))
        configure("Body.TLabel", background=self.card, foreground=self.muted, font=("Sans", 10))
        configure("Muted.TLabel", background=self.bg, foreground=self.muted)
        configure("Card.TLabel", background=self.card, foreground=self.text)
        configure("CardMuted.TLabel", background=self.card, foreground=self.muted)

        configure(
            "Accent.TButton",
            background=self.accent_dark,
            foreground="#ffffff",
            borderwidth=0,
            focusthickness=0,
            padding=(14, 9),
        )
        map_style("Accent.TButton", background=[("active", "#3b82f6"), ("pressed", "#1d4ed8")])
        configure("TButton", padding=(12, 8), borderwidth=0)
        configure("TCheckbutton", background=self.bg, foreground=self.text)
        map_style("TCheckbutton", background=[("active", self.bg)])

        configure(
            "TNotebook",
            background=self.bg,
            borderwidth=0,
            tabmargins=(0, 8, 0, 0),
        )
        configure(
            "TNotebook.Tab",
            background=self.panel,
            foreground=self.muted,
            padding=(18, 10),
            borderwidth=0,
        )
        map_style(
            "TNotebook.Tab",
            background=[("selected", self.card)],
            foreground=[("selected", self.text), ("active", self.text)],
        )
        configure("TEntry", fieldbackground="#0f172a", foreground=self.text, padding=8)
        configure("TCombobox", fieldbackground="#0f172a", foreground=self.text, padding=8)
        configure(
            "Treeview",
            background=self.card_soft,
            fieldbackground=self.card_soft,
            foreground=self.text,
            rowheight=30,
            borderwidth=0,
        )
        configure(
            "Treeview.Heading",
            background=self.card,
            foreground=self.muted,
            padding=(8, 8),
            borderwidth=0,
        )
        map_style("Treeview", background=[("selected", self.accent_dark)], foreground=[("selected", "#ffffff")])

    def _card(self, parent: tk.Widget, padding: int = 16) -> ttk.Frame:
        card = ttk.Frame(parent, style="Card.TFrame", padding=padding)
        card.pack(fill="x", pady=(0, 14))
        return card

    def _card_title(self, parent: tk.Widget, title: str, body: str | None = None) -> None:
        ttk.Label(parent, text=title, style="Heading.TLabel").pack(anchor="w")
        if body:
            ttk.Label(parent, text=body, style="Body.TLabel", wraplength=760).pack(anchor="w", pady=(5, 0))

    def _build(self) -> None:
        header = ttk.Frame(self, style="Root.TFrame", padding=(26, 24, 26, 8))
        header.pack(fill="x")
        ttk.Label(header, text="Dotfiles Center", style="Title.TLabel").pack(anchor="w")
        ttk.Label(
            header,
            text="A friendly control panel for Hyprland, appearance, keybinds, audio, and setup.",
            style="Subtitle.TLabel",
        ).pack(anchor="w", pady=(6, 0))

        notebook = ttk.Notebook(self)
        notebook.pack(fill="both", expand=True, padx=26, pady=12)

        self._overview_tab(notebook)
        self._keybinds_tab(notebook)
        self._appearance_tab(notebook)
        self._bar_tab(notebook)
        self._setup_tab(notebook)

        footer = ttk.Frame(self, style="Root.TFrame", padding=(26, 2, 26, 22))
        footer.pack(fill="x")
        ttk.Checkbutton(
            footer,
            text="Don't show this on startup",
            variable=self.no_show_var,
            command=self.save_startup_choice,
        ).pack(side="left")
        ttk.Button(footer, text="Save changes", style="Accent.TButton", command=self.save_all).pack(side="right")

    def _overview_tab(self, notebook: ttk.Notebook) -> None:
        frame = ttk.Frame(notebook, style="Panel.TFrame", padding=18)
        notebook.add(frame, text="Overview")

        hero = self._card(frame, padding=20)
        self._card_title(
            hero,
            "Your Arch desktop, ready to shape",
            "This setup turns a minimal Arch install into a complete Hyprland desktop with clear controls instead of hidden config chores.",
        )

        quick = ttk.Frame(hero, style="Card.TFrame")
        quick.pack(fill="x", pady=(18, 0))
        quick_items = [
            ("Super + D", "Open apps"),
            ("Super + Return", "Terminal"),
            ("Super + W", "Dotfiles Center"),
            ("Super + Shift + R", "Reload Hyprland"),
        ]
        for column, (key, label) in enumerate(quick_items):
            tile = ttk.Frame(quick, style="Soft.TFrame", padding=(14, 10))
            tile.grid(row=0, column=column, sticky="ew", padx=(0 if column == 0 else 8, 0))
            ttk.Label(tile, text=key, background=self.card_soft, foreground=self.text, font=("Sans", 11, "bold")).pack(anchor="w")
            ttk.Label(tile, text=label, background=self.card_soft, foreground=self.muted).pack(anchor="w", pady=(3, 0))
            quick.columnconfigure(column, weight=1)

        details = self._card(frame)
        self._card_title(details, "What --all installs")
        text = tk.Text(
            details,
            wrap="word",
            height=13,
            relief="flat",
            bg=self.card,
            fg=self.text,
            insertbackground=self.text,
            padx=0,
            pady=10,
            borderwidth=0,
            highlightthickness=0,
            font=("Sans", 10),
        )
        text.pack(fill="both", expand=True)
        text.insert(
            "1.0",
            "- Hyprland window manager\n"
            "- Waybar top bar\n"
            "- Wofi app launcher\n"
            "- Mako notifications\n"
            "- Kitty terminal\n"
            "- Thunar file manager\n"
            "- Firefox browser\n"
            "- Screenshot, clipboard, wallpaper, audio, network, portal, Bluetooth, and login tools\n\n"
            "Useful terminal commands:\n"
            "- dotctl all: update, install, configure, and apply\n"
            "- dotctl status: show linked files\n"
            "- dotctl doctor: debug Hyprland and graphics issues",
        )
        text.configure(state="disabled")

    def _keybinds_tab(self, notebook: ttk.Notebook) -> None:
        frame = ttk.Frame(notebook, style="Panel.TFrame", padding=18)
        notebook.add(frame, text="Keybinds")

        intro = self._card(frame)
        self._card_title(
            intro,
            "Keybinds",
            "Main modifier: Super / Windows key. Change the keys below, save, then press Super + Shift + R to reload Hyprland.",
        )

        table_card = self._card(frame)
        self.keybind_tree = ttk.Treeview(
            table_card,
            columns=("key", "type", "value"),
            show="tree headings",
            height=13,
        )
        self.keybind_tree.heading("#0", text="Name")
        self.keybind_tree.heading("key", text="Key")
        self.keybind_tree.heading("type", text="Type")
        self.keybind_tree.heading("value", text="Command / dispatcher")
        self.keybind_tree.column("#0", width=170, stretch=True)
        self.keybind_tree.column("key", width=110, stretch=False)
        self.keybind_tree.column("type", width=100, stretch=False)
        self.keybind_tree.column("value", width=390, stretch=True)
        self.keybind_tree.pack(fill="both", expand=True)
        self.keybind_tree.bind("<Double-1>", lambda _event: self.edit_keybind())

        buttons = ttk.Frame(table_card, style="Card.TFrame")
        buttons.pack(fill="x", pady=(12, 0))
        ttk.Button(buttons, text="Add command", style="Accent.TButton", command=self.add_keybind).pack(side="left")
        ttk.Button(buttons, text="Edit selected", command=self.edit_keybind).pack(side="left", padx=8)
        ttk.Button(buttons, text="Remove selected", command=self.remove_keybind).pack(side="left", padx=8)
        ttk.Button(buttons, text="Restore defaults", command=self.reset_keybinds).pack(side="left", padx=8)

        hint = self._card(frame)
        self._card_title(
            hint,
            "Custom commands",
            "Use type Command for normal apps and scripts, like kitty, firefox, grimblast, or your own shell script. Use Dispatcher only for native Hyprland actions like fullscreen or killactive.",
        )
        self.refresh_keybind_tree()

    def _appearance_tab(self, notebook: ttk.Notebook) -> None:
        frame = ttk.Frame(notebook, style="Panel.TFrame", padding=18)
        notebook.add(frame, text="Appearance")

        card = self._card(frame)
        self._card_title(card, "Appearance", "Pick a wallpaper, choose an accent color, and keep the desktop feeling like yours.")

        grid = ttk.Frame(card, style="Card.TFrame")
        grid.pack(fill="x")

        ttk.Label(grid, text="Wallpaper", style="Card.TLabel").grid(row=0, column=0, sticky="w", pady=10)
        ttk.Entry(grid, textvariable=self.vars["DOTFILES_WALLPAPER"], width=58).grid(row=0, column=1, sticky="ew", padx=8)
        ttk.Button(grid, text="Choose image", command=self.choose_wallpaper).grid(row=0, column=2, sticky="ew")

        ttk.Label(grid, text="Accent color", style="Card.TLabel").grid(row=1, column=0, sticky="w", pady=10)
        ttk.Entry(grid, textvariable=self.vars["DOTFILES_ACCENT"], width=18).grid(row=1, column=1, sticky="w", padx=8)
        ttk.Button(grid, text="Pick color", command=self.choose_color).grid(row=1, column=2, sticky="ew")

        ttk.Label(grid, text="Theme", style="Card.TLabel").grid(row=2, column=0, sticky="w", pady=10)
        ttk.Combobox(grid, textvariable=self.vars["DOTFILES_THEME"], values=["dark", "light"], state="readonly", width=16).grid(row=2, column=1, sticky="w", padx=8)

        grid.columnconfigure(1, weight=1)

        ttk.Button(card, text="Apply wallpaper now", style="Accent.TButton", command=self.apply_wallpaper).pack(anchor="w", pady=(18, 4))
        ttk.Label(card, text="Wallpaper uses swww. If no image is selected, the desktop uses a clean solid background.", style="CardMuted.TLabel").pack(anchor="w")

    def _bar_tab(self, notebook: ttk.Notebook) -> None:
        frame = ttk.Frame(notebook, style="Panel.TFrame", padding=18)
        notebook.add(frame, text="Bar")

        layout = self._card(frame)
        self._card_title(layout, "Waybar layout", "Move the bar, choose where workspaces and the clock sit, and reorder the right-side modules.")

        grid = ttk.Frame(layout, style="Card.TFrame")
        grid.pack(fill="x", pady=(12, 0))

        ttk.Label(grid, text="Position", style="Card.TLabel").grid(row=0, column=0, sticky="w", pady=8)
        ttk.Combobox(
            grid,
            textvariable=self.vars["DOTFILES_BAR_POSITION"],
            values=["top", "bottom"],
            state="readonly",
            width=14,
        ).grid(row=0, column=1, sticky="w", padx=8, pady=8)

        ttk.Label(grid, text="Workspaces", style="Card.TLabel").grid(row=1, column=0, sticky="w", pady=8)
        ttk.Combobox(
            grid,
            textvariable=self.vars["DOTFILES_BAR_WORKSPACES"],
            values=["left", "center", "right"],
            state="readonly",
            width=14,
        ).grid(row=1, column=1, sticky="w", padx=8, pady=8)

        ttk.Label(grid, text="Clock", style="Card.TLabel").grid(row=2, column=0, sticky="w", pady=8)
        ttk.Combobox(
            grid,
            textvariable=self.vars["DOTFILES_BAR_CLOCK"],
            values=["left", "center", "right"],
            state="readonly",
            width=14,
        ).grid(row=2, column=1, sticky="w", padx=8, pady=8)

        ttk.Label(grid, text="Right modules", style="Card.TLabel").grid(row=3, column=0, sticky="w", pady=8)
        ttk.Entry(grid, textvariable=self.vars["DOTFILES_BAR_RIGHT"], width=44).grid(row=3, column=1, sticky="ew", padx=8, pady=8)
        ttk.Label(
            grid,
            text="Example: pulseaudio,network,battery,tray",
            style="CardMuted.TLabel",
        ).grid(row=4, column=1, sticky="w", padx=8, pady=(0, 8))

        grid.columnconfigure(1, weight=1)

        style_card = self._card(frame)
        self._card_title(style_card, "Shape and spacing", "Round the bar, make it taller, or tune transparency.")

        controls = ttk.Frame(style_card, style="Card.TFrame")
        controls.pack(fill="x", pady=(12, 0))

        ttk.Label(controls, text="Height", style="Card.TLabel").grid(row=0, column=0, sticky="w", pady=8)
        tk.Scale(
            controls,
            from_=24,
            to=72,
            orient="horizontal",
            variable=self.vars["DOTFILES_BAR_HEIGHT"],
            bg=self.card,
            fg=self.text,
            troughcolor=self.card_soft,
            highlightthickness=0,
            length=260,
        ).grid(row=0, column=1, sticky="ew", padx=8, pady=4)

        ttk.Label(controls, text="Rounding", style="Card.TLabel").grid(row=1, column=0, sticky="w", pady=8)
        tk.Scale(
            controls,
            from_=0,
            to=28,
            orient="horizontal",
            variable=self.vars["DOTFILES_BAR_RADIUS"],
            bg=self.card,
            fg=self.text,
            troughcolor=self.card_soft,
            highlightthickness=0,
            length=260,
        ).grid(row=1, column=1, sticky="ew", padx=8, pady=4)

        ttk.Label(controls, text="Opacity", style="Card.TLabel").grid(row=2, column=0, sticky="w", pady=8)
        tk.Scale(
            controls,
            from_=0.2,
            to=1.0,
            resolution=0.05,
            orient="horizontal",
            variable=self.vars["DOTFILES_BAR_OPACITY"],
            bg=self.card,
            fg=self.text,
            troughcolor=self.card_soft,
            highlightthickness=0,
            length=260,
        ).grid(row=2, column=1, sticky="ew", padx=8, pady=4)

        controls.columnconfigure(1, weight=1)

        buttons = ttk.Frame(style_card, style="Card.TFrame")
        buttons.pack(anchor="w", pady=(14, 0))
        ttk.Button(buttons, text="Save and restart Waybar", style="Accent.TButton", command=self.save_and_restart_waybar).pack(side="left")
        ttk.Button(buttons, text="Restart Waybar only", command=self.restart_waybar).pack(side="left", padx=8)

    def _setup_tab(self, notebook: ttk.Notebook) -> None:
        frame = ttk.Frame(notebook, style="Panel.TFrame", padding=18)
        notebook.add(frame, text="Setup")

        card = self._card(frame)
        self._card_title(card, "Default apps", "Choose the apps launched by keybinds and helper actions.")

        fields = [
            ("Terminal", "DOTFILES_TERMINAL"),
            ("File manager", "DOTFILES_FILE_MANAGER"),
            ("App launcher", "DOTFILES_APP_LAUNCHER"),
            ("Editor", "DOTFILES_EDITOR"),
            ("Browser", "DOTFILES_BROWSER"),
        ]

        for row, (label, key) in enumerate(fields):
            ttk.Label(card, text=label, style="Card.TLabel").grid(row=row, column=0, sticky="w", pady=8)
            ttk.Entry(card, textvariable=self.vars[key], width=42).grid(row=row, column=1, sticky="ew", padx=8, pady=8)

        card.columnconfigure(1, weight=1)

        actions = self._card(frame)
        self._card_title(actions, "Quick actions")
        buttons = ttk.Frame(actions, style="Card.TFrame")
        buttons.pack(anchor="w", pady=(12, 0))
        ttk.Button(buttons, text="Open dotfiles", command=lambda: run_quiet(["xdg-open", str(ROOT)])).pack(side="left", padx=(0, 8))
        ttk.Button(buttons, text="Edit settings", command=lambda: run_quiet([self.vars["DOTFILES_EDITOR"].get(), str(ROOT / "config/dotfiles/settings.conf")])).pack(side="left", padx=8)
        ttk.Button(buttons, text="Show status", command=lambda: run_quiet(["kitty", "-e", "dotctl", "status"])).pack(side="left", padx=8)
        ttk.Button(buttons, text="Reload Hyprland", style="Accent.TButton", command=lambda: run_quiet(["hyprctl", "reload"])).pack(side="left", padx=8)

    def refresh_keybind_tree(self) -> None:
        if self.keybind_tree is None:
            return
        self.keybind_tree.delete(*self.keybind_tree.get_children())
        for index, keybind in enumerate(self.keybinds):
            self.keybind_tree.insert(
                "",
                "end",
                iid=str(index),
                text=keybind.get("name", ""),
                values=(
                    keybind.get("key", ""),
                    keybind.get("type", "command"),
                    keybind.get("value", ""),
                ),
            )

    def selected_keybind_index(self) -> int | None:
        if self.keybind_tree is None:
            return None
        selection = self.keybind_tree.selection()
        if not selection:
            return None
        try:
            return int(selection[0])
        except ValueError:
            return None

    def keybind_dialog(self, title: str, initial: dict | None = None) -> dict | None:
        initial = initial or {"name": "New shortcut", "key": "SHIFT, N", "type": "command", "value": "kitty"}
        dialog = tk.Toplevel(self)
        dialog.title(title)
        dialog.configure(bg=self.bg)
        dialog.transient(self)
        dialog.grab_set()
        dialog.resizable(False, False)

        name_var = tk.StringVar(value=initial.get("name", ""))
        key_var = tk.StringVar(value=initial.get("key", ""))
        type_var = tk.StringVar(value=initial.get("type", "command"))
        value_var = tk.StringVar(value=initial.get("value", ""))
        result: dict | None = None

        shell = ttk.Frame(dialog, style="Panel.TFrame", padding=18)
        shell.pack(fill="both", expand=True)
        card = ttk.Frame(shell, style="Card.TFrame", padding=16)
        card.pack(fill="both", expand=True)

        ttk.Label(card, text=title, style="Heading.TLabel").grid(row=0, column=0, columnspan=2, sticky="w", pady=(0, 12))

        fields = [
            ("Name", name_var),
            ("Key", key_var),
            ("Command / dispatcher", value_var),
        ]
        for row, (label, var) in enumerate(fields, start=1):
            ttk.Label(card, text=label, style="Card.TLabel").grid(row=row, column=0, sticky="w", pady=8)
            ttk.Entry(card, textvariable=var, width=42).grid(row=row, column=1, sticky="ew", padx=8, pady=8)

        ttk.Label(card, text="Type", style="Card.TLabel").grid(row=4, column=0, sticky="w", pady=8)
        ttk.Combobox(card, textvariable=type_var, values=["command", "dispatcher"], state="readonly", width=18).grid(row=4, column=1, sticky="w", padx=8, pady=8)

        ttk.Label(
            card,
            text="Key examples: Q, Return, SHIFT, S. Commands are launched with exec. Dispatchers are raw Hyprland actions.",
            style="CardMuted.TLabel",
            wraplength=430,
        ).grid(row=5, column=0, columnspan=2, sticky="w", pady=(8, 12))

        buttons = ttk.Frame(card, style="Card.TFrame")
        buttons.grid(row=6, column=0, columnspan=2, sticky="e")

        def save() -> None:
            nonlocal result
            name = name_var.get().strip()
            key = key_var.get().strip()
            value = value_var.get().strip()
            kind = type_var.get().strip()
            if not name or not key or not value:
                messagebox.showwarning("Keybind", "Name, key, and command are required.", parent=dialog)
                return
            if kind not in {"command", "dispatcher"}:
                kind = "command"
            result = {"name": name, "key": key, "type": kind, "value": value}
            dialog.destroy()

        ttk.Button(buttons, text="Cancel", command=dialog.destroy).pack(side="right", padx=(8, 0))
        ttk.Button(buttons, text="Save", style="Accent.TButton", command=save).pack(side="right")
        card.columnconfigure(1, weight=1)
        dialog.bind("<Return>", lambda _event: save())
        dialog.wait_window()
        return result

    def add_keybind(self) -> None:
        keybind = self.keybind_dialog("Add keybind")
        if keybind is None:
            return
        self.keybinds.append(keybind)
        self.refresh_keybind_tree()

    def edit_keybind(self) -> None:
        index = self.selected_keybind_index()
        if index is None or index >= len(self.keybinds):
            messagebox.showinfo("Keybinds", "Select a keybind first.")
            return
        updated = self.keybind_dialog("Edit keybind", self.keybinds[index])
        if updated is None:
            return
        self.keybinds[index] = updated
        self.refresh_keybind_tree()

    def remove_keybind(self) -> None:
        index = self.selected_keybind_index()
        if index is None or index >= len(self.keybinds):
            messagebox.showinfo("Keybinds", "Select a keybind first.")
            return
        if not messagebox.askyesno("Remove keybind", f"Remove {self.keybinds[index].get('name', 'this keybind')}?"):
            return
        del self.keybinds[index]
        self.refresh_keybind_tree()

    def reset_keybinds(self) -> None:
        if not messagebox.askyesno("Restore defaults", "Replace all keybinds with the default set?"):
            return
        self.keybinds = default_keybinds()
        self.refresh_keybind_tree()

    def choose_wallpaper(self) -> None:
        path = filedialog.askopenfilename(
            title="Choose wallpaper",
            filetypes=[("Images", "*.png *.jpg *.jpeg *.webp"), ("All files", "*")],
        )
        if path:
            self.vars["DOTFILES_WALLPAPER"].set(path)

    def choose_color(self) -> None:
        color = colorchooser.askcolor(color=self.vars["DOTFILES_ACCENT"].get(), title="Choose accent color")
        if color and color[1]:
            self.vars["DOTFILES_ACCENT"].set(color[1])

    def save_startup_choice(self) -> None:
        DOTFILES_DIR.mkdir(parents=True, exist_ok=True)
        if self.no_show_var.get():
            DISABLED_FILE.write_text("", encoding="utf-8")
        elif DISABLED_FILE.exists():
            DISABLED_FILE.unlink()

    def save_all(self) -> None:
        values = {key: var.get() for key, var in self.vars.items()}
        write_local_conf(values)
        save_keybinds(self.keybinds)
        write_colors(values["DOTFILES_ACCENT"])
        write_keybinds(values, self.keybinds)
        write_waybar(values)
        self.save_startup_choice()
        self.apply_wallpaper(show_errors=False)
        messagebox.showinfo("Saved", "Dotfiles settings saved. Hyprland will use them after reload or next login.")

    def save_and_restart_waybar(self) -> None:
        values = {key: var.get() for key, var in self.vars.items()}
        write_local_conf(values)
        write_waybar(values)
        self.restart_waybar()
        messagebox.showinfo("Waybar", "Waybar settings saved and restarted.")

    def restart_waybar(self) -> None:
        subprocess.run(["pkill", "-x", "waybar"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        run_quiet(["waybar"])

    def apply_wallpaper(self, show_errors: bool = True) -> None:
        wallpaper = self.vars["DOTFILES_WALLPAPER"].get()
        try:
            subprocess.run(["dotfiles-wallpaper", "set", wallpaper], check=True)
        except (OSError, subprocess.CalledProcessError) as exc:
            if show_errors:
                messagebox.showwarning("Wallpaper", f"Could not apply wallpaper yet: {exc}")


def main() -> int:
    force = "--force" in sys.argv
    if not force and DISABLED_FILE.exists():
        return 0
    if not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY"):
        return 0
    app = DotfilesCenter(force)
    app.mainloop()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
