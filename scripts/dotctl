#!/usr/bin/env bash
set -euo pipefail

SELF="$(readlink -f "$0")"
ROOT_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"

usage() {
  cat <<'EOF'
Usage: dotctl <command>

Commands:
  status      Show dotfile links and settings files
  edit        Edit the main settings file
  apply       Re-run the installer
  update      Update this repo, then re-run the installer
  all         Update repo, install packages, and apply dotfiles
  packages    Install recommended Arch packages
  aur         Install yay and packages from packages/aur.txt
  system      Configure greetd and enable desktop services
  welcome     Show the startup welcome tour now
  center      Open the graphical SplinterDots
  doctor      Print Hyprland, graphics, and service diagnostics
  uninstall   Remove symlinks created by these dotfiles
  help        Show this help

Installer commands accept install flags such as --dry-run and --noconfirm.
EOF
}

status() {
  printf 'Dotfiles root: %s\n' "$ROOT_DIR"
  printf 'Main settings: %s\n' "$ROOT_DIR/config/dotfiles/settings.conf"
  printf 'Local settings: %s\n\n' "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/local.conf"

  find "$ROOT_DIR/home" -type f -print | while IFS= read -r src; do
    rel="${src#"$ROOT_DIR/home/"}"
    dest="$HOME/$rel"
    if [ -L "$dest" ] && [ "$(readlink "$dest")" = "$src" ]; then
      printf 'linked  %s\n' "$dest"
    elif [ -e "$dest" ] || [ -L "$dest" ]; then
      printf 'custom  %s\n' "$dest"
    else
      printf 'missing %s\n' "$dest"
    fi
  done

  settings_dest="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/settings.conf"
  if [ -L "$settings_dest" ] && [ "$(readlink "$settings_dest")" = "$ROOT_DIR/config/dotfiles/settings.conf" ]; then
    printf 'linked  %s\n' "$settings_dest"
  elif [ -e "$settings_dest" ] || [ -L "$settings_dest" ]; then
    printf 'custom  %s\n' "$settings_dest"
  else
    printf 'missing %s\n' "$settings_dest"
  fi

  git_user_dest="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/git-user.inc"
  if [ -f "$git_user_dest" ]; then
    printf 'local   %s\n' "$git_user_dest"
  else
    printf 'missing %s\n' "$git_user_dest"
  fi

  welcome_dest="$HOME/.local/bin/dotfiles-welcome"
  if [ -L "$welcome_dest" ] && [ "$(readlink "$welcome_dest")" = "$ROOT_DIR/scripts/splinter-welcome" ]; then
    printf 'linked  %s\n' "$welcome_dest"
  elif [ -e "$welcome_dest" ] || [ -L "$welcome_dest" ]; then
    printf 'custom  %s\n' "$welcome_dest"
  else
    printf 'missing %s\n' "$welcome_dest"
  fi

  center_dest="$HOME/.local/bin/SplinterDots"
  if [ -L "$center_dest" ] && [ "$(readlink "$center_dest")" = "$ROOT_DIR/scripts/SplinterDots" ]; then
    printf 'linked  %s\n' "$center_dest"
  elif [ -e "$center_dest" ] || [ -L "$center_dest" ]; then
    printf 'custom  %s\n' "$center_dest"
  else
    printf 'missing %s\n' "$center_dest"
  fi

  wallpaper_dest="$HOME/.local/bin/splinter-wallpaper"
  if [ -L "$wallpaper_dest" ] && [ "$(readlink "$wallpaper_dest")" = "$ROOT_DIR/scripts/splinter-wallpaper" ]; then
    printf 'linked  %s\n' "$wallpaper_dest"
  elif [ -e "$wallpaper_dest" ] || [ -L "$wallpaper_dest" ]; then
    printf 'custom  %s\n' "$wallpaper_dest"
  else
    printf 'missing %s\n' "$wallpaper_dest"
  fi

  screenshot_dest="$HOME/.local/bin/splinter-screenshot"
  if [ -L "$screenshot_dest" ] && [ "$(readlink "$screenshot_dest")" = "$ROOT_DIR/scripts/splinter-screenshot" ]; then
    printf 'linked  %s\n' "$screenshot_dest"
  elif [ -e "$screenshot_dest" ] || [ -L "$screenshot_dest" ]; then
    printf 'custom  %s\n' "$screenshot_dest"
  else
    printf 'missing %s\n' "$screenshot_dest"
  fi

  autostart_dest="$HOME/.local/bin/splinter-autostart"
  if [ -L "$autostart_dest" ] && [ "$(readlink "$autostart_dest")" = "$ROOT_DIR/scripts/splinter-autostart" ]; then
    printf 'linked  %s\n' "$autostart_dest"
  elif [ -e "$autostart_dest" ] || [ -L "$autostart_dest" ]; then
    printf 'custom  %s\n' "$autostart_dest"
  else
    printf 'missing %s\n' "$autostart_dest"
  fi

  start_dest="$HOME/.local/bin/splinter-session"
  if [ -L "$start_dest" ] && [ "$(readlink "$start_dest")" = "$ROOT_DIR/scripts/splinter-session" ]; then
    printf 'linked  %s\n' "$start_dest"
  elif [ -e "$start_dest" ] || [ -L "$start_dest" ]; then
    printf 'custom  %s\n' "$start_dest"
  else
    printf 'missing %s\n' "$start_dest"
  fi

  short_start_dest="$HOME/.local/bin/start-hyprland"
  if [ -L "$short_start_dest" ] && [ "$(readlink "$short_start_dest")" = "$ROOT_DIR/scripts/start-hyprland" ]; then
    printf 'remove  %s (shadows packaged /usr/bin/start-hyprland)\n' "$short_start_dest"
  elif [ -e "$short_start_dest" ] || [ -L "$short_start_dest" ]; then
    printf 'custom  %s (check that it does not shadow /usr/bin/start-hyprland)\n' "$short_start_dest"
  else
    printf 'ok      %s is not shadowing /usr/bin/start-hyprland\n' "$short_start_dest"
  fi

  doctor_dest="$HOME/.local/bin/splinter-doctor"
  if [ -L "$doctor_dest" ] && [ "$(readlink "$doctor_dest")" = "$ROOT_DIR/scripts/splinter-doctor" ]; then
    printf 'linked  %s\n' "$doctor_dest"
  elif [ -e "$doctor_dest" ] || [ -L "$doctor_dest" ]; then
    printf 'custom  %s\n' "$doctor_dest"
  else
    printf 'missing %s\n' "$doctor_dest"
  fi

  if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/welcome-disabled" ]; then
    printf 'disabled startup welcome tour\n'
  else
    printf 'enabled  startup welcome tour\n'
  fi
}

edit_settings() {
  "${EDITOR:-nano}" "$ROOT_DIR/config/dotfiles/settings.conf"
}

apply() {
  "$ROOT_DIR/install.sh" --apply "$@"
}

packages() {
  "$ROOT_DIR/install.sh" --packages "$@"
}

aur() {
  "$ROOT_DIR/install.sh" --aur "$@"
}

system_setup() {
  "$ROOT_DIR/install.sh" --system "$@"
}

update_dotfiles() {
  "$ROOT_DIR/install.sh" --upd "$@"
}

all() {
  "$ROOT_DIR/install.sh" --all "$@"
}

welcome() {
  "$ROOT_DIR/scripts/splinter-welcome" --force
}

center() {
  "$ROOT_DIR/scripts/SplinterDots" --force
}

doctor() {
  "$ROOT_DIR/scripts/splinter-doctor"
}

uninstall() {
  find "$ROOT_DIR/home" -type f -print | while IFS= read -r src; do
    rel="${src#"$ROOT_DIR/home/"}"
    dest="$HOME/$rel"
    if [ -L "$dest" ] && [ "$(readlink "$dest")" = "$src" ]; then
      rm "$dest"
      printf 'removed %s\n' "$dest"
    fi
  done

  settings_dest="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/settings.conf"
  if [ -L "$settings_dest" ] && [ "$(readlink "$settings_dest")" = "$ROOT_DIR/config/dotfiles/settings.conf" ]; then
    rm "$settings_dest"
    printf 'removed %s\n' "$settings_dest"
  fi

  if [ -L "$HOME/.local/bin/dotctl" ] && [ "$(readlink "$HOME/.local/bin/dotctl")" = "$ROOT_DIR/scripts/dotctl" ]; then
    rm "$HOME/.local/bin/dotctl"
    printf 'removed %s\n' "$HOME/.local/bin/dotctl"
  fi

  if [ -L "$HOME/.local/bin/dotfiles-welcome" ] && [ "$(readlink "$HOME/.local/bin/dotfiles-welcome")" = "$ROOT_DIR/scripts/splinter-welcome" ]; then
    rm "$HOME/.local/bin/dotfiles-welcome"
    printf 'removed %s\n' "$HOME/.local/bin/dotfiles-welcome"
  fi

  if [ -L "$HOME/.local/bin/SplinterDots" ] && [ "$(readlink "$HOME/.local/bin/SplinterDots")" = "$ROOT_DIR/scripts/SplinterDots" ]; then
    rm "$HOME/.local/bin/SplinterDots"
    printf 'removed %s\n' "$HOME/.local/bin/SplinterDots"
  fi

  if [ -L "$HOME/.local/bin/splinter-wallpaper" ] && [ "$(readlink "$HOME/.local/bin/splinter-wallpaper")" = "$ROOT_DIR/scripts/splinter-wallpaper" ]; then
    rm "$HOME/.local/bin/splinter-wallpaper"
    printf 'removed %s\n' "$HOME/.local/bin/splinter-wallpaper"
  fi

  if [ -L "$HOME/.local/bin/splinter-screenshot" ] && [ "$(readlink "$HOME/.local/bin/splinter-screenshot")" = "$ROOT_DIR/scripts/splinter-screenshot" ]; then
    rm "$HOME/.local/bin/splinter-screenshot"
    printf 'removed %s\n' "$HOME/.local/bin/splinter-screenshot"
  fi

  if [ -L "$HOME/.local/bin/splinter-autostart" ] && [ "$(readlink "$HOME/.local/bin/splinter-autostart")" = "$ROOT_DIR/scripts/splinter-autostart" ]; then
    rm "$HOME/.local/bin/splinter-autostart"
    printf 'removed %s\n' "$HOME/.local/bin/splinter-autostart"
  fi

  if [ -L "$HOME/.local/bin/splinter-doctor" ] && [ "$(readlink "$HOME/.local/bin/splinter-doctor")" = "$ROOT_DIR/scripts/splinter-doctor" ]; then
    rm "$HOME/.local/bin/splinter-doctor"
    printf 'removed %s\n' "$HOME/.local/bin/splinter-doctor"
  fi

  if [ -L "$HOME/.local/bin/splinter-session" ] && [ "$(readlink "$HOME/.local/bin/splinter-session")" = "$ROOT_DIR/scripts/splinter-session" ]; then
    rm "$HOME/.local/bin/splinter-session"
    printf 'removed %s\n' "$HOME/.local/bin/splinter-session"
  fi

  if [ -L "$HOME/.local/bin/start-hyprland" ] && [ "$(readlink "$HOME/.local/bin/start-hyprland")" = "$ROOT_DIR/scripts/start-hyprland" ]; then
    rm "$HOME/.local/bin/start-hyprland"
    printf 'removed %s\n' "$HOME/.local/bin/start-hyprland"
  fi
}

cmd="${1:-help}"
if [ "$#" -gt 0 ]; then
  shift
fi
case "$cmd" in
  status) status ;;
  edit) edit_settings ;;
  apply) apply "$@" ;;
  update) update_dotfiles "$@" ;;
  all) all "$@" ;;
  packages) packages "$@" ;;
  aur) aur "$@" ;;
  system) system_setup "$@" ;;
  welcome) welcome ;;
  center) center ;;
  doctor) doctor ;;
  uninstall) uninstall ;;
  help|-h|--help) usage ;;
  *)
    printf 'Unknown command: %s\n\n' "$cmd" >&2
    usage >&2
    exit 1
    ;;
esac
