#!/usr/bin/env bash
set -euo pipefail

mode="${1:-area}"
lock_file="${XDG_RUNTIME_DIR:-/tmp}/splinterdots-screenshot.lock"
tmp_file=""

cleanup() {
  if [ -n "${tmp_file:-}" ] && [ -f "$tmp_file" ]; then
    rm -f "$tmp_file"
  fi
}
trap cleanup EXIT INT TERM

need() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing dependency: $1" >&2
    exit 1
  fi
}

notify_done() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "Screenshot copied" "The screenshot was copied to your clipboard."
  fi
}

copy_to_clipboard() {
  need wl-copy

  # Important: close the lock before wl-copy starts its clipboard background process.
  # Otherwise the lock can stay held forever and only the first screenshot works.
  exec 9>&-

  wl-copy --type image/png < "$tmp_file"
  notify_done
}

capture_full() {
  need grim

  tmp_file="$(mktemp --suffix=.png)"
  sleep 0.15
  grim "$tmp_file"
  copy_to_clipboard
}

capture_area() {
  need grim
  need slurp

  local geometry
  geometry="$(slurp)"
  [ -n "$geometry" ] || exit 0

  tmp_file="$(mktemp --suffix=.png)"
  sleep 0.18
  grim -g "$geometry" "$tmp_file"
  copy_to_clipboard
}

exec 9>"$lock_file"
if ! flock -n 9; then
  exit 0
fi

case "$mode" in
  area|region|selection)
    capture_area
    ;;
  full|screen)
    capture_full
    ;;
  *)
    echo "Usage: splinter-screenshot [area|full]" >&2
    exit 1
    ;;
esac
