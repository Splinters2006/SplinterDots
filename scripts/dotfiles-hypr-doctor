#!/usr/bin/env bash
set -u

section() {
  printf '\n== %s ==\n' "$1"
}

show_cmd() {
  printf '$ %s\n' "$*"
  "$@" 2>&1 || true
}

section "Session"
printf 'USER=%s\n' "${USER:-unknown}"
printf 'XDG_SESSION_TYPE=%s\n' "${XDG_SESSION_TYPE:-unset}"
printf 'XDG_CURRENT_DESKTOP=%s\n' "${XDG_CURRENT_DESKTOP:-unset}"
printf 'WAYLAND_DISPLAY=%s\n' "${WAYLAND_DISPLAY:-unset}"
printf 'HYPRLAND_INSTANCE_SIGNATURE=%s\n' "${HYPRLAND_INSTANCE_SIGNATURE:-unset}"

section "Hyprland"
show_cmd command -v Hyprland
show_cmd command -v hyprctl
if command -v Hyprland >/dev/null 2>&1; then
  show_cmd Hyprland --version
fi
if command -v hyprctl >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
  show_cmd hyprctl version
  show_cmd hyprctl monitors
fi

section "Graphics"
show_cmd command -v lspci
if command -v lspci >/dev/null 2>&1; then
  show_cmd lspci -k
fi
show_cmd command -v glxinfo
if command -v glxinfo >/dev/null 2>&1; then
  show_cmd glxinfo -B
fi
show_cmd command -v vulkaninfo
if command -v vulkaninfo >/dev/null 2>&1; then
  show_cmd vulkaninfo --summary
fi

section "Services"
show_cmd systemctl is-enabled greetd
show_cmd systemctl is-enabled NetworkManager
show_cmd systemctl is-enabled bluetooth
show_cmd systemctl status greetd --no-pager

section "Recent Hyprland Logs"
if [ -d "${XDG_RUNTIME_DIR:-}/hypr" ]; then
  find "${XDG_RUNTIME_DIR}/hypr" -type f -name 'hyprland.log' -print -exec tail -n 80 {} \; 2>/dev/null || true
fi
if [ -d "$HOME/.cache/hyprland" ]; then
  find "$HOME/.cache/hyprland" -type f -name '*.log' -print -exec tail -n 80 {} \; 2>/dev/null || true
fi

section "Hint"
cat <<'EOF'
Aquamarine errors are usually graphics/session backend errors, not theme errors.
If the Graphics section shows no usable renderer, install the matching GPU
driver stack. Intel/AMD usually work with mesa. NVIDIA usually needs nvidia or
nvidia-dkms plus matching kernel headers and modeset configuration.
EOF
