#!/usr/bin/env bash
# YoRHa Terminal add-on: a NieR:Automata styled kitty profile.
#
#   splinter-yorha install     add "YoRHa Terminal" to the app launcher
#   splinter-yorha uninstall   remove it again
#   splinter-yorha launch      open the YoRHa terminal
#
# Inspired by https://github.com/TrippyToes/YoRHa-Windows-Terminal (look only).
# The background is DOTFILES_YORHA_BACKGROUND in local.conf, or your SplinterDots
# wallpaper when that is empty. Dark images get a dark YoRHa palette (beige text),
# light ones the beige paper look. The font is ITC Benguiat if you
# added it (Appearance > Add your own fonts), otherwise Rodin Pro, otherwise the
# normal terminal font. Your regular kitty setup is not changed.
set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
PROFILE_DIR="$CONFIG_HOME/splinterdots/yorha"
DESKTOP_FILE="$DATA_HOME/applications/splinterdots-yorha-terminal.desktop"
LOCAL_CONF="$CONFIG_HOME/dotfiles/local.conf"

# Preferred fonts, in order; the first installed one is used.
FONTS=("ITC Benguiat" "Benguiat" "FOT-Rodin Pro")

setting() {
  local line
  line="$(grep -E "^$1=" "$LOCAL_CONF" 2>/dev/null | tail -n1 || true)"
  line="${line#*=}"
  line="${line//\"/}"
  printf '%s\n' "${line/#\~/$HOME}"
}

installed_font() {
  local families font
  families="$(fc-list --format '%{family}\n' 2>/dev/null | tr ',' '\n')"
  for font in "${FONTS[@]}"; do
    if grep -qxF "$font" <<<"$families"; then
      printf '%s\n' "$font"
      return
    fi
  done
}

# kitty only reads PNG backgrounds, so other formats are converted once into the cache.
background_png() {
  local wallpaper png
  wallpaper="$(setting DOTFILES_YORHA_BACKGROUND)"
  [[ -f "$wallpaper" ]] || wallpaper="$(setting DOTFILES_WALLPAPER)"
  [[ -f "$wallpaper" ]] || return 0
  case "${wallpaper,,}" in
    *.png) printf '%s\n' "$wallpaper"; return ;;
  esac
  command -v magick >/dev/null 2>&1 || return 0
  png="$CACHE_HOME/splinterdots/yorha-background-$(printf '%s' "$wallpaper" | md5sum | cut -c1-12).png"
  mkdir -p "${png%/*}"
  if [[ ! -f "$png" || "$wallpaper" -nt "$png" ]]; then
    magick "$wallpaper" "$png" 2>/dev/null || return 0
  fi
  printf '%s\n' "$png"
}

# Average brightness of an image from 0 to 1; light (paper look) when unknown.
brightness() {
  [[ -n "$1" ]] && command -v magick >/dev/null 2>&1 || { echo 1; return; }
  magick "$1" -resize 64x64 -colorspace Gray -format '%[fx:mean]' info: 2>/dev/null || echo 1
}

write_kitty_config() {
  local font background dark
  font="$(installed_font)"
  background="$(background_png)"
  dark="$(awk -v b="$(brightness "$background")" 'BEGIN { print (b < 0.4) ? 1 : 0 }')"
  mkdir -p "$PROFILE_DIR"
  {
    echo "# Generated by splinter-yorha on every launch."
    echo "include $CONFIG_HOME/kitty/kitty.conf"
    echo
    [[ -n "$font" ]] && echo "font_family $font"
    if [[ -n "$background" ]]; then
      echo "background_image $background"
      echo "background_image_layout cscaled"
      # A layer of the palette's background keeps text readable while the image stays visible.
      if [[ "$dark" == 1 ]]; then echo "background_tint 0.15"; else echo "background_tint 0.45"; fi
    fi
    cat <<'COMMON'
background_opacity 1.0
window_padding_width 14
cursor_shape block
cursor_blink_interval 0
env SPLINTER_YORHA=1
COMMON
    if [[ "$dark" == 1 ]]; then
      cat <<'DARK'

# YoRHa interface on a dark screen: beige text on black.
background #141311
foreground #cdc8b0
cursor #cdc8b0
cursor_text_color #141311
selection_background #cdc8b0
selection_foreground #141311
url_color #dad5bf
active_border_color #cdc8b0
inactive_border_color #4e4b42
active_tab_background #cdc8b0
active_tab_foreground #141311
inactive_tab_background #2a2824
inactive_tab_foreground #cdc8b0
tab_bar_background #141311

color0  #2a2824
color1  #c06a5c
color2  #9aa27a
color3  #c9ab6e
color4  #8a98a0
color5  #b08c9a
color6  #8fa8a3
color7  #cdc8b0
color8  #6e695c
color9  #d47e70
color10 #aeb68e
color11 #dbbd80
color12 #9eacb4
color13 #c4a0ae
color14 #a3bcb7
color15 #e6e1cb
DARK
    else
      cat <<'COLORS'

# YoRHa interface: beige paper, dark ink.
background #cdc8b0
foreground #4e4b42
cursor #4e4b42
cursor_text_color #cdc8b0
selection_background #4e4b42
selection_foreground #cdc8b0
url_color #7a6e50
active_border_color #4e4b42
inactive_border_color #b4ae96
active_tab_background #4e4b42
active_tab_foreground #cdc8b0
inactive_tab_background #b4ae96
inactive_tab_foreground #4e4b42
tab_bar_background #c3bda4

color0  #4e4b42
color1  #a0453a
color2  #6b734f
color3  #9a7b3e
color4  #57636b
color5  #7a5a68
color6  #5c7672
color7  #b4ae96
color8  #6e695c
color9  #b8584c
color10 #7e875f
color11 #b08f50
color12 #6b7880
color13 #8f6d7c
color14 #6f8a86
color15 #dad5bf
COLORS
    fi
  } > "$PROFILE_DIR/kitty.conf"
}

install_launcher() {
  mkdir -p "${DESKTOP_FILE%/*}"
  cat > "$DESKTOP_FILE" <<DESKTOP
[Desktop Entry]
Type=Application
Name=YoRHa Terminal
Comment=NieR:Automata styled terminal
Exec=$(readlink -f "$0") launch
Icon=utilities-terminal
Terminal=false
Categories=System;TerminalEmulator;
DESKTOP
  write_kitty_config
  echo "Installed YoRHa Terminal. Open it from the app launcher."
}

case "${1:-}" in
  install) install_launcher ;;
  uninstall)
    rm -f "$DESKTOP_FILE"
    rm -rf "$PROFILE_DIR"
    rm -f "$CACHE_HOME"/splinterdots/yorha-background-*.png
    echo "Removed YoRHa Terminal."
    ;;
  launch)
    write_kitty_config
    exec kitty --config "$PROFILE_DIR/kitty.conf" --class splinter-yorha --title "YoRHa Terminal"
    ;;
  config) write_kitty_config; cat "$PROFILE_DIR/kitty.conf" ;;
  *) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
