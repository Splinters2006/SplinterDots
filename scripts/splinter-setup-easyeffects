#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

if ! command -v easyeffects >/dev/null 2>&1; then
  echo "EasyEffects is not installed."
  exit 0
fi

mkdir -p "$CONFIG_HOME/easyeffects/output" "$CONFIG_HOME/easyeffects/input"

if [ -f "$ROOT_DIR/files/easyeffects/output/SplinterDots-Output.json" ]; then
  cp "$ROOT_DIR/files/easyeffects/output/SplinterDots-Output.json" \
     "$CONFIG_HOME/easyeffects/output/SplinterDots-Output.json"
fi

if [ -f "$ROOT_DIR/files/easyeffects/output/Dotfiles Audio.json" ]; then
  cp "$ROOT_DIR/files/easyeffects/output/Dotfiles Audio.json" \
     "$CONFIG_HOME/easyeffects/output/Dotfiles Audio.json"
fi

if [ -f "$ROOT_DIR/files/easyeffects/input/SplinterDots-Mic.json" ]; then
  cp "$ROOT_DIR/files/easyeffects/input/SplinterDots-Mic.json" \
     "$CONFIG_HOME/easyeffects/input/SplinterDots-Mic.json"
fi

# Enable the EasyEffects service/app autostart where available.
systemctl --user enable --now easyeffects.service 2>/dev/null || true

# Start it once so it can pick up presets.
if ! pgrep -x easyeffects >/dev/null 2>&1; then
  easyeffects --gapplication-service >/dev/null 2>&1 &
  sleep 1
fi

# Try common CLI forms. Different EasyEffects versions expose slightly different options.
easyeffects --load-preset "Dotfiles Audio" >/dev/null 2>&1 || true
easyeffects --load-preset SplinterDots-Mic >/dev/null 2>&1 || true

echo "EasyEffects SplinterDots presets installed."
echo "Open EasyEffects and select:"
echo "  Output preset: Dotfiles Audio"
echo "  Input preset:  SplinterDots-Mic"
