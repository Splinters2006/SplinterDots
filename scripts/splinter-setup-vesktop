#!/usr/bin/env python3
"""Install the SplinterDots Vesktop theme and enable the default Vencord plugins.

Plugins are applied once per Vesktop profile (tracked by a marker file), so
plugins the user turns off afterwards stay off on later runs.
"""
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys

ROOT = Path(os.path.realpath(__file__)).parents[1]
MARKER = '.splinterdots-plugins-applied'


def apply_default_plugins(settings_file, defaults):
    """Merge default plugin settings into Vencord's settings.json; returns True if applied."""
    marker = settings_file.parent / MARKER
    if marker.exists():
        return False
    data = json.loads(settings_file.read_text()) if settings_file.exists() else {}
    if not isinstance(data, dict):
        raise ValueError('Vesktop settings must be a JSON object')
    plugins = data.setdefault('plugins', {})
    for name, options in defaults.items():
        current = plugins.get(name) if isinstance(plugins.get(name), dict) else {}
        plugins[name] = {**current, **options}
    settings_file.parent.mkdir(parents=True, exist_ok=True)
    if settings_file.exists() and not settings_file.with_suffix('.json.before-splinterdots').exists():
        shutil.copy2(settings_file, settings_file.with_suffix('.json.before-splinterdots'))
    settings_file.write_text(json.dumps(data, indent=4) + '\n')
    marker.touch()
    return True


def main():
    config = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config')))
    folder = config / 'vesktop'
    (folder / 'themes').mkdir(parents=True, exist_ok=True)
    shutil.copy2(ROOT / 'files/vesktop/SplinterDots.theme.css', folder / 'themes/SplinterDots.theme.css')

    # Vesktop rewrites settings.json on exit, which would discard our changes.
    if subprocess.run(['pgrep', '-x', 'vesktop'], capture_output=True).returncode == 0:
        print('Close Vesktop, then run splinter-setup-vesktop again to enable the default plugins.', file=sys.stderr)
        return 1

    defaults = json.loads((ROOT / 'files/vesktop/plugins.json').read_text())
    if apply_default_plugins(folder / 'settings/settings.json', defaults):
        print(f'Enabled {len(defaults)} default Vesktop plugins.')
    else:
        print('Default Vesktop plugins were already applied; keeping your plugin choices.')
    return 0


if __name__ == '__main__':
    sys.exit(main())
