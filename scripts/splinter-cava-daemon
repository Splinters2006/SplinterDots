#!/usr/bin/env bash
set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
CAVA_DIR="$CONFIG_HOME/cava"
CAVA_CONFIG="$CAVA_DIR/splinterbar-cava.conf"
FRAME_FILE="/tmp/splinterbar-cava-frame"

mkdir -p "$CAVA_DIR"

cat > "$CAVA_CONFIG" <<'CAVACONF'
[general]
bars = 18
framerate = 120
autosens = 0
sensitivity = 100

[input]
method = pipewire
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 8
bar_delimiter = 255

[smoothing]
monstercat = 1
waves = 0
noise_reduction = 0.55
CAVACONF

printf '000000000000000000000000000000000000' > "$FRAME_FILE"

python - "$CAVA_CONFIG" "$FRAME_FILE" <<'PY'
import subprocess
import sys
from pathlib import Path

config = sys.argv[1]
frame_file = Path(sys.argv[2])

proc = subprocess.Popen(
    ["cava", "-p", config],
    stdout=subprocess.PIPE,
    stderr=subprocess.DEVNULL,
)

values = []
previous = [0.0] * 18
moving_peak = 16.0

TARGET_MAX = 44
MIN_PEAK = 10.0
ATTACK = 0.35
DECAY = 0.985
BAR_SMOOTH = 0.55

while True:
    chunk = proc.stdout.read(128)
    if not chunk:
        break

    for b in chunk:
        # Skip delimiter and line-like separators.
        if b in (255, 10, 13):
            continue

        # CAVA raw ascii can be real byte values 0-64.
        if 0 <= b <= 64:
            values.append(float(b))

        # Or printable ASCII digits 0-8 on some builds/configs.
        elif 48 <= b <= 56:
            values.append(float(b - 48))

        while len(values) >= 18:
            frame_values = values[:18]
            values = values[18:]

            frame_peak = max(frame_values)

            if frame_peak > moving_peak:
                moving_peak = moving_peak * (1.0 - ATTACK) + frame_peak * ATTACK
            else:
                moving_peak = max(MIN_PEAK, moving_peak * DECAY)

            scaled = []
            for i, value in enumerate(frame_values):
                normalized = (value / moving_peak) * TARGET_MAX
                normalized = max(0.0, min(64.0, normalized))

                smoothed = previous[i] * (1.0 - BAR_SMOOTH) + normalized * BAR_SMOOTH
                previous[i] = smoothed

                scaled.append(int(round(smoothed)))

            # 18 bars * 2 hex chars = 36 chars
            frame = "".join(str(max(0, min(8, int(round((v / 64) * 8))))) for v in scaled)

            tmp = frame_file.with_suffix(".tmp")
            tmp.write_text(frame)
            tmp.replace(frame_file)
PY
