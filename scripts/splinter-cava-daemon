#!/usr/bin/env bash
set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
CAVA_DIR="$CONFIG_HOME/cava"
CAVA_CONFIG="$CAVA_DIR/splinterbar-cava.conf"
FRAME_FILE="/tmp/splinterbar-cava-frame"

mkdir -p "$CAVA_DIR"

cat > "$CAVA_CONFIG" <<'CAVACONF'
[general]
bars = 18
framerate = 90
autosens = 1
sensitivity = 60

[input]
method = pipewire
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 8
bar_delimiter = 10

[smoothing]
monstercat = 0
waves = 0
noise_reduction = 0.35
CAVACONF

printf '000000000000000000' > "$FRAME_FILE"

python - "$CAVA_CONFIG" "$FRAME_FILE" <<'PY'
import subprocess
import sys
from pathlib import Path

config = sys.argv[1]
frame_file = Path(sys.argv[2])

proc = subprocess.Popen(
    ["cava", "-p", config],
    stdout=subprocess.PIPE,
    stderr=subprocess.DEVNULL,
    text=True,
)

values = []
previous = [0.0] * 18
SMOOTH = 0.45

while True:
    line = proc.stdout.readline()
    if not line:
        break

    line = line.strip()
    if not line:
        continue

    try:
        value = int(line)
    except ValueError:
        continue

    value = max(0, min(8, value))
    values.append(value)

    if len(values) < 18:
        continue

    frame_values = values[:18]
    values = values[18:]

    output = []
    for i, value in enumerate(frame_values):
        smoothed = previous[i] * SMOOTH + value * (1.0 - SMOOTH)
        previous[i] = smoothed
        output.append(str(max(0, min(8, int(round(smoothed))))))

    tmp = frame_file.with_suffix(".tmp")
    tmp.write_text("".join(output))
    tmp.replace(frame_file)
PY
