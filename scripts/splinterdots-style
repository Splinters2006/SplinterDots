#!/usr/bin/env bash
set -euo pipefail

install_packages() {
  if [ "$#" -eq 0 ]; then
    echo "No packages given."
    exit 1
  fi

  official=()
  aur=()

  for pkg in "$@"; do
    if pacman -Si "$pkg" >/dev/null 2>&1; then
      official+=("$pkg")
    else
      aur+=("$pkg")
    fi
  done

  if [ "${#official[@]}" -gt 0 ]; then
    sudo pacman -S --needed "${official[@]}"
  fi

  if [ "${#aur[@]}" -gt 0 ]; then
    if command -v paru >/dev/null 2>&1; then
      paru -S --needed "${aur[@]}"
    elif command -v yay >/dev/null 2>&1; then
      yay -S --needed "${aur[@]}"
    else
      echo
      echo "These packages are not in pacman and probably require AUR:"
      printf '  %s\n' "${aur[@]}"
      echo
      echo "Install yay or paru first, then try again."
      exit 1
    fi
  fi
}

apply_style() {
  CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles"
  LOCAL_CONF="$CONFIG_DIR/local.conf"

  DOTFILES_UI_FONT="CaskaydiaCove Nerd Font"
  DOTFILES_ICON_THEME="Papirus-Dark"
  DOTFILES_CURSOR_THEME="Bibata-Modern-Ice"

  if [ -f "$LOCAL_CONF" ]; then
    # shellcheck disable=SC1090
    . "$LOCAL_CONF"
  fi

  python3 - "${XDG_CONFIG_HOME:-$HOME/.config}" "$DOTFILES_UI_FONT" "$DOTFILES_ICON_THEME" "$DOTFILES_CURSOR_THEME" <<'PYTHON'
import configparser
from pathlib import Path
import sys

config, font, icons, cursor = sys.argv[1:]
for version in (3, 4):
    file = Path(config) / f"gtk-{version}.0/settings.ini"
    file.parent.mkdir(parents=True, exist_ok=True)
    settings = configparser.ConfigParser(interpolation=None, strict=False)
    settings.optionxform = str
    if file.exists():
        settings.read(file)
    if not settings.has_section("Settings"):
        settings.add_section("Settings")
    settings["Settings"].update({"gtk-font-name": f"{font} 11", "gtk-icon-theme-name": icons,
                                 "gtk-cursor-theme-name": cursor})
    with file.open("w") as output:
        settings.write(output)
PYTHON

  echo "Applied style settings."
}

case "${1:-apply}" in
  install)
    shift
    install_packages "$@"
    ;;
  apply)
    apply_style
    ;;
  *)
    echo "Usage:"
    echo "  splinterdots-style install PACKAGE..."
    echo "  splinterdots-style apply"
    exit 1
    ;;
esac
