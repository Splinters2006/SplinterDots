#!/usr/bin/env bash
set -euo pipefail

install_packages() {
  if [ "$#" -eq 0 ]; then
    echo "No packages given."
    exit 1
  fi

  official=()
  aur=()

  for pkg in "$@"; do
    if pacman -Si "$pkg" >/dev/null 2>&1; then
      official+=("$pkg")
    else
      aur+=("$pkg")
    fi
  done

  if [ "${#official[@]}" -gt 0 ]; then
    sudo pacman -S --needed "${official[@]}"
  fi

  if [ "${#aur[@]}" -gt 0 ]; then
    if command -v paru >/dev/null 2>&1; then
      paru -S --needed "${aur[@]}"
    elif command -v yay >/dev/null 2>&1; then
      yay -S --needed "${aur[@]}"
    else
      echo
      echo "These packages are not in pacman and probably require AUR:"
      printf '  %s\n' "${aur[@]}"
      echo
      echo "Install yay or paru first, then try again."
      exit 1
    fi
  fi
}

apply_style() {
  CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles"
  LOCAL_CONF="$CONFIG_DIR/local.conf"

  DOTFILES_UI_FONT="CaskaydiaCove Nerd Font"
  DOTFILES_ICON_THEME="Papirus-Dark"
  DOTFILES_CURSOR_THEME="Bibata-Modern-Ice"

  if [ -f "$LOCAL_CONF" ]; then
    # shellcheck disable=SC1090
    . "$LOCAL_CONF"
  fi

  python3 - "${XDG_CONFIG_HOME:-$HOME/.config}" "$DOTFILES_UI_FONT" "$DOTFILES_ICON_THEME" "$DOTFILES_CURSOR_THEME" <<'PYTHON'
import configparser
from pathlib import Path
import sys

config, font, icons, cursor = sys.argv[1:]
for version in (3, 4):
    file = Path(config) / f"gtk-{version}.0/settings.ini"
    file.parent.mkdir(parents=True, exist_ok=True)
    settings = configparser.ConfigParser(interpolation=None, strict=False)
    settings.optionxform = str
    if file.exists():
        settings.read(file)
    if not settings.has_section("Settings"):
        settings.add_section("Settings")
    settings["Settings"].update({"gtk-font-name": f"{font} 11", "gtk-icon-theme-name": icons,
                                 "gtk-cursor-theme-name": cursor})
    with file.open("w") as output:
        settings.write(output)
PYTHON

  local config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
  local cursor_size="${XCURSOR_SIZE:-24}"

  # GTK4/libadwaita apps and the XDG portal read these instead of settings.ini.
  if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface font-name "$DOTFILES_UI_FONT 11" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface icon-theme "$DOTFILES_ICON_THEME" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface cursor-theme "$DOTFILES_CURSOR_THEME" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface cursor-size "$cursor_size" 2>/dev/null || true
  fi

  # Fallback cursor for X11/XWayland apps that only look at the "default" theme.
  mkdir -p "$HOME/.icons/default"
  printf '[Icon Theme]\nName=Default\nInherits=%s\n' "$DOTFILES_CURSOR_THEME" > "$HOME/.icons/default/index.theme"

  # Loaded by hyprland.lua so new sessions and launched apps use the same cursor.
  mkdir -p "$config_home/hypr"
  printf -- '-- Generated by splinterdots-style.\nhl.env("XCURSOR_THEME", %s)\nhl.env("HYPRCURSOR_THEME", %s)\nhl.env("XCURSOR_SIZE", "%s")\nhl.env("HYPRCURSOR_SIZE", "%s")\n' \
    "\"$DOTFILES_CURSOR_THEME\"" "\"$DOTFILES_CURSOR_THEME\"" "$cursor_size" "$cursor_size" > "$config_home/hypr/cursor.lua"

  # Apply immediately to the running session.
  if command -v hyprctl >/dev/null 2>&1; then
    hyprctl setcursor "$DOTFILES_CURSOR_THEME" "$cursor_size" >/dev/null 2>&1 || true
  fi

  local theme_dir
  for theme_dir in "$HOME/.local/share/icons" "$HOME/.icons" /usr/share/icons; do
    if [ -d "$theme_dir/$DOTFILES_CURSOR_THEME/cursors" ]; then
      echo "Applied style settings."
      return
    fi
  done

  echo "Cursor theme $DOTFILES_CURSOR_THEME is not installed; install it from Appearance first." >&2
  exit 2
}

case "${1:-apply}" in
  install)
    shift
    install_packages "$@"
    ;;
  apply)
    apply_style
    ;;
  *)
    echo "Usage:"
    echo "  splinterdots-style install PACKAGE..."
    echo "  splinterdots-style apply"
    exit 1
    ;;
esac
