#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

finish_install() {
  local result=$?
  if [ "$result" -ne 0 ]; then
    echo
    echo "Installation failed (exit $result). Review the error above and try again." >&2
  fi
  if [ -t 0 ]; then
    read -rp "Press enter to close..." _ || true
  fi
  exit "$result"
}
trap finish_install EXIT

if [ "$#" -eq 0 ]; then
  echo "No add-on package was provided." >&2
  exit 1
fi

for package in "$@"; do
  # splinterdots-* add-ons ship with SplinterDots itself; there is no package to download.
  case "$package" in
    splinterdots-*) ;;
    *) "$ROOT_DIR/scripts/splinterdots-style" install "$package" ;;
  esac
done

for package in "$@"; do
  case "$package" in
    splinterdots-yorha-terminal)
      "$ROOT_DIR/scripts/splinter-yorha" install
      ;;
    vesktop|vesktop-bin)
      "$ROOT_DIR/scripts/splinter-setup-vesktop" || true
      ;;
    spicetify|spicetify-cli)
      "$ROOT_DIR/scripts/splinter-setup-spicetify"
      ;;
  esac
done

marker_dir="${XDG_CACHE_HOME:-$HOME/.cache}/splinterdots"
mkdir -p "$marker_dir"
touch "$marker_dir/addons-refresh"

echo
echo "Add-on installation completed successfully."
