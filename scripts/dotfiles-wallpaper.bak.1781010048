#!/usr/bin/env bash
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles"
LOCAL_CONF="$CONFIG_DIR/local.conf"
DOTFILES_WALLPAPER=""

if [ -f "$LOCAL_CONF" ]; then
  # shellcheck disable=SC1090
  . "$LOCAL_CONF"
fi

set_wallpaper() {
  local image="$1"
  mkdir -p "$CONFIG_DIR"

  if [ -n "$image" ] && [ ! -f "$image" ]; then
    printf 'Wallpaper not found: %s\n' "$image" >&2
    exit 1
  fi

  if grep -q '^DOTFILES_WALLPAPER=' "$LOCAL_CONF" 2>/dev/null; then
    sed -i "s|^DOTFILES_WALLPAPER=.*|DOTFILES_WALLPAPER=\"$image\"|" "$LOCAL_CONF"
  else
    printf 'DOTFILES_WALLPAPER="%s"\n' "$image" >> "$LOCAL_CONF"
  fi

  DOTFILES_WALLPAPER="$image"

  apply_wallpaper
}

apply_wallpaper() {
  if ! command -v swww >/dev/null 2>&1; then
    exit 0
  fi

  if ! swww query >/dev/null 2>&1; then
    swww-daemon >/dev/null 2>&1 &
    sleep 0.2
  fi

  if [ -n "${DOTFILES_WALLPAPER:-}" ] && [ -f "$DOTFILES_WALLPAPER" ]; then
    swww img "$DOTFILES_WALLPAPER" --transition-type wipe --transition-duration 0.8
  else
    swww clear 1e1e2e
  fi
}

case "${1:-apply}" in
  apply)
    apply_wallpaper
    ;;
  set)
    set_wallpaper "${2:-}"
    ;;
  *)
    printf 'Usage: dotfiles-wallpaper [apply|set IMAGE]\n' >&2
    exit 1
    ;;
esac
