#!/usr/bin/env bash
set -u

start_once() {
  local name="$1"
  shift

  if pgrep -x "$name" >/dev/null 2>&1; then
    return
  fi

  "$@" >/dev/null 2>&1 &
}

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=Hyprland >/dev/null 2>&1 || true
fi

POLKIT_AGENT="/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

if [ -x "$POLKIT_AGENT" ]; then
  start_once polkit-gnome-authentication-agent-1 "$POLKIT_AGENT"
fi

command -v mako >/dev/null 2>&1 && start_once mako mako
# Bar icons come from the icon theme selected in SplinterDots.
icon_theme="$(sed -n 's/^DOTFILES_ICON_THEME=//p' "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/local.conf" 2>/dev/null | tail -n1 | tr -d "\"'")"
command -v quickshell >/dev/null 2>&1 && start_once quickshell env QS_ICON_THEME="${icon_theme:-Papirus-Dark}" quickshell -c splinterbar

if command -v swww-daemon >/dev/null 2>&1; then
  swww query >/dev/null 2>&1 || swww-daemon >/dev/null 2>&1 &
fi

if command -v easyeffects >/dev/null 2>&1; then
  start_once easyeffects easyeffects --service-mode
fi

if command -v splinter-wallpaper >/dev/null 2>&1; then
  splinter-wallpaper apply >/dev/null 2>&1 || true
fi

if command -v dotfiles-welcome >/dev/null 2>&1; then
  sleep 1
  dotfiles-welcome >/dev/null 2>&1 || true
fi
