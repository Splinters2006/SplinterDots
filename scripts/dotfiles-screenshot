#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: dotfiles-screenshot <region|full>

Commands:
  region   Select a screen region, copy it to the clipboard, and save it
  full     Save a full-screen screenshot
EOF
}

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "Screenshot" "$1"
  fi
}

need() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'dotfiles-screenshot: missing command: %s\n' "$1" >&2
    exit 1
  fi
}

shot_dir="${XDG_SCREENSHOTS_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots}"
timestamp="$(date +%Y-%m-%d_%H-%M-%S)"
path="$shot_dir/screenshot-$timestamp.png"

cmd="${1:-}"
case "$cmd" in
  region)
    need grim
    need slurp
    need wl-copy
    mkdir -p "$shot_dir"
    geometry="$(slurp)"
    grim -g "$geometry" "$path"
    wl-copy <"$path"
    notify "Saved and copied region screenshot."
    ;;
  full)
    need grim
    mkdir -p "$shot_dir"
    grim "$path"
    notify "Saved full screenshot."
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
